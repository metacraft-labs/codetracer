# The sibling `--path`s, as absolute paths. `ci/deploy/docs.sh` generates this
# before a build and deletes it after, and README.md tells a developer to write
# the same file once by hand -- so it exists in most working trees and its
# contents are machine-specific. Ignoring it is what keeps somebody's
# `/home/<name>/...` out of a commit; it must stay untracked, because a
# committed copy would collide with the one CI writes.
nim.cfg

# `nim js` writes its output next to the compiled .nim file unless -o: is given.
src/**/*.js
tests/**/*.js
