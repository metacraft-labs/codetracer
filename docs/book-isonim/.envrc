#!/usr/bin/env bash
# Self-contained dev shell for the CodeTracer book (docs.codetracer.com).
#
# The book is a consumer of the isonim-docs static-site framework. We reuse
# that framework's OWN self-contained dev shell (sibling ../../../isonim-docs),
# which declares isonim as its flake dependency and reuses isonim's toolchain
# (Nim 2.2.4, node, just, …). Nobody has to `nix develop ../../../isonim`.

source_url \
	"https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.4/direnvrc" \
	"sha256-DzlYZ33mWF/Gs8DDeyjr8mnVmQGx7ASYqA5WlxwvBG4="

dotenv_if_exists
watch_file .env

# Reuse the isonim-docs framework's dev shell. Prefer the live sibling isonim
# checkout (workspace dev — always current) by overriding the framework's
# isonim dependency; if no sibling is present (CI / standalone clone) fall back
# to the pinned github input recorded in isonim-docs/flake.lock.
overrides=()
[[ -d ../../../isonim ]] && overrides+=(--override-input isonim path:../../../isonim)
watch_file ../../../isonim-docs/flake.nix
watch_file ../../../isonim-docs/flake.lock
use flake path:../../../isonim-docs "${overrides[@]}"
