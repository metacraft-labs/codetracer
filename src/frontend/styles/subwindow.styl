@import "defaults"
@import "generated/index"
@import "components/checkmark"

// TODO: integrate themes with subwindow
// or move subwindow to a div inside normal window
// for now copying those from the dark theme
TEXT_CONTENT_COLOR=#F3F3F3
NOTIFICATION_INFO_COLOR = #3B82F6
NOTIFICATION_WARNING_COLOR = #FACC15
NOTIFICATION_ERROR_COLOR = #EF4444
NOTIFICATION_SUCCESS_COLOR = #22C55E
// === end of copied constants

MARGIN_RIGHT=0.9375rem

@import "generated/fonts"
// The design tokens (variables only — no rules), so colours here can name
// them instead of copying hex values.
@import "generated/index"

body
  font-family Arial, sans-serif
  background-color #1e1e1e
  color #ffffff
  display flex
  align-items flex-start
  height 50vh
  margin 0
  padding-left 2.625rem
  padding-top 2.625rem
  padding-right: 1.5rem

#ROOT
  width: -moz-available
  width: -webkit-fill-available
  width: stretch

.dialog-container
  padding-top 6.25rem
  display flex
  flex-direction column
  align-items flex-start
  padding-left 2.5rem
  border-radius 0.75rem
  background-color #252526
  box-shadow 0 0.25rem 0.625rem rgba(0, 0, 0, 0.5)
  width 31.25rem

.dialog-header
  display flex
  align-items center
  margin-bottom 2rem

.dialog-header img
  width 2.5rem
  height 2.5rem
  margin-right $(MARGIN_RIGHT)

.dialog-header h2
  font-size 1.25rem
  font-weight bold
  margin 0

.dialog-icon
  max-width 2.5rem
  max-height 2.5rem
  width auto
  height auto
  margin-right $(MARGIN_RIGHT)

.dialog-content
  color: #f3f3f3
  font-family: "SpaceGrotesk"
  font-size: 1.75rem
  font-style: normal
  font-weight: 500
  line-height: 2rem
  letter-spacing: -0.0175rem
  margin-bottom 2rem

.info-icon
  margin-left 0.625rem

.dialog-actions
  display flex
  gap 0.5rem
  margin-bottom 3.75rem

.install-btn
  background-color colors-brand-500
  color white
  border none
  padding 0.625rem 1rem
  border-radius 0.375rem
  font-weight normal
  width 9.125rem
  height: 2.125rem
  font-family: "SpaceGrotesk"

.dismiss-btn
  background-color #3a3a3a
  color white
  border none
  padding 0.625rem 1rem
  border-radius 0.375rem
  width: 5.5625rem
  height: 2.125rem
  font-family: "SpaceGrotesk"

.install-btn:hover
  background-color #7c6efc

.dismiss-btn:hover
  background-color #4d4d4d

.dialog-options
  display flex
  flex-direction column
  gap 0.5rem
  margin-bottom: 2rem
  font-family: "SpaceGrotesk"

// Checkboxes are the shared component (components/checkmark.styl, imported
// at the top) — the Design System's ❖ Checkbox — not a restyled native input.
.dialog-options label
  display flex
  align-items center
  color: #ABABAB
  font-family: "SpaceGrotesk"
  font-size: 0.875rem
  font-style: normal
  font-weight: 400
  line-height: normal


.custom-tooltip
  display: block
  position: absolute
  font-family: "SpaceGrotesk"
  background-color: #1B1B1B
  color: #f3f3f3
  padding: 0.3125rem 0.625rem
  font-size: 0.875rem
  border-radius: 0.25rem
  white-space: nowrap
  box-shadow: 0 0.25rem 0.5rem rgba(0, 0, 0, 0.2)
  opacity: 0
  visibility: hidden
  transition: opacity 0.3s ease, visibility 0.3s ease, top 0.3s ease
  pointer-events: none
  text-align: start
  font-size: 0.75rem
  line-height: 1rem

  &.active
    opacity: 1
    visibility: visible
    top: -100%
    height: 1.5rem
    right: 0.25rem

.info-icon:hover > .custom-tooltip
  opacity: 1
  visibility: visible
  transition-delay: TOOLTIP_DELAY_TIMER

.dialog-ask-again
  margin-bottom: 0 !important
  color: #ABABAB
  font-family: "SpaceGrotesk"
  font-size: 0.875rem
  font-style: normal
  font-weight: 400
  line-height: normal
  display: flex
  align-items: flex-end


.dialog-install-status
  font-family: "SpaceGrotesk"
  font-size: 1.375rem
  font-style: normal
  font-weight: 400
  line-height: normal
  margin-bottom: 3.125rem

.dialog-install-status-installing
  color: NOTIFICATION_INFO_COLOR

.dialog-install-status-ok
  color: NOTIFICATION_SUCCESS_COLOR

.dialog-install-status-problem
  color: NOTIFICATION_ERROR_COLOR
