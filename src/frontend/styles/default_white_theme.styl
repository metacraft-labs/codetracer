DIFF_BACKGROUND=colors-neutral-stone-150
// surface-primary-secondary-hover
BUTTON_HOVER_BACKGROUND=colors-ui-surface-primary-secondary-hover
// surface-base-raised
TOOLTIP_BACKGROUND=colors-ui-surface-base-raised
// surface-primary-secondary-hover
