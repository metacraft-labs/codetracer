// Space reserved for window controls the operating system paints on top of our
// web contents.  On macOS `titleBarStyle: hidden` keeps the native traffic-light
// buttons and `trafficLightPosition` (src/frontend/index/window.nim) puts them at
// x: 10; the three 12px buttons sit 20px apart, so the cluster ends at 62px.
//
// That trailing edge is deliberately px: the buttons are drawn by the OS at a
// fixed size and do not scale with our font size, so an em/rem value there would
// drift out of alignment whenever the UI scale changes.  The gap after them is
// ours, so it follows the UI scale.
NATIVE_WINDOW_CONTROLS_EDGE = 62px
NATIVE_WINDOW_CONTROLS_GAP = 1rem
NATIVE_WINDOW_CONTROLS_INSET = "calc(%s + %s)" % (NATIVE_WINDOW_CONTROLS_EDGE NATIVE_WINDOW_CONTROLS_GAP)

// Left alignment for the caption bar when no OS window controls are present
// (macOS native fullscreen).
FULLSCREEN_EDGE_GAP = 8px

// Command prompt: floor, viewport-tracking middle, ceiling.
COMMAND_PROMPT_WIDTH = unquote("clamp(24em, 24vw, 40em)")

// The top bar
#menu
  display: flex
  flex-direction: row
  top: 0
  padding: 0.25em
  padding-right: 6em
  box-sizing: border-box
  -webkit-app-region: drag
  user-select: none
  // Spacing between the caption bar's three regions — the debug toolbar, the
  // command prompt and the session tabs, so this is also the gap between the
  // prompt and the new-tab button.  In rem, not em: it should stay 8px whatever
  // font size the bar inherits, rather than scaling with it.
  gap: 0.5rem
  // Must equal `#root-container`'s `top` (shared_widgets.styl) — the content
  // below starts there, so any shortfall leaves an unpainted strip between the
  // two.  Because the strip shows the body background, which is the same colour
  // as this bar, it reads as part of the bar and pushes its contents visually
  // off-centre.  The auto-hide overlays assume the same value.
  //
  // 2.125em is exactly 34px at the 16px root, and the 1.625rem (26px) command
  // prompt then leaves 8px to split — 4px above and 4px below, both whole
  // pixels.  The value has to stay pixel-representable: an earlier 2.27em made
  // the bar 36.31px and the halves 4.155px, which cannot render evenly, so one
  // side rounded down and the field sat 3px from the top and 4px from the
  // bottom.
  height: 2.125em
  max-height: 2.125em
  min-width: 0

  #debug
    -webkit-app-region: no-drag
    // `.ct-header` gives this host `padding: 0 0.25em`, which sat outside the
    // field's visible border and added to the gap beside the new-tab button.
    // The bar's own `gap` is what spaces the regions.
    padding-right: 0
    // Centred on the bar, and deliberately still a flex child: the row is one
    // flow on purpose (see `.session-tab-bar` in session_tabs.styl — "so the
    // new-tab button cannot drift over the omnibox"), so taking this out of
    // flow would let the tabs run underneath it.  Centring comes from the two
    // neighbours sharing the free space equally instead — see the `flex: 1 1 0`
    // on the toolbar below and on the tab bar.
    // Responsive width.  `min()` was the bug: it always picks the *smaller* of
    // the two, so the field could never exceed 24em however wide the display —
    // fine on a laptop, visibly undersized on a large monitor.
    //
    // `clamp()` keeps the same floor and lets the viewport drive the middle
    // term, with a ceiling so it stops being a search field and starts being a
    // banner on very wide screens:
    //   * below ~1600px the floor wins, so laptops keep today's size;
    //   * above that it tracks the viewport;
    //   * beyond ~2670px the ceiling holds it at 40em.
    // The floor is also what keeps the caption bar intact at the 1050px minimum
    // window width, where the toolbar and tab strip are already at their limits.
    flex: 0 0 COMMAND_PROMPT_WIDTH
    width: COMMAND_PROMPT_WIDTH
    min-width: 0
    max-width: 40em
    gap: 0.5em
    align-items: center
    justify-content: center
    align-self: flex-start
    order: 3

    .separate-bar
      margin-top: 0.4em

  .debug-finished-background
    background-color: colors-ui-surface-base-panel

// Keep the bar's own controls clear of the OS-drawn window buttons.  The class is
// set by the menu view when the platform paints its own controls over the bar
// (macOS today) — see `reserveWindowControls` in isonim_menu_shell_view.nim.  The
// inset stays draggable, so the empty strip beside the buttons still moves the
// window.
#menu.menu-shell--reserved-window-controls
  padding-left: NATIVE_WINDOW_CONTROLS_INSET
  // Match the right edge to the left so the centred command prompt is centred
  // on the *window*, not merely between two unequal paddings.  The 6em default
  // reserves room for our own minimise/maximise/close buttons, which macOS
  // never renders (`showWindowMenu` is false there), so the reserve is dead
  // space and its asymmetry pulled the prompt off-centre.
  padding-right: NATIVE_WINDOW_CONTROLS_INSET

  // The session tab bar pulls itself back by the bar's default 0.25em padding
  // so its first tab sits flush with the window edge.  Inside the reserved
  // strip that would claw back part of the space the OS buttons need, so drop
  // the pull-back and let every child start at the inset.
  #session-tab-bar
    margin-left: 0

// Native fullscreen: the OS hides its window buttons, so there is nothing left
// to reserve space for or to divide the bar from.  Left-align the contents at
// FULLSCREEN_EDGE_GAP and drop the leading divider — see `setCaptionBarFullscreen`
// in ui/menu.nim, driven by the window's enter/leave-full-screen events.
#menu.menu-shell--native-fullscreen
  padding-left: FULLSCREEN_EDGE_GAP
  padding-right: FULLSCREEN_EDGE_GAP

  #session-tab-bar
    margin-left: 0

// The debug toolbar opens with a divider, which separates whatever precedes it
// in the caption bar from the toolbar's own controls.  On macOS nothing does:
// the navigation menu is hidden in favour of the system menu bar, so the
// toolbar is the first thing in the bar and the divider reads as a stray line
// at the leading edge.  (Windows and Linux keep it — the navigation menu sits
// before it there, so it still divides something.)
#menu.menu-shell--reserved-window-controls .isonim-debug-controls > .separate-bar:first-child,
#menu.menu-shell--native-fullscreen .isonim-debug-controls > .separate-bar:first-child
  display: none

.window-menu
  display: flex
  position: absolute
  right: 0.3125em
  top: 0
  margin-right: 0
  -webkit-app-region: no-drag
  z-index: 50
  height: 100%
  align-items: center
  cursor: pointer

  .menu-button-svg
    width: 1.5em
    height: 1.5em
    border-radius: 50%
    background-position: center
    background-repeat: no-repeat

    &.minimize
      background-image: WINDOW_MINIMIZE_ICON_PATH
      opacity: 1
      background-position: center
      background-position-y: 65%

    &.restore
      background-image: WINDOW_RESTORE_ICON_PATH
      opacity: 1

    &.maximize
      background-image: WINDOW_MAXIMIZE_ICON_PATH
      opacity: 1

    &.close
      background-image: WINDOW_CLOSE_ICON_PATH
      opacity: 1
      font-size: inherit !important

    &:hover
      opacity: 0.5;

#menu
  /* based on design : psd file and krita color selector */
  /* TODO move to light theme */
  background-color: colors-ui-surface-primary-default
  position: fixed
  width: 100vw
  top: 0
  z-index: 20
  border-top-left-radius: 0.375em
  border-top-right-radius: 0.375em

  i.fa-window-minimize, i.fa-window-maximize
    width: 50px
    height: 50px
    font-size: 20px
    color: OPPOSITE_COLOR

  #navigation-menu
    font-size: inherit
    color: white // TODO is this correct
    z-index: 10
    -webkit-app-region: no-drag
    order: 1
    flex: 0 0 auto

    &:focus
      outline: 0 !important

  #isonim-debug-controls
    order: 2
    // Equal share of the leftover space with the session tab bar, which is what
    // centres the command prompt between them.  `min-width: max-content` keeps
    // the buttons from ever being squeezed, so on a narrow window the prompt
    // drifts right of centre rather than the toolbar clipping.
    flex: 1 1 0
    min-width: max-content

  #debug
    .component-container
      min-width: 0

  #menu-root
    height: 100%
    display: flex
    width: fit-content
    min-width: fit-content
    align-items: center
    justify-content: center

    // No POINTER feedback on hover or active: the logo reads as part of the
    // caption bar rather than as a raised button, so it deliberately keeps
    // the bar's own background in both states instead of the highlight
    // `.ct-button-image-md-secondary` gives every other icon button.
    &:hover:not(:disabled)
      background-color: colors-ui-surface-primary-default !important
    &:active
      background-color: colors-ui-surface-primary-default !important

    // The KEYBOARD focus ring stays.  `:focus-visible` only matches keyboard
    // focus, never a mouse press, so suppressing it buys nothing visually and
    // costs the menu its focus indicator — and `#menu-root` is the only entry
    // point to the application menu, with `#navigation-menu` already running
    // `outline: 0 !important` below.  Removing both leaves a keyboard user
    // unable to see where focus is (WCAG 2.4.7).  If the ring is the wrong
    // shape here, restyle it; do not remove it.

    #menu-logo-img
      width: 1.25em
      height: 1.25em
      background-image: ct-images-logo-dark
      background-size: cover
      background-position: center
      display: inline-block
      position: relative
      cursor: pointer

    #menu-root-name
      height: 25px
      // font-size: 15px
      font-family: Arial, Helvetica, sans-serif
      font-weight: bold
      max-width: 48ex;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      padding-right: 10px

  #menu-main
    font-family: "SpaceMono"
    font-size: MENU_FONT_SIZE
    width: fit-content
    min-width: 12em
    padding: 0
    position: absolute
    // Below the caption bar, by the gap every other menu leaves below its
    // trigger (DROPDOWN_TRIGGER_GAP, components/shared_widgets.styl).  This
    // menu is positioned against `#menu` itself, so the offset has to carry the
    // bar's own height: 2.125rem + 0.375rem = 2.5rem.  It was 2.1rem — 33.6px
    // against a 34px bar — so the menu overlapped the bar's bottom edge by a
    // fraction of a pixel instead of clearing it.
    top: 2.5rem
    margin-left: 6px
    // CHROME ONLY — see `dropdown-surface()` in components/shared_widgets.styl
    // for the two preconditions this element does not meet.  In short: the
    // submenus are absolutely-positioned children laid out BESIDE this box, so
    // `overflow: hidden` deleted them; and `ui/menu.nim` replaces this element
    // on every hover, so the reveal animation replayed on every pointer move.
    // The rows are still clipped to the radius — `#menu-elements` below carries
    // its own `overflow: hidden`, which is the clip that was ever wanted here.
    dropdown-surface-chrome()
    overflow: visible


  // Search results still use the pre-design-system row markup
  // (`.menu-node-name` / `.menu-node-shortcut` / `.menu-node-icon`), so these
  // rules stay — but scoped to `.menu-search-result` ALONE.
  //
  // `.menu-node` / `.menu-element` / `.menu-folder` are deliberately NOT
  // styled here any more: on menu rows they are pure semantic hooks for the
  // GUI test suite (see `viewmodel/views/isonim_menu_shell_view.menuItemClass`
  // and `codetracer-specs/Testing/UI-Test-Catalog.md`), and the row's whole
  // appearance comes from the `.ct-menu-item` component
  // (`components/menu_item.styl`).  Because `#menu .menu-node` outranks
  // `.ct-menu-item`, leaving them in this selector would repaint every row
  // with the old input-surface background, margins and 4px radius the moment
  // the hooks came back.
  .menu-search-result
    font-size: MENU_FONT_SIZE
    height: auto
    min-width: fit-content //"calc(%s + 2px)" % MENU_NODE_MIN_WIDTH
    display: flex
    padding-top: 2px
    padding-bottom: 2px
    background-color: colors-ui-surface-input-default
    margin-left: 4px
    margin-right: 4px
    align-items: center
    border-radius: 4px

  .menu-node-container
    display: block
    width: 100%
    max-width: 100%
    box-sizing: border-box
    -webkit-app-region: no-drag
    pointer-events: auto

  // .menu-node:hover
  //   background-color: colors-ui-surface-primary-tertiary

  // .menu-node:hover > .menu-node-icon
  //   opacity: 1

  .menu-search-result
    .menu-node-name
      // width: MENU_ELEMENT_NAME_WIDTH
      width: -webkit-fill-available !important
      justify-content: space-between
      float: left
      padding-left: 8px
      padding-right: 8px
      color: colors-ui-text-primary-body
      font-size: MENU_FONT_SIZE
      border-radius: 5px
      display: flex
      align-items: center
      font-weight: 400
      line-height: 18px
      white-space: nowrap

    .menu-node-shortcut
      width: fit-content !important
      // min-width: MENU_NODE_SHORTCUT_MIN_WIDTH
      background-color: colors-ui-surface-primary-secondary-hover
      border-radius: 6px
      color: colors-ui-text-primary-body
      // overflow: hidden
      font-size: 10px
      text-align: right
      padding: 4px
      line-height: 10px
      margin-right: 8px
      margin-left: 8px
      white-space: nowrap
      // padding-right: 15px


  .menu-folder
    .menu-node-name
      // width: MENU_NODE_NAME_WIDTH !important
      width: -webkit-fill-available !important
      justify-content: space-between
      float: left
      padding-left: 8px
      padding-right: 8px
      color: colors-ui-text-primary-body
      font-size: MENU_FONT_SIZE
      border-radius: 5px
      display: flex
      align-items: center
      font-weight: 400
      white-space: nowrap


    .menu-expand
      width: MENU_EXPAND_WIDTH
      float: left
      position: relative
      margin-left: 8px
      display: flex
      align-items: center

      &::after
        position: absolute
        right: 0px
        // top: calc(50% - 6px)
        width: 7px
        height: 8px
        content: MENU_EXTEND_ARROW_ICON
        display: flex
        align-items: center
        padding-bottom: 2px
        // border: 6px solid transparent
        // border-left-color: colors-ui-text-primary-body

  .menu-node-icon
    width: 14px
    height: 24px
    display: flex
    align-items: center
    margin-left: 4px
    opacity: 0.5

    i
      font-size: 14px !important

  .icon
    width: 14px
    height: 14px
    background-repeat: no-repeat
    background-position: center
    background-size: 14px

    &.file
      background-image: FILE_MENU_ICON

    &.new-file
      background-image: NEW_FILE_MENU_ICON

    &.open-file
      background-image: OPEN_FILE_MENU_ICON

    &.edit
      background-image: EDIT_MENU_ICON

    &.navigate
      background-image: NAVIGATE_MENU_ICON

    &.view
      background-image: VIEW_MENU_ICON

    &.build
      background-image: BUILD_MENU_ICON

    &.debug
      background-image: DEBUG_MENU_ICON

    &.help
      background-image: HELP_MENU_ICON

  #menu-elements
    width: 100%
    // Clips the end rows to the surface's curve, so it has to be the surface's
    // curve — see DROPDOWN_RADIUS in components/shared_widgets.styl.
    overflow: hidden
    border-radius: DROPDOWN_RADIUS

  .menu-node-container
    width: 100%

  .menu-nested-elements
    position: absolute
    font-size: 1em
    width: fit-content
    min-width: 12em
    padding: 0
    // CHROME ONLY, for the second reason given on `#menu-main` above: a submenu
    // is rebuilt on every pointer move within it, so the reveal animation
    // replayed from `opacity: 0` each time.  The clip is kept — a submenu's
    // children ARE its rows, and they should be cut to its radius.
    dropdown-surface-chrome()
    overflow: hidden

  #menu-elements, .menu-nested-elements
    .menu-node-container:first-child > .ct-menu-item
      border-radius: DROPDOWN_RADIUS DROPDOWN_RADIUS 0 0

    .menu-node-container:last-child > .ct-menu-item
      border-bottom: none
      border-radius: 0 0 DROPDOWN_RADIUS DROPDOWN_RADIUS

  // `.menu-enabled` / `.menu-disabled` are semantic hooks only — the enabled
  // and disabled *appearance* of a menu row is owned by `.ct-menu-item` and
  // `.ct-menu-item--disabled` (`components/menu_item.styl`).  They carry no
  // declarations here on purpose: `#menu .menu-enabled` outranks
  // `.ct-menu-item`, so the old `border-radius: 4px` would win over the
  // component's square rows, and the old `.menu-disabled .menu-node-name`
  // grey no longer has a `.menu-node-name` to colour.

  #menu-search-results
    height: auto
    margin-top: 5px
    margin-bottom: 5px

    &:empty
      display: none

  #menu-search
    margin-left: 4px
    margin-right: 4px
    // border-right: 1px solid colors-ui-text-primary-body
    border-top: 0
    font-size: 14px

  #menu-search-header
    display: block
    height: 11px
    width: 100%
    color: colors-ui-text-primary-body
    background: linear-gradient(to top, colors-ui-surface-input-default, transparent 1px),
            linear-gradient(315deg, colors-ui-surface-input-default, colors-ui-surface-input-default 5px, transparent, transparent calc(6px)),
            linear-gradient(45deg, colors-ui-surface-input-default, colors-ui-surface-input-default 5px, transparent, transparent calc(6px)),
            linear-gradient(to top, colors-ui-surface-input-default, transparent 1px)
    background-repeat: no-repeat, no-repeat, no-repeat, no-repeat
    background-size: 1vw 11px, 11px 11px, 11px 11px, calc(16vw - 22px) 11px
    background-position: left 0 bottom, left 1vw bottom, left calc(1vw + 11px) bottom, left calc(1vw + 22px) bottom
    position: fixed
    border: 0
    top: 25px

  #menu-search input
    position: relative
    height: 28px
    bottom: 0
    width: 100% //MENU_SEARCH_INPUT_WIDTH
    // min-width: MENU_SEARCH_INPUT_MIN_WIDTH
    border: 0.5px solid colors-ui-border-primary
    border-radius: 6px
    background-color: colors-ui-surface-base-panel
    color: colors-ui-text-primary-body
    margin: 0 !important
    font-size: 14px !important

    &:focus
      outline: 0 !important
      border: 0 !important


  .menu-search-icon
    width: MENU_EXPAND_WIDTH
    cursor: pointer
    background-color: colors-ui-surface-input-default
    height: MENU_LINE_HEIGHT
    color: colors-ui-text-primary-body
    border: 0
    display: inline-block
  // border-top: 1px solid colors-ui-text-primary-body


  .menu-search-result
    height: MENU_LINE_HEIGHT
    cursor: pointer
    color: colors-ui-text-primary-body
    background-color: colors-ui-surface-input-default

  .menu-sub-group-separator
    display: none

  .menu-active-node
    background-color: colors-ui-surface-input-default
    // .ct-menu-item--active inside handles the blue focus bg via menu_item.styl

  .menu-active-search-result
    background-color: colors-ui-surface-primary-tertiary

  .menu-no-search-results
    background-color: colors-ui-surface-input-default
    color: colors-ui-text-primary-body
    font-style: italic
    padding-left: 20px
