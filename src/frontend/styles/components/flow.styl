
.flow-status-widget
  height: 19px
  width: max-content
  display: inline-block
  background-color: colors-editor-surface-primary
  color: colors-ui-text-primary-body
  font-size: 15px
  padding-left: 2px
  padding-right: 2px

.flow-component
  display: flex
  flex-direction: column
  height: 100%
  width: 100%
  min-height: 0
  box-sizing: border-box
  overflow: hidden
  color: colors-ui-text-primary-body
  font-family: "FiraCode"
  font-size: 13px
  line-height: 20px

  .flow-mode-selector
    display: flex
    align-items: center
    gap: 4px
    padding: 6px 8px
    flex: 0 0 auto

    button
      height: 24px
      min-width: 64px
      padding: 0 10px
      border: 0
      border-radius: 4px
      background: colors-ui-surface-primary-tertiary
      color: colors-ui-text-primary-body
      cursor: pointer
      font: inherit

      &.active
        background: colors-ui-surface-input-default
        color: colors-ui-text-primary-body

  .flow-loading
    padding: 0 8px 6px
    color: colors-ui-text-primary-body

    &[display="none"]
      display: none

  .flow-iteration-slider
    display: grid
    grid-template-columns: max-content minmax(140px, 360px)
    gap: 10px
    align-items: center
    padding: 0 8px 8px
    flex: 0 0 auto

  .iteration-range
    width: 100%

  .flow-steps
    flex: 1 1 auto
    min-height: 0
    border-top: 1px solid colors-ui-surface-input-default
    overflow: auto
    background: colors-editor-surface-primary

  .flow-steps-header,
  .flow-step-row
    display: grid
    grid-template-columns: 4.5em 14em minmax(16em, 1fr) minmax(12em, 20em)
    align-items: center
    column-gap: 1em
    padding: 0 0.75em
    min-height: 24px
    border-bottom: 1px solid colors-ui-border-secondary

  .flow-steps-header
    position: sticky
    top: 0
    z-index: 1
    color: colors-ui-text-primary-body
    background: colors-editor-surface-primary
    font-size: 12px

  .flow-step-row
    cursor: pointer
    color: colors-ui-text-primary-body

    &:hover,
    &.hovered
      background: colors-ui-surface-primary-secondary-hover

  .flow-step-index
    color: colors-ui-text-primary-body

  .flow-step-location
    color: #9cdcfe

  .flow-step-expression
    color: colors-ui-text-primary-body
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap

  .flow-step-value
    color: #b5cea8
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap

  .flow-steps-empty
    padding: 0.75em
    color: colors-ui-text-primary-body

  .flow-value-display
    display: flex
    align-items: center
    justify-content: space-between
    gap: 8px
    padding: 4px 8px
    border-top: 1px solid colors-ui-surface-input-default
    flex: 0 0 auto

  .raw-value-toggle
    height: 22px
    padding: 0 8px
    border: 0
    border-radius: 4px
    background: colors-ui-surface-primary-tertiary
    color: colors-ui-text-primary-body
    cursor: pointer
    font: inherit

    &.active
      background: colors-ui-surface-input-default
      color: colors-ui-text-primary-body

