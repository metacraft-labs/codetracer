  float: left

  i
    font-size: inherit

.value-non-expanded
  color: orange

.value-error
  color: colors-ui-text-error-primary

.value-non-expanded, .value-error
  position: absolute
  overflow: hidden
  white-space: nowrap
  text-overflow: ellipsis
  width: 95%
  background: colors-ui-surface-base-panel

.value-watch
  font-style: italic

.value-selected
  opacity: 0.5

// A variable's name ("x:") in the State, Scratchpad and value-popup rows.
.value-name
  color: colors-ui-text-primary-active
  white-space: nowrap

.value-type
  margin-left: 0.5em
  color: colors-ui-text-primary-body
  white-space: nowrap

.value-annotation
  margin-left: 0.3125em
  color: colors-ui-text-primary-body
  opacity: 0.5
  white-space: nowrap

.value-view
  display: flex
  align-items: center
  flex-wrap: wrap

  .value-error
    margin-left: 1.0625em !important
    position: inherit

.value-name-container
  display: flex
  align-items: center

  .caret-collapse
    display: block
    background-image: SHARED_OPEN_FA_ICON
    background-position: center
    background-repeat: no-repeat
    width: 0.5em
    height: 0.5em

  .caret-expand
    display: block
    background-image: SHARED_CLOSE_FA_ICON
    background-position: center
    background-repeat: no-repeat
    width: 0.5em
    height: 0.5em

.value-line-view-text
  display: flex
  white-space: nowrap
  text-overflow: visible
//padding-right: 1.5625em

.value-expanded-view-text
  display: flex
  flex-direction: column
  white-space: nowrap
  text-overflow: visible
//padding-right: 1.5625em

.value-expanded-name-text-content
  width: 100%
  overflow: hidden
  white-space: nowrap
  text-overflow: ellipsis

.value-expanded-view
  //flex-basis: 68%
  color: colors-ui-text-primary-body
  position: relative
  margin-left: 0.625em
  background: colors-ui-surface-base-panel

