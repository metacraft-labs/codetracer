// Agent Harbor suggested UI actions (isonim_agent_harbor_suggested_actions_view.nim):
// the block an agent's suggested actions wait in, beneath a session
// timeline's list (P2c study D23, D54-D59). A file of its own, as the
// timeline's rules are (agent_harbor_activity.styl).
//
// The block sits one ground step off the panel, and holds no border or card
// of its own. The timeline's `Running:` strip names `surface/primary/secondary`,
// which the design system maps to the panel's own colour in both themes
// (`surface/base/panel`: grey/700 Dark, clay/150 Light), so it would not set
// the block off. Dark takes the next step of that scale,
// `surface/primary/secondary-hover` (grey/650); Light, where that step is
// clay/300 and read as a heavy band, takes `surface/base/card` (clay/200),
// one step off its clay/150 panel (study D56). It follows the timeline's
// last line, and stays at the panel's foot once the timeline is longer than
// the panel (D55). Rows are told apart by their check box and their words'
// role: a checked action in the body role, one the operator unchecked in
// the caption role, one CodeTracer cannot perform in the caption-subtle
// role with its reason under it in the caption role (D57). `Approve` is CodeTracer's primary button (the composer's
// send button: `surface/action/primary` with `text/on-action/primary`), and
// `Dismiss` its quiet one. Every colour is a design-system role, its Light
// value under COLOR_MODE = "Light".

AH_SUGGESTED_PAD = 0.5rem          // PANEL_INSET, as the timeline's lines
AH_SUGGESTED_BOX = 0.875rem        // the check box

.ah-suggested
  display: flex
  flex-direction: column
  gap: 0.375rem
  flex-shrink: 0
  max-height: 60%
  overflow-y: auto
  padding: 0.5rem AH_SUGGESTED_PAD
  background: by-mode(colors-ui-surface-primary-secondary-hover, colors-ui-surface-base-card)
  font-size: ah-rem(type-ui-size-body-md)
  color: colors-ui-text-primary-body

.ah-suggested-label
  font-size: ah-rem(type-ui-size-caption-md)
  font-weight: 500
  letter-spacing: 0.04em
  text-transform: uppercase
  color: colors-ui-text-primary-label

// The agent's reason: prose, wrapped.
.ah-suggested-reason
  line-height: 1.25rem
  overflow-wrap: anywhere

.ah-suggested-rows
  display: flex
  flex-direction: column
  gap: 0.125rem

.ah-suggested-row
  display: flex
  align-items: flex-start
  gap: 0.5rem
  padding: 0.125rem 0
  line-height: 1.25rem

.ah-suggested-box
  flex: 0 0 AH_SUGGESTED_BOX
  height: AH_SUGGESTED_BOX
  margin-top: 0.1875rem
  display: inline-flex
  align-items: center
  justify-content: center
  box-sizing: border-box
  border: 0.0625rem solid colors-ui-text-primary-caption
  border-radius: 0.1875rem
  background: transparent
  font-size: 0.6875rem
  font-weight: 700
  line-height: 1

// Checked: the action border role, and the check in it, on the block's
// ground (a strong mark in both themes, where Light's action fill is pale).
.ah-suggested-checked .ah-suggested-box
  border-color: colors-ui-border-action
  color: colors-ui-border-action

// Unchecked by the operator: the caption role, as its words (a box that can
// be checked stays plainly there). Cannot be performed: a step quieter, in
// the caption-subtle role of its words, so a disabled box never stands out
// more than one that can be checked.
.ah-suggested-disabled .ah-suggested-box
  border-color: colors-ui-text-primary-caption-subtle

.ah-suggested-text
  display: flex
  flex-direction: column
  min-width: 0

// What the action does is what the operator consents to: wrapped, never cut.
.ah-suggested-words
  overflow-wrap: anywhere

.ah-suggested-dimmed .ah-suggested-words
  color: colors-ui-text-primary-caption

.ah-suggested-disabled .ah-suggested-words
  color: colors-ui-text-primary-caption-subtle

.ah-suggested-why
  font-size: ah-rem(type-ui-size-caption-md)
  line-height: 1rem
  color: colors-ui-text-primary-caption
  overflow-wrap: anywhere

.ah-suggested-actions
  display: flex
  flex-wrap: wrap
  align-items: center
  gap: 0.5rem
  padding-top: 0.125rem

.ah-suggested-button-primary
  height: CONTROL_HEIGHT_SM
  padding: 0 0.75rem
  align-items: center
  border: 0.0625rem solid colors-ui-surface-action-primary
  border-radius: ah-rem(border-border-radius-control)
  background: colors-ui-surface-action-primary
  color: colors-ui-text-on-action-primary
  font-family: inherit
  font-size: ah-rem(type-ui-size-label-md)

  &:disabled
    border-color: colors-ui-border-secondary
    background: transparent
    color: colors-ui-text-primary-disabled

.ah-suggested-button-dismiss
  height: CONTROL_HEIGHT_SM
  padding: 0 0.75rem
  align-items: center
  border: 0.0625rem solid colors-ui-border-primary
  border-radius: ah-rem(border-border-radius-control)
  background: transparent
  color: colors-ui-text-primary-body
  font-family: inherit
  font-size: ah-rem(type-ui-size-label-md)

.ah-suggested-hint
  font-size: ah-rem(type-ui-size-caption-md)
  color: colors-ui-text-primary-caption

// While a block follows the timeline, the timeline's list does not grow:
// the block sits under its last line, and once the lines are taller than
// the panel the list shrinks and scrolls, the block at the panel's foot
// (D55). The timeline's own rules (agent_harbor_activity.styl) are not
// changed.
.ah-activity-body:has(> .ah-suggested) > .ah-activity-lines
  flex-grow: 0
