// Code surface: keep a monospace face.  This used to be inherited from the
// app-wide `body` rule, which is now Space Grotesk (the interface face), so
// it has to be stated here — process names and commands read as code.
.ct-process-tree
  font-family: "SpaceMono", monospace

// Multi-process session sidebar (spec
// GUI/Debugging-Features/Value-Origin-Tracking.md §14.8: "A process tree
// in the side bar listing each trace's role + thread count").
//
// The host is a flex item of #auto-hide-layout-row, inserted before the
// left auto-hide strip, so the process tree tiles WITH the GoldenLayout
// container rather than overlaying it — the same layout discipline the
// auto-hide side strips follow (see auto_hide.styl).
//
// Single-recording sessions render nothing at all (the view's
// `shouldRenderTree` returns false), and an empty host collapses to zero
// width, so the pre-multi-process layout is unchanged to the pixel.

#ct-process-tree-host
  display: flex
  flex-direction: column
  flex-shrink: 0
  flex-grow: 0
  overflow: hidden

  &:empty
    width: 0
    max-width: 0

.ct-process-tree
  display: flex
  flex-direction: column
  box-sizing: border-box
  width: 12em
  min-width: 12em
  height: 100%
  overflow-y: auto
  background-color: colors-ui-surface-base-canvas
  border-right: 1px solid colors-ui-border-secondary
  font-size: 0.8rem
  user-select: none

.ct-process-tree-header
  padding: 0.4em 0.6em
  text-transform: uppercase
  letter-spacing: 0.05em
  font-weight: bold
  opacity: 0.6

// Four of this pane's colours named variables that do not exist
// (`colors-ui-border-base`, `colors-ui-surface-base-hover`,
// `colors-ui-surface-base-selected`, `colors-ui-text-accent`), so Stylus
// emitted them verbatim and the browser dropped all four: the pane had no
// right-hand edge, rows did not respond to hover, and the active process was
// indistinguishable from the rest. `ci/test/css-token-resolution.sh` is what
// now notices that shape.
//
// The replacements are the tokens the rest of this sheet already uses for
// these three states rather than newly chosen colours:
//
//   hover     colors-ui-surface-base-card              #262626 — the same
//             token ns9_panes.styl uses for a row hover, so the two sibling
//             panes respond identically.
//   active    colors-ui-surface-primary-secondary-hover #333333 — the house
//             selected-row background, 11 other rules deep. Chosen over
//             #262626/#282828 because the active row has to be told apart
//             from the hovered one WHILE the pointer is on it.
//   rail      colors-ui-border-action                  #6366f1 — the
//             interactive/brand border.
//
// The rail measures 2.83:1 against the active row's #333333 and 3.86:1
// against the pane's #1b1b1b canvas. The first is short of the 3:1 WCAG
// 1.4.11 asks of a UI graphic, and it is recorded here rather than papered
// over: no `colors-ui-*` token on the brand ramp clears 3:1 on #333333
// (indigo-600 manages 2.01:1, and this indigo-500 is the brightest of them),
// so clearing it would mean spending a raw ramp colour where the design
// system expects a semantic one. Selection is carried by the row background
// as well as the rail, so the rail is not the sole indicator.
.ct-process-tree-entry
  display: flex
  flex-direction: column
  padding: 0.35em 0.6em
  cursor: pointer
  border-left: 2px solid transparent

  &:hover
    background-color: colors-ui-surface-base-card

  &.active
    border-left-color: colors-ui-border-action
    background-color: colors-ui-surface-primary-secondary-hover

.ct-process-tree-role
  font-weight: bold

.ct-process-tree-name,
.ct-process-tree-threads
  opacity: 0.7
  white-space: nowrap
  overflow: hidden
  text-overflow: ellipsis
