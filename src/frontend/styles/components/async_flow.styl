// Code surface: keep a monospace face.  This used to be inherited from the
// app-wide `body` rule, which is now Space Grotesk (the interface face), so
// it has to be stated here — flow values are code.
.async-flow
  font-family: "SpaceMono", monospace

.calltrace-async-toggle
  display flex
  align-items center
  padding 4px 8px
  gap 8px
  border-bottom 1px solid colors-ui-border-secondary

.async-toggle-label
  font-size 12px
  color colors-ui-text-primary-label-subtle

.async-toggle-buttons
  display flex
  gap 2px

.toggle-btn
  padding 2px 8px
  font-size 11px
  border 1px solid colors-ui-border-secondary
  background transparent
  color colors-ui-text-primary-body
  cursor pointer
  border-radius 3px
  &.active
    background colors-ui-surface-base-card
    color colors-ui-text-primary-headings

.continuation-jump-link
  display inline-block
  margin-left 4px
  // A link and its hover: GitHub-dark blues, 2.3:1 and 1.8:1 on the light
  // ground, which takes the information text tokens (`by-mode`, defaults.styl).
  color by-mode(#58a6ff, colors-ui-text-information-primary)
  cursor pointer
  font-size 14px
  &:hover
    color by-mode(#79c0ff, colors-ui-text-information-primary-hover)
    text-decoration underline

.calltrace-virtual-placeholder
  padding 16px
  color colors-ui-text-primary-label-subtle
  font-size 13px
  font-style italic
