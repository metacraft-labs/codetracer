.shader-debug-component
  display: flex
  flex-direction: column
  height: 100%
  width: 100%
  min-height: 0
  box-sizing: border-box
  overflow: hidden
  color: colors-ui-text-primary-body
  background: colors-ui-surface-base-panel
  font-family: "SpaceGrotesk"
  font-size: 0.8125rem
  line-height: 1.25rem

  .shader-debug-header
    display: flex
    align-items: center
    justify-content: space-between
    gap: 0.625rem
    padding: 0.4375rem 0.625rem
    flex: 0 0 auto
    border-bottom: 0.0625rem solid colors-ui-surface-input-default
    background: colors-ui-surface-primary-tertiary

  .shader-debug-title
    font-weight: 600

  .shader-debug-context
    color: colors-ui-text-primary-body
    min-width: 0
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap

  .shader-debug-loading,
  .shader-debug-error,
  .shader-debug-empty
    padding: 0.625rem
    color: colors-ui-text-primary-body

    &[display="none"]
      display: none

  .shader-debug-error
    color: colors-ui-text-error-primary

  .shader-debug-toolbar
    display: flex
    align-items: center
    gap: 0.5rem
    padding: 0.4375rem 0.625rem
    flex: 0 0 auto
    border-bottom: 0.0625rem solid colors-ui-border-secondary

    button
      min-width: 2.875rem
      height: 1.5rem
      border: 0.0625rem solid colors-ui-border-secondary
      border-radius: 0.25rem
      background: colors-ui-surface-primary-tertiary
      color: colors-ui-text-primary-body
      font: inherit

      &:hover
        background: colors-ui-surface-primary-secondary-hover

  .shader-debug-stage,
  .shader-debug-step-label
    color: colors-ui-text-primary-body
    white-space: nowrap

  .shader-debug-body
    display: grid
    grid-template-columns: minmax(0, 1.4fr) minmax(13.75rem, 0.8fr)
    min-height: 0
    flex: 1 1 auto

  .shader-debug-source
    min-height: 0
    overflow: auto
    border-right: 0.0625rem solid colors-ui-border-secondary

  .shader-debug-source-line
    display: grid
    grid-template-columns: 2.625rem minmax(0, 1fr)
    min-height: 1.375rem
    align-items: baseline

    &.current
      background: colors-ui-surface-primary-secondary-hover
      color: colors-ui-text-primary-body

  .shader-debug-line-number
    padding: 0 0.5rem
    color: colors-ui-text-primary-body
    text-align: right
    user-select: none

  .shader-debug-line-code
    white-space: pre
    overflow: hidden
    text-overflow: ellipsis
    font: inherit

  .shader-debug-inspector
    min-height: 0
    overflow: auto
    padding: 0.5rem 0.625rem

  .shader-debug-instruction
    display: grid
    grid-template-columns: auto minmax(0, 1fr)
    gap: 0.5rem
    margin-bottom: 0.625rem

  .shader-debug-instruction-label,
  .shader-debug-values-title
    color: colors-ui-text-primary-body
    font-weight: 600

  .shader-debug-instruction-value
    min-width: 0
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap

  .shader-debug-values-section
    margin-bottom: 0.75rem

  .shader-debug-values-table
    display: grid
    grid-template-columns: minmax(4.375rem, auto) minmax(3.4375rem, auto) minmax(0, 1fr)
    gap: 0
    border-top: 0.0625rem solid colors-ui-border-secondary

  .shader-debug-value-row
    display: contents

  .shader-debug-value-name,
  .shader-debug-value-type,
  .shader-debug-value-current
    min-width: 0
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap
    padding: 0.25rem 0.375rem
    border-bottom: 0.0625rem solid colors-ui-border-secondary

  .shader-debug-value-type
    color: colors-ui-text-primary-body

  .shader-debug-values-empty
    color: colors-ui-text-primary-body
    padding: 0.25rem 0
