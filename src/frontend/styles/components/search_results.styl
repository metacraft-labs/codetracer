// Find in Files panel — Figma-matched layout with design system tokens.
//
// Class prefix: fif-  (Find In Files)
// Legacy classes kept for wiring compatibility:
//   .search-results        — panel root identity (auto-hide, render-panel lookups)
//   .search-results-match-row   — Playwright E2E anchor
//   .search-results-highlight   — match highlight span

// ---------------------------------------------------------------------------
// Shimmer animation
// ---------------------------------------------------------------------------

@keyframes fif-shimmer
  0%
    background-position: -400px 0
  100%
    background-position: 400px 0

// ---------------------------------------------------------------------------
// Panel root
// ---------------------------------------------------------------------------

.fif-panel
  display: flex
  flex-direction: column
  height: 100%
  background-color: colors-ui-surface-base-panel
  color: colors-ui-text-primary-body
  font-size: 13px
  overflow: hidden

// ---------------------------------------------------------------------------
// Header row: title + action icons
// ---------------------------------------------------------------------------

.fif-header
  display: flex
  align-items: center
  justify-content: space-between
  padding: 8px 10px 6px
  flex-shrink: 0
  border-bottom: 1px solid colors-ui-border-secondary

.fif-title
  font-size: 11px
  font-weight: 700
  letter-spacing: 0.08em
  text-transform: uppercase
  color: colors-ui-text-primary-body-subtle
  user-select: none

.fif-header-actions
  display: flex
  align-items: center
  gap: 4px

.fif-icon-btn
  display: flex
  align-items: center
  justify-content: center
  width: 22px
  height: 22px
  border-radius: 4px
  cursor: pointer
  color: colors-ui-text-primary-body-subtle
  font-size: 14px
  line-height: 1

  &:hover
    background-color: colors-ui-surface-primary-secondary-hover
    color: colors-ui-text-primary-body

.fif-close
  font-size: 16px

// ---------------------------------------------------------------------------
// Search bar: badge + input + clear button
//
// The wrapper (.fif-search-bar) matches the ct-input-com-pal visual
// treatment (same height, border, radius, background) so the bar looks
// like a standard CodeTracer input component.  The inner <input> is
// transparent/borderless and fills the remaining space between the badge
// and the clear button.
// ---------------------------------------------------------------------------

// Search bar: position:relative wrapper so badge and clear button can be
// positioned absolutely inside.  No visual styling — the inner <input>
// carries ct-input-panel + ct-input-search-image exactly like the event log.
.fif-search-bar
  position: relative
  margin: 8px 10px
  flex-shrink: 0

// "Find in Files" badge — compact pill between the search icon and the
// text cursor.  Absolutely positioned so it overlays the input without
// affecting flow; the input's padding-left is widened to push the cursor
// past the badge.
//
// left: 2em      — clears the magnifying-glass icon (icon at 0.5em, 1em wide
//                  inside 1.875em padding-left region) with a small gap.
// height: 1em    — compact, does NOT fill the full input height.
// top/transform  — vertically centred inside the input row.
.fif-badge
  position: absolute
  left: 2rem
  top: 50%
  transform: translateY(-50%)
  display: inline-flex
  align-items: center
  height: 1rem
  padding: 0 0.4em
  border-radius: 0.2em
  font-size: 0.75em
  font-weight: 600
  letter-spacing: 0.06em
  text-transform: uppercase
  white-space: nowrap
  pointer-events: none
  user-select: none
  background-color: colors-ui-surface-alert-information
  color: colors-ui-text-information-primary

// Inner <input> — identical treatment to the event-log search input:
// ct-input-panel provides the background/border/height tokens and
// ct-input-search-image adds the magnifying-glass icon on the left.
// padding-left is extended past the icon + badge so the cursor/placeholder
// start cleanly after the badge.  padding-right reserves space for ×.
.fif-input
  width: -webkit-fill-available
  padding-left: calc(2em + 6.5rem) !important
  padding-right: 1.75rem !important

  &::placeholder
    color: colors-ui-text-primary-body-subtle
    opacity: 0.6

// Clear (×) button — absolutely positioned at the right edge of the input.
// Hidden by default, shown via JS when the input has content.
.fif-clear-btn
  display: none
  position: absolute
  right: 0.375rem
  top: 50%
  transform: translateY(-50%)
  align-items: center
  justify-content: center
  width: 1.25rem
  height: 1.25rem
  border-radius: 0.25rem
  font-size: 0.875rem
  line-height: 1
  color: colors-ui-text-primary-body-subtle
  cursor: pointer
  user-select: none

  &:hover
    background-color: colors-ui-surface-primary-secondary-hover
    color: colors-ui-text-primary-body

// ---------------------------------------------------------------------------
// Body: scrollable results area
// ---------------------------------------------------------------------------

.fif-body
  flex: 1
  overflow-y: auto
  min-height: 0

// ---------------------------------------------------------------------------
// Empty / recent state
// ---------------------------------------------------------------------------

.fif-empty
  padding: 12px 10px
  display: flex
  flex-direction: column
  gap: 2px

.fif-empty-prompt
  color: colors-ui-text-primary-body-subtle
  font-size: 12px
  text-align: center
  padding: 24px 0
  opacity: 0.7

.fif-recent-label
  font-size: 11px
  font-weight: 600
  letter-spacing: 0.05em
  text-transform: uppercase
  color: colors-ui-text-primary-body-subtle
  padding: 4px 2px 8px
  opacity: 0.7

.fif-recent-item
  display: flex
  align-items: center
  justify-content: space-between
  padding: 5px 8px
  border-radius: 5px
  cursor: pointer
  gap: 8px

  &:hover
    background-color: colors-ui-surface-primary-secondary-hover

.fif-recent-query
  font-size: 12px
  color: colors-ui-text-primary-body
  overflow: hidden
  text-overflow: ellipsis
  white-space: nowrap
  flex: 1

.fif-recent-count
  font-size: 11px
  color: colors-ui-text-primary-body-subtle
  white-space: nowrap
  flex-shrink: 0

// ---------------------------------------------------------------------------
// Loading shimmer rows
// ---------------------------------------------------------------------------

.fif-shimmer-block
  height: 28px
  margin: 3px 10px
  border-radius: 4px
  background: linear-gradient(
    90deg,
    colors-ui-surface-primary-tertiary 25%,
    colors-ui-surface-primary-secondary-hover 50%,
    colors-ui-surface-primary-tertiary 75%
  )
  background-size: 800px 100%
  animation: fif-shimmer 1.4s infinite linear

// ---------------------------------------------------------------------------
// File group + header
// ---------------------------------------------------------------------------

.fif-file-group
  margin-bottom: 1px

.fif-file-header
  display: flex
  align-items: center
  justify-content: space-between
  padding: 4px 10px
  background-color: colors-ui-surface-primary-tertiary
  position: sticky
  top: 0
  z-index: 1
  gap: 8px

.fif-file-path
  font-size: 12px
  font-weight: 600
  color: colors-ui-text-primary-body
  overflow: hidden
  text-overflow: ellipsis
  white-space: nowrap
  flex: 1

.fif-file-count
  font-size: 11px
  color: colors-ui-text-primary-body-subtle
  white-space: nowrap
  flex-shrink: 0

// ---------------------------------------------------------------------------
// Match rows
// ---------------------------------------------------------------------------

.fif-match-row
  display: flex
  align-items: baseline
  padding: 3px 10px 3px 20px
  cursor: pointer
  font-family: monospace
  font-size: 12px
  line-height: 1.6
  gap: 6px

  &:hover
    background-color: colors-ui-surface-primary-secondary-hover

.fif-line-number
  min-width: 36px
  text-align: right
  color: colors-ui-text-primary-body-subtle
  font-size: 11px
  flex-shrink: 0
  user-select: none

.fif-match-text
  overflow: hidden
  text-overflow: ellipsis
  white-space: nowrap
  flex: 1
  color: colors-ui-text-primary-body

// ---------------------------------------------------------------------------
// Match highlight — orange accent matching Figma
// ---------------------------------------------------------------------------

.fif-highlight
  background-color: rgba(251, 146, 60, 0.30)
  color: inherit
  border-radius: 2px
  padding: 0 1px

// Keep legacy selector working (Playwright + existing E2E tests).
.search-results-highlight
  background-color: rgba(251, 146, 60, 0.30)
  color: inherit
  border-radius: 2px
  padding: 0 1px

// ---------------------------------------------------------------------------
// Legacy visibility toggle (GoldenLayout / auto-hide shim)
// ---------------------------------------------------------------------------

.search-results-active
  display: flex

.search-results-non-active
  display: none
