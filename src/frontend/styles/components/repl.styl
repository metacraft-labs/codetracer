// Code surface: keep a monospace face.  This used to be inherited from the
// app-wide `body` rule, which is now Space Grotesk (the interface face), so
// it has to be stated here — REPL input and results are code.
#replComponent, .repl
  font-family: "SpaceMono", monospace

.repl-component
  height: 100%
  width: 100%
  min-height: 0
  background-color: colors-ui-surface-base-panel
  color: colors-ui-text-primary-body
  overflow: hidden

.repl-msg-wrapper
  width: inherit
  height: inherit
  display: flex
  justify-content: center
  align-items: center
  color: colors-ui-text-primary-body
  font-style: italic

  .repl-disabled-msg
    text-align: center
    white-space: break-spaces

#repl
  height: 100%
  min-height: 0
  display: flex
  flex-direction: column
  background-color: colors-ui-surface-base-panel
  color: colors-ui-text-primary-body

  form
    flex: 0 0 auto

  #repl-input
    color: colors-ui-text-primary-body
    height: 1.75rem
    font-size: 1.0625rem !important
    border: 0
    background-color: colors-ui-surface-primary-tertiary
    width: calc(100% - 0.375rem)
    margin-left: 0.5rem !important
    margin-right: 0.5rem
    margin-bottom: 0.3125rem !important
    border-radius: 0.25rem
    padding-left: 0.9375rem
    overflow: hidden !important
    text-overflow: ellipsis !important
    white-space: nowrap !important

    &:focus-visible
      border: 0.0625rem solid colors-ui-surface-base-panel !important
      overflow: hidden !important
      text-overflow: ellipsis !important
      white-space: nowrap !important

  #repl-history
    flex: 1 1 auto
    min-height: 0
    overflow: auto

    .repl-input-history
      background-color: BACKGROUND_NEIGHBOUR_COLOR
      border-radius: 0.625rem
      margin: 0.3125rem
      padding-left: 0.3125rem

    .repl-output-history
      overflow-x: auto
      margin: 0.3125rem
      padding-left: 0.625rem
      padding-right: 0.625rem

      .repl-output-loading
        font-style: italic
        white-space: pre-wrap

      .repl-output-result
        color: blue
        white-space: pre-wrap

      .repl-output-move
        font-style:italic
        color: grey
        white-space: pre-wrap

      .repl-output-error
        font-weight: bold
        font-style: italic
        color: red
        white-space: pre-wrap

#replComponent
  height: inherit
  overflow: auto
