// Auto-hide panes: edge strips, strip tabs, overlay, and backdrop.
// Styling follows Visual Studio's auto-hide behavior: overlays are flush
// with window edges, no border-radius, and side strip tabs use vertical text.
//
// Layout: side strips tile WITH the GL container in a flex row, so the GL
// area shrinks to accommodate them (no overlay on top of content).
// Bottom auto-hide tabs render inside #status-base (the 2rem-tall status bar),
// sharing the bar with the collapsed-icon zone, the language/encoding readout
// and the location path — see Auto-Hide-Panes.md §3.1.

// ---------------------------------------------------------------------------
// Layout row — flex container that holds left strip, GL (#ROOT), right strip.
// ---------------------------------------------------------------------------

// Hovered (overlay) panels slide in — see `#auto-hide-overlay`.  0.1s, ease-in.
OVERLAY_SLIDE_DURATION = 0.1s
OVERLAY_SLIDE_EASING = cubic-bezier(0.42, 0, 1, 1)

@keyframes ct-overlay-slide-left
  from
    transform: translateX(calc(-100% - 2rem))
  to
    transform: none

@keyframes ct-overlay-slide-right
  from
    transform: translateX(calc(100% + 2rem))
  to
    transform: none

@keyframes ct-overlay-slide-bottom
  from
    transform: translateY(calc(100% + 2rem))
  to
    transform: none

@keyframes ct-overlay-slide-left-out
  from
    transform: none
  to
    transform: translateX(calc(-100% - 2rem))

@keyframes ct-overlay-slide-right-out
  from
    transform: none
  to
    transform: translateX(calc(100% + 2rem))

@keyframes ct-overlay-slide-bottom-out
  from
    transform: none
  to
    transform: translateY(calc(100% + 2rem))

// Hovered (overlay) panels' elevation — see `#auto-hide-overlay`.
OVERLAY_ELEVATION_SHADOW = 0 0.75rem 2rem rgba(0, 0, 0, 0.55), 0 0.125rem 0.5rem rgba(0, 0, 0, 0.45)

#auto-hide-layout-row
  display: flex
  flex-direction: row
  flex: 1
  min-height: 0
  width: 100%

// ---------------------------------------------------------------------------
// Side edge strips — flex items that sit beside #ROOT.
// Width is 0 when empty (no tabs), 2em when populated.
// overflow: visible is required so active-tab curves bleed outside the strip.
// ---------------------------------------------------------------------------

#auto-hide-strip-left,
#auto-hide-strip-right
  display: flex
  flex-direction: column
  align-items: stretch
  background-color: colors-ui-surface-base-canvas
  flex-shrink: 0
  flex-grow: 0
  flex-basis: 0
  width: 0
  max-width: 0
  overflow: visible
  // box-sizing: border-box so that padding is included in the 2em width,
  // keeping the strip's outer edge at exactly 2em from the window edge.
  // This mirrors how lm_header sets the tab HEIGHT via the container:
  // the tab width is determined entirely by the container (strip padding),
  // not by the tab's own margins — so no tab property change can shift content.
  box-sizing: border-box
  transition: width 150ms ease, max-width 150ms ease, padding 150ms ease
  // Strips must sit ABOVE the overlay (z-index 99) so that the active-tab
  // curves (pseudo-elements) are visible against the overlay background.
  position: relative
  z-index: 100

  // Expand to 2em when the strip has tabs (class toggled by auto_hide.nim).
  // padding-left/right create the 0.25em breathing room on each side —
  // the tab fills the content area (1.5em) via align-items: stretch.
  &.has-tabs
    width: 2em
    min-width: 2em
    max-width: 2em
    flex-basis: 2em
    padding-left: 0.25em
    padding-right: 0.25em
    // The first tab starts where a panel's tab does, 4px below the layout's
    // top (LAYOUT_TAB_TOP, golden_layout.styl), not flush with it — flush, the
    // strip tabs stood 4px above the panels beside them (Nikolay, 2026-10-11).
    padding-top: LAYOUT_TAB_TOP

// When the left strip is visible, nullify #ROOT's padding-left so the visual
// gap on both sides of the strip tabs is a consistent 0.25em:
//   left:  strip padding-left  (0.25em) from viewport edge to tab left edge
//   right: strip padding-right (0.25em) from tab right edge to GL content
// Without this, ROOT's own padding-left adds a second 0.25em on the right.
#auto-hide-strip-left.has-tabs ~ #ROOT
  padding-left: 0

// Mirror for the right strip: #ROOT appears before #auto-hide-strip-right in
// the flex row so ~ cannot be used.  Use :has() (Chromium 105+ / current
// Electron) to select #ROOT when its sibling right strip has tabs, removing
// ROOT's own padding-right to avoid a double gap between GL and the strip.
#auto-hide-layout-row:has(#auto-hide-strip-right.has-tabs) #ROOT
  padding-right: 0

// ---------------------------------------------------------------------------
// Docked sidebars — shown on click, pushes GL content sideways.
// Hidden by default; `.docked-open` class shows them with a default width.
// A drag handle on the inner edge lets the user resize.
// ---------------------------------------------------------------------------

#auto-hide-docked-left,
#auto-hide-docked-right
  display: none
  flex-direction: column
  flex-shrink: 0
  flex-grow: 0
  // The panel surface, the same token `.lm_content` paints a GoldenLayout
  // panel with — a docked panel is the same surface, just parked at an edge.
  // Transparent here let the window background show through instead, so a
  // docked panel came up darker than every other panel; the bottom docked
  // container below always had this and the side ones did not.
  background-color: colors-ui-surface-base-panel
  border-radius: TAB_CORNER_RADIUS
  // Its top on the same line as the panels' tabs and the strip tabs
  // (LAYOUT_TAB_TOP, golden_layout.styl), so an opened side panel does not
  // stand 4px above the panels beside it.
  margin-top: LAYOUT_TAB_TOP
  position: relative
  // z-index: 5 creates a stacking context so GL children with high z-index
  // are confined within it — the backdrop (z-index: 98, transparent) is below
  // both the docked panels and the overlay and serves only as a click-to-dismiss
  // target.
  z-index: 5
  min-width: 150px
  max-width: 800px
  overflow: hidden

  &.docked-open
    display: flex
    width: 360px  // default; overridden by JS resize
    // Raise above the side strip (z-index: 100) so the docked GL content covers
    // the active-tab box-shadow that extends horizontally into this area.
    // Matches the hover overlay z-index (101) for identical visual behaviour.
    z-index: 101

// No border on docked panels — the resize handle acts as the divider,
// matching GL's .lm_splitter which is a solid-background 4px wide element.

// ---------------------------------------------------------------------------
// Selected docked panel
//
// A docked panel is a panel like any other, so it carries the same selection
// cue: one 1px line, on the same tokens as the GoldenLayout outline
// (`SELECTED_PANEL_BORDER` / `_COLOR` in golden_layout.styl, imported ahead of
// this file).  It needs no SVG — a docked panel is a plain rounded rectangle,
// with none of the tab and connector geometry the GL path exists to trace, so
// an inset shadow follows the shape exactly and costs nothing to keep in step
// on resize.
//
// Inset rather than a border: the container's width is what the resize drag
// writes to, and a border would add to it and shift the panel by a pixel on
// every dock.  The class is set in `ui/auto_hide.nim` (on open) and
// `ui/layout.nim` (on click), and only ever on one panel at a time.
// ---------------------------------------------------------------------------
// The outline itself is one stroked SVG path built in `ui/layout.nim`
// (`setupSelectedPanelOutline`), exactly as it is for a GoldenLayout stack: the
// strip tab and the docked panel are traced as a single shape so the line runs
// around the tab rather than stopping at the panel's edge.  An inset shadow
// cannot do that — it can only follow the one box it is set on.
.ct-docked-outline
  position: fixed
  top: 0
  left: 0
  pointer-events: none
  // Above the docked panel (101) and the side strip (100), so the line is not
  // painted over by either of the two elements it runs around.
  z-index: 202
  overflow: visible

// ---------------------------------------------------------------------------
// The same outline again, for the slide-in overlay.
//
// Reported as: *"the borders of the active tab in the auto hidden panels
// positioned in the status bar ... display properly when I dock a panel, but
// not when it's focused in auto-hide mode."*  Docked, the line is
// `.ct-docked-outline` at 202 over a panel at 101.  In auto-hide the overlay
// sits at 203 — above that outline, deliberately (see the note on
// `#auto-hide-overlay`) — and carries `border: none`, so nothing was drawn.
//
// The fix is not to lower the overlay.  That z-index is load-bearing: a docked
// panel and the overlay are both 101, so no value sits between the panel and
// the outline that traces it, and the overlay has to clear both.  What the
// overlay lacked was an outline of its OWN, which belongs above it rather than
// under it — this is the line around the overlay, not around something the
// overlay covers.  Hence 204: one above the overlay it traces, and the only
// element in this file that sits higher.
//
// It is stroked from the same rule as the other two (`golden_layout.styl`), so
// all three carry one colour and one weight from one pair of tokens.
.ct-overlay-outline
  position: fixed
  top: 0
  left: 0
  pointer-events: none
  z-index: 204
  overflow: visible
  // Created each time the overlay opens, while the panel is still sliding in
  // (OVERLAY_SLIDE_DURATION).  It is measured from the panel's on-screen box,
  // so it stays transparent through the slide, is re-measured when the slide
  // ends (layout.nim, `animationend`), and then fades in.
  animation: ct-overlay-outline-in OVERLAY_SLIDE_DURATION + 0.1s linear both

  @media (prefers-reduced-motion: reduce)
    animation: none

// The outline is measured where the panel stood, so it cannot follow one
// sliding out: it goes the moment the panel starts to close.  `visibility`, not
// `opacity`, which the fade-in animation above would override.
body:has(#auto-hide-overlay.closing) .ct-overlay-outline
  visibility: hidden

@keyframes ct-overlay-outline-in
  0%, 83%
    opacity: 0
  100%
    opacity: 1

#auto-hide-docked-left-content,
#auto-hide-docked-right-content
  flex: 1
  overflow: auto
  min-height: 0
  position: relative

// Push content away from the resize handle so it isn't obscured by the 4px grip.
#auto-hide-docked-left-content
  padding-right: 4px

#auto-hide-docked-right-content
  padding-left: 4px

// Resize grip on the inner edge of each docked panel.
// Matches GL's .lm_splitter exactly: solid 4px background, hover highlight,
// drag highlight — no border, no gradient, same cursor and transition.
//
// Including the bug: the hover highlight here, on the overlay handle below and
// on `.lm_splitter` itself all named `colors-ui-border-interactive-default`,
// which is not a token. All three declarations were dropped, so a grip stayed
// at its resting #1b1b1b under the pointer and nothing said it could be
// dragged. `colors-ui-border-action` (#6366f1) is the interactive border
// token: 3.86:1 against the #1b1b1b the handle rests at and 3.30:1 against the
// #282828 beside it, both clear of the 3:1 WCAG 1.4.11 asks of a UI graphic.
.auto-hide-docked-resize-handle
  position: absolute
  top: 0
  bottom: 0
  width: 4px
  cursor: col-resize
  z-index: 10
  flex-shrink: 0
  background: colors-ui-surface-primary-default
  opacity: unset
  transition: background 150ms ease

  &:hover,
  &.resizing
    background: colors-ui-border-action

// Left docked panel: grip is on its RIGHT edge
#auto-hide-docked-left .auto-hide-docked-resize-handle
  right: 0
  left: auto

// Right docked panel: grip is on its LEFT edge
#auto-hide-docked-right .auto-hide-docked-resize-handle
  left: 0
  right: auto

// ---------------------------------------------------------------------------
// Collapsed mode — a thin accent line when maximized on a bounded screen edge.
//
// 6px wide, in the panels' own surface colour (`surface/base/panel`), brand/600
// (#4F46E5) under the pointer.  It spans what a panel spans — from the panels'
// top line (LAYOUT_TAB_TOP below the layout's top, where their tabs start) to
// the layout's bottom — and rounds 6px on its inner side only, the side facing
// the panels; the outer side runs along the window edge (Nikolay, 2026-10-15;
// it was a 3px #3a5070 strip the full height).  The strip itself takes the window background; the
// colour is painted by `.collapsed-strip-line` below.
// ---------------------------------------------------------------------------
COLLAPSED_STRIP_WIDTH = 0.375rem
COLLAPSED_STRIP_RADIUS = 0.375rem

#auto-hide-strip-left.collapsed-mode,
#auto-hide-strip-right.collapsed-mode
  width: COLLAPSED_STRIP_WIDTH
  min-width: COLLAPSED_STRIP_WIDTH
  max-width: COLLAPSED_STRIP_WIDTH
  flex-basis: COLLAPSED_STRIP_WIDTH
  padding-top: 0
  padding-left: 0
  padding-right: 0
  background-color: colors-ui-surface-base-canvas
  cursor: pointer
  overflow: hidden
  align-items: center

#auto-hide-strip-left.collapsed-mode
  border-right: none

// ---------------------------------------------------------------------------
// Revealed strip — a collapsed edge while one of its panels is open.
//
// The edge shows its ordinary tabs again, exactly as an expanded strip draws
// them, and the panel opens attached to its tab as on an expanded edge
// (`edgeRevealed`, auto_hide.nim).  It FLOATS: the strip keeps the thin line's
// layout footprint (COLLAPSED_STRIP_WIDTH), so the panels do not move, and the
// 2em column is painted past that footprint, over the layout — `::before` for
// the column's background, the tabs on top.  It slides in from the window edge
// with its panel and back out with it (OVERLAY_SLIDE_DURATION / _EASING), on
// the strip element itself: the tabs inside are rebuilt on every strip render,
// so an animation on them would replay at each hover.
// ---------------------------------------------------------------------------
#auto-hide-strip-left.revealed,
#auto-hide-strip-right.revealed
  width: COLLAPSED_STRIP_WIDTH
  min-width: COLLAPSED_STRIP_WIDTH
  max-width: COLLAPSED_STRIP_WIDTH
  flex-basis: COLLAPSED_STRIP_WIDTH
  padding-left: 0
  padding-right: 0
  padding-top: LAYOUT_TAB_TOP
  overflow: visible
  // Stacking as on an expanded strip (z-index 100, set above): over the
  // layout, under the overlay — which covers the active tab's bridge where
  // the two meet, the join an expanded edge already gets right.

  &::before
    content: ""
    position: absolute
    top: 0
    bottom: 0
    width: 2em
    background-color: colors-ui-surface-base-canvas
    z-index: -1

  .auto-hide-strip-tab
    width: 1.5em
    min-width: 1.5em
    flex-shrink: 0

#auto-hide-strip-left.revealed
  align-items: flex-start
  animation: ct-strip-reveal-left OVERLAY_SLIDE_DURATION OVERLAY_SLIDE_EASING

  &::before
    left: 0

  .auto-hide-strip-tab
    margin-left: 0.25em

  &.reveal-closing
    animation: ct-strip-reveal-left-out OVERLAY_SLIDE_DURATION OVERLAY_SLIDE_EASING forwards

#auto-hide-strip-right.revealed
  align-items: flex-end
  animation: ct-strip-reveal-right OVERLAY_SLIDE_DURATION OVERLAY_SLIDE_EASING

  &::before
    right: 0

  .auto-hide-strip-tab
    margin-right: 0.25em

  &.reveal-closing
    animation: ct-strip-reveal-right-out OVERLAY_SLIDE_DURATION OVERLAY_SLIDE_EASING forwards

@media (prefers-reduced-motion: reduce)
  #auto-hide-strip-left.revealed,
  #auto-hide-strip-right.revealed
    animation: none !important

@keyframes ct-strip-reveal-left
  from
    transform: translateX(-2em)
  to
    transform: none

@keyframes ct-strip-reveal-left-out
  from
    transform: none
  to
    transform: translateX(-2em)

@keyframes ct-strip-reveal-right
  from
    transform: translateX(2em)
  to
    transform: none

@keyframes ct-strip-reveal-right-out
  from
    transform: none
  to
    transform: translateX(2em)

// The layout keeps the gap it has beside the thin line: a revealed strip
// floats, it does not take the expanded strip's place in the row.
#auto-hide-strip-left.revealed ~ #ROOT
  padding-left: 0.25rem

#auto-hide-layout-row:has(#auto-hide-strip-right.revealed) #ROOT
  padding-right: 0.25rem

// In the panels' colour, the line has to stand apart from the panel beside it
// the way panels stand apart from each other: the layout's usual 4px edge gap,
// which the rules above take away whenever a strip has tabs (the expanded
// strip brings its own padding; the collapsed line has none).  Without it the
// 6px line ran straight into the panel and disappeared into it.
#auto-hide-strip-left.collapsed-mode ~ #ROOT
  padding-left: 0.25rem

#auto-hide-layout-row:has(#auto-hide-strip-right.collapsed-mode) #ROOT
  padding-right: 0.25rem

// A panel docked from a collapsed strip sits between the line and the layout,
// so it keeps the same 4px from the line.
#auto-hide-strip-left.collapsed-mode ~ #auto-hide-docked-left
  margin-left: 0.25rem

#auto-hide-layout-row:has(#auto-hide-strip-right.collapsed-mode) #auto-hide-docked-right
  margin-right: 0.25rem

#auto-hide-strip-right.collapsed-mode
  border-left: none

// The collapsed strip line is the clickable target inside the strip.  The
// element stays the strip's full height, so the whole edge still answers a
// click; the line you see is its `::before`, placed on the panels' top and
// bottom and rounded on the inner side — a plain box, nothing animated.
.collapsed-strip-line
  position: relative
  width: 100%
  height: 100%
  cursor: pointer

  &::before
    content: ""
    position: absolute
    top: LAYOUT_TAB_TOP
    bottom: 0
    left: 0
    right: 0
    background-color: colors-ui-surface-base-panel
    pointer-events: none

  &:hover::before
    background-color: colors-brand-600

// Inner side = the side facing the panels: right on the left strip, left on
// the right strip.
#auto-hide-strip-left .collapsed-strip-line::before
  border-radius: 0 COLLAPSED_STRIP_RADIUS COLLAPSED_STRIP_RADIUS 0

#auto-hide-strip-right .collapsed-strip-line::before
  border-radius: COLLAPSED_STRIP_RADIUS 0 0 COLLAPSED_STRIP_RADIUS

// ---------------------------------------------------------------------------
// Docked bottom panel — pushes GL up when a bottom strip tab is clicked.
// Sits between #auto-hide-layout-row and the footer in the flex column.
// ---------------------------------------------------------------------------

#auto-hide-docked-bottom
  display: none
  flex-direction: column
  flex-shrink: 0
  flex-grow: 0
  background-color: colors-ui-surface-base-panel
  border-radius: TAB_CORNER_RADIUS
  position: relative
  z-index: 5  // same as side docked panels — keeps panel children below backdrop (98)
  min-height: 100px
  max-height: 600px
  overflow: hidden
  // Inset left/right to match #ROOT's padding-left/right (0.25em) so the panel
  // content aligns with the GL content area rather than being edge-to-edge.
  // margin instead of width: 100% so the flex container controls the width.
  margin-left: 0.25em
  margin-right: 0.25em

  &.docked-open
    display: flex
    height: 280px  // default; overridden by JS resize
    // Raise above the tab strip (z-index: 100) so the docked GL content covers
    // the active-tab box-shadow and curves that extend upward into this area.
    // Without this, the shadow paints ON TOP of the GL content as a visible
    // artifact — especially when the panel has a scrollbar.
    // Matches the hover overlay z-index (101) for identical visual behaviour.
    z-index: 101

// The bottom dock's resize handle: a 4px #1b1b1b bar along the dock's top
// edge (`.auto-hide-docked-resize-handle-bottom` below).  It is drawn inside the
// dock, so the panel's visible top edge is this far below the dock's own.
DOCK_BOTTOM_HANDLE_SIZE = 4px

#auto-hide-docked-bottom-content
  flex: 1
  overflow: auto
  min-width: 0
  position: relative
  // The handle, then PANEL_INSET (8px, button.styl): a docked panel's first row
  // starts 8px below its VISIBLE top edge — the bottom of the handle — like
  // every panel in the layout (`.lm_content`, golden_layout.styl).  With the
  // handle counted inside the 8px, Find in Files' search field and the
  // Requests filters sat only 4px under it.
  padding-top: "calc(%s + %s)" % (DOCK_BOTTOM_HANDLE_SIZE PANEL_INSET)

// Bottom resize handle — horizontal bar on the TOP edge, drag up to expand.
// Inherits base styles from .auto-hide-docked-resize-handle; overrides for
// horizontal orientation.
.auto-hide-docked-resize-handle-bottom
  top: 0
  left: 0
  right: 0
  bottom: auto
  height: DOCK_BOTTOM_HANDLE_SIZE
  width: auto
  cursor: ns-resize

// ---------------------------------------------------------------------------
// Bottom auto-hide strip — one of #status-base's flex children, taking the
// slack between the left-hand readouts and the right-hand location path.
// The bar is 2rem tall with 0.25em padding-top/bottom (matching side-strip
// padding-left/right) for curve visibility and consistent breathing room.
// Tabs fill the inner 1.5em height via align-items: stretch.
// ---------------------------------------------------------------------------

#auto-hide-bottom-strip
  display: flex
  flex-direction: row
  align-items: stretch
  flex: 1          // fill the full width of #status-base
  overflow: visible
  position: relative
  z-index: 100
  // Left/right padding matches #ROOT's padding-left/right (0.25em) so the tabs
  // are inset by the same amount as the GL content area on both sides.
  padding-left: 0.25em
  padding-right: 0.25em

// CENTRED in the status bar (Nikolay, 2026-10-16): the pinned-tab row sits in
// the middle of the window, not after the left-hand readouts; the tabs keep
// their sizes and spacing.  Taken out of the bar's flex flow and centred
// across its full width — `left`/`right: 0` with auto margins and a
// fit-content width, no transform, so nothing that measures the tabs (the
// docked-panel outline, the active tab's curves) sees a transformed box.  The
// readouts either side keep their places (`.status-right` is pushed right in
// status_bar.styl, which used to be this strip's `flex: 1`).  The old 2em
// side-strip insets went with it: centred, the row is nowhere near the strips.
#auto-hide-bottom-strip
  position: absolute
  // Inset by the bar's own vertical padding: an absolute box is placed from
  // the bar's padding edge, so `0` made the tabs the full 32px bar height and
  // lost the 4px above and below them (Nikolay, 2026-10-16).
  top: STATUS_BAR_VERTICAL_PADDING      // status_bar.styl, imported earlier
  bottom: STATUS_BAR_VERTICAL_PADDING
  left: 0
  right: 0
  width: fit-content
  max-width: 50%
  margin: 0 auto
  flex: none

  // The tabs' trailing 0.24em gap would sit the row that much left of centre.
  .auto-hide-strip-tab:last-child
    margin-right: 0

// ---------------------------------------------------------------------------
// Bottom strip tab overrides — use the same .auto-hide-strip-tab classes
// as the side strips but re-orient for horizontal bottom layout.
// Open end faces UP (toward GL content / docked panel above).
// ---------------------------------------------------------------------------

#auto-hide-bottom-strip .auto-hide-strip-tab
  // Horizontal layout: tabs stack left-to-right.
  flex-direction: row
  align-items: center
  // Horizontal padding instead of vertical; match the 0.38em breathing room
  // on each side that the side strip uses as padding-left/right.
  padding: 0 0.5em
  margin-bottom: 0
  margin-right: 0.24em
  // Tab height is the full status-bar height — no explicit height needed
  // since the parent is align-items: stretch.
  // All corners TAB_CORNER_RADIUS (golden_layout.styl), like every other tab.
  border-radius: TAB_CORNER_RADIUS
  overflow: visible  // allow curve pseudo-elements to bleed outside the tab

  &.active
    color: colors-ui-text-primary-label
    border-radius: TAB_CORNER_RADIUS
    // Shadow bridges the gap between the strip top edge and the docked panel.
    box-shadow: 0em -0.48em 0em 0em colors-ui-surface-base-panel
    overflow: visible
    z-index: 1

    // LEFT curve — to the left of the active tab.
    &::before
      content: " "
      pointer-events: none
      position: absolute
      display: block
      height: 80%
      width: 1.625em
      top: 0em
      left: -1.625em
      z-index: 1
      border-radius: 0 0.625em 0 0
      opacity: 1
      box-shadow: 0.625em -0.34em 0 -0.25em colors-ui-surface-base-panel
      transform: translate(0em, -0.25625em)

    // RIGHT curve — to the right of the active tab.
    &::after
      content: " "
      pointer-events: none
      position: absolute
      display: block
      height: 80%
      width: 1.625em
      top: 0em
      right: -1.625em
      z-index: 1
      border-radius: 0.625em 0 0 0
      opacity: 1
      box-shadow: -0.625em -0.34em 0 -0.25em colors-ui-surface-base-panel
      transform: translate(0em, -0.25625em)

// Label: no writing-mode rotation for horizontal tabs.
// align-self: stretch + internal display: flex + align-items: center ensure
// the label fills the full tab height and the text is truly centered, rather
// than relying on the parent's align-items: center to center the line box
// (which shifts capital letters slightly high due to descender space in the
// line box not being used by all-caps text).
#auto-hide-bottom-strip .auto-hide-strip-tab-label
  writing-mode: horizontal-tb
  text-orientation: mixed
  transform: none
  padding-left: 0
  padding-right: 0
  max-height: none
  align-self: stretch  // fill full tab height instead of centering the line box
  display: flex        // flex container so text node becomes a flex item
  align-items: center  // vertically center the text within the stretched label
  line-height: 1       // collapse descender space so the line box ≈ cap height;
                       // without this, line-height ~1.2 leaves unused space below
                       // caps that shifts their visual center above the line box center

// Buttons sit inline (to the right of the label) instead of above it.
#auto-hide-bottom-strip .auto-hide-strip-tab-buttons
  flex-direction: row
  margin-bottom: 0
  margin-left: 0.2em
  gap: 0.2em

// ---------------------------------------------------------------------------
// Strip tabs — individual clickable tabs within a strip.
// Styled to match lm_tabs but rotated vertically for the side strips.
// The tab div itself is NOT rotated so that ::before/::after pseudo-elements
// work in the normal (unrotated) coordinate space — curves appear correctly
// above and below the active tab.  Rotation is delegated to the inner
// .auto-hide-strip-tab-label span only.
// ---------------------------------------------------------------------------

.auto-hide-strip-tab
  font-family: "SpaceGrotesk"
  font-size: inherit
  // font-weight: 600
  letter-spacing: -0.14px
  // AN IDLE TAB IS NOT A DISABLED ONE.
  //
  // This was `colors-ui-text-primary-disabled` (grey-400, `#727272`), which
  // on the tab's own `colors-ui-surface-base-panel` (grey-700, `#282828`)
  // measures **3.06:1** — under the 4.5:1 these labels need as normal text.
  // Measured on the live page, not inferred: BUILD / PROBLEMS / FIND IN FILES
  // / REQUESTS all computed `rgb(114, 114, 114)` on `rgb(40, 40, 40)`.
  //
  // The token was also saying something untrue. Every one of these tabs is
  // clickable and selects a panel; "disabled" is the one state they are never
  // in, and a disabled token is allowed to sit below the text threshold
  // precisely because it marks something you cannot use.
  //
  // `colors-ui-text-primary-label-subtle` (grey-300, `#919191`) is the same
  // token `#status-base` now sets for its own readouts, so an idle tab and
  // the readouts beside it read at one ambient level — 4.68:1 here. It is
  // chosen over the brighter `colors-ui-text-primary-caption` (grey-200,
  // 7.11:1) to keep the idle/active distinction wide: `.active` below is
  // `colors-ui-text-primary-label` (grey-150, 8.81:1), and the state cue is
  // the GAP between the two, which a brighter idle value would close.
  color: colors-ui-text-primary-label-subtle
  background-color: colors-ui-surface-base-panel
  border-radius: TAB_CORNER_RADIUS
  cursor: pointer
  // No horizontal padding — the tab is only 2em wide and removing horizontal
  // padding gives the rotated label enough block-size to render without clipping.
  // top/bottom 0.5em matches lm_tab left/right rotated; horizontal padding is
  // handled by the strip container's 0.38em padding on each side.
  padding: 0.5em 0
  // No horizontal margins — the 0.38em breathing room on each side comes from
  // the strip container's padding-left/right (set on .has-tabs).  This means
  // the tab width is set entirely by the container, exactly like lm_tab height
  // is set by the lm_header container — so no active-state property can shift content.
  margin-bottom: 0.24em
  display: flex
  flex-direction: column
  align-items: center
  justify-content: center
  position: relative
  z-index: 0
  overflow: hidden
  user-select: none
  transition: color 150ms ease, background-color 150ms ease

  // An idle tab — side strips and the status bar alike — brightens to the
  // active tab's #C8C8C8 (label tier = grey-150) under the pointer (Nikolay,
  // 2026-10-15).  Colour only, on the transition above.
  &:hover:not(.active)
    color: colors-ui-text-primary-label

  // Active state: open end faces the main content area (right side).
  // Curves appear above (::before) and below (::after) the tab, matching
  // the lm_tabs pattern rotated 90 degrees clockwise.
  &.active
    color: colors-ui-text-primary-label
    border-top-left-radius: TAB_CORNER_RADIUS
    border-bottom-left-radius: TAB_CORNER_RADIUS
    border-top-right-radius: 0em
    border-bottom-right-radius: 0em
    // Shadow bridges the 0.25em gap to the strip edge and extends slightly into
    // the overlay area. The overlay (z-index: 101) renders above the strip (100)
    // and covers the overlap with its own panel-color background — seamless join,
    // no GL content exposed since the overlay covers ROOT at that position.
    box-shadow: 0.48em 0em 0em 0em colors-ui-surface-base-panel
    overflow: visible
    z-index: 1

    // TOP curve — above the active tab (same geometry as lm_tabs ::before rotated).
    &::before
      content: " "
      pointer-events: none
      position: absolute
      display: block
      width: 80%
      height: 1.625em
      right: 0em
      top: -1.625em
      z-index: 1
      border-radius: 0 0 0.625em 0
      opacity: 1
      box-shadow: 0.34em 0.625em 0 -0.25em colors-ui-surface-base-panel
      transform: translate(0.25625em, 0em)

    // BOTTOM curve — below the active tab (same geometry as lm_tabs ::after rotated).
    &::after
      content: " "
      pointer-events: none
      position: absolute
      display: block
      width: 80%
      height: 1.625em
      right: 0em
      bottom: -1.625em
      z-index: 1
      border-radius: 0 0.625em 0 0
      opacity: 1
      box-shadow: 0.34em -0.625em 0 -0.25em colors-ui-surface-base-panel
      transform: translate(0.25625em, 0em)

// -------------------------------------------------------------------------
// Right-strip overrides: curves mirror to the LEFT side of the tab.
// The open end of the right-strip active tab faces LEFT (toward the overlay).
// -------------------------------------------------------------------------

#auto-hide-strip-right .auto-hide-strip-tab.active
  border-top-left-radius: 0em
  border-bottom-left-radius: 0em
  border-top-right-radius: TAB_CORNER_RADIUS
  border-bottom-right-radius: TAB_CORNER_RADIUS
  // Shadow bridges the 0.25em gap to the strip left edge; overlay (z-index: 101)
  // renders above and covers the slight overlap with its panel-color background.
  box-shadow: -0.48em 0em 0em 0em colors-ui-surface-base-panel

  &::before  // TOP curve — anchored to LEFT side of tab
    left: 0em
    right: auto
    border-radius: 0 0 0 0.625em  // BL rounded
    box-shadow: -0.34em 0.625em 0 -0.25em colors-ui-surface-base-panel
    transform: translate(-0.25625em, 0em)

  &::after  // BOTTOM curve — anchored to LEFT side of tab
    left: 0em
    right: auto
    border-radius: 0.625em 0 0 0  // TL rounded
    box-shadow: -0.34em -0.625em 0 -0.25em colors-ui-surface-base-panel
    transform: translate(-0.25625em, 0em)

// First active tab has no top curve (nothing above it to connect to).
#auto-hide-strip-left .auto-hide-strip-tab.active:first-child::before,
#auto-hide-strip-right .auto-hide-strip-tab.active:first-child::before
  display: none

// ...and with no curve above it, the tab's top edge runs straight on into the
// panel's: they share one top line (LAYOUT_TAB_TOP).  The panel's corner on the
// tab side is then inside that one shape, and rounding it cut a notch where the
// two meet (Nikolay, 2026-10-15) — so square it, as the bottom strip squares
// its first tab's corner below.  Docked and hovered panels both; the body is
// listed with the overlay because it paints the overlay's fill and clips it.
// The outline SVGs read these radii back out of computed style.
body:has(#auto-hide-strip-left .auto-hide-strip-tab.active:first-child)
  #auto-hide-docked-left,
  #auto-hide-overlay.auto-hide-overlay-left,
  #auto-hide-overlay.auto-hide-overlay-left #auto-hide-overlay-body
    border-top-left-radius: 0

body:has(#auto-hide-strip-right .auto-hide-strip-tab.active:first-child)
  #auto-hide-docked-right,
  #auto-hide-overlay.auto-hide-overlay-right,
  #auto-hide-overlay.auto-hide-overlay-right #auto-hide-overlay-body
    border-top-right-radius: 0

// Bottom strip: the first tab is NOT special.  It used to drop its left curve,
// square its top-left corner and square the panel's bottom-left, on the premise
// that it sits flush with the panel's left edge.  It no longer does — the
// status readouts (language, encoding) come first, so BUILD sits far in — and
// those rules made it the one footer tab that joined its panel differently
// (Nikolay, 2026-10-15: consistency).  It now joins like every other tab.

// The first tab's bottom-left corner is the same as every other tab corner.
// It used to be a wider 0.5rem (8px) as the strip's "end" corner, which read
// as a mismatched corner on one tab (Nikolay, 2026-10-15: consistency).

// ---------------------------------------------------------------------------
// Tab label span — carries the text rotation so the tab div stays un-rotated.
// ---------------------------------------------------------------------------

.auto-hide-strip-tab-label
  display: block
  // No explicit width — the label takes its natural intrinsic width
  // (≈ font-size for vertical text) and align-items: center on the parent
  // tab centers it horizontally, matching how lm_tab centers content.
  // padding-left/right add 0.38em breathing room between the tab edge and
  // the text characters; they expand the label's natural width symmetrically.
  padding-left: 0.38em
  padding-right: 0.38em
  white-space: nowrap

// Left strip: text reads top-to-bottom.
#auto-hide-strip-left .auto-hide-strip-tab-label
  writing-mode: vertical-rl
  text-orientation: mixed
  transform: none

// Right strip: text reads bottom-to-top (mirrored from left).
#auto-hide-strip-right .auto-hide-strip-tab-label
  writing-mode: vertical-rl
  text-orientation: mixed
  transform: rotate(180deg)

// ---------------------------------------------------------------------------
// Tab button group — close and unpin, always visible at the top of each tab.
// Both buttons use stopPropagation so clicking on an inactive tab doesn't
// also activate the panel.
// ---------------------------------------------------------------------------

.auto-hide-strip-tab-buttons
  display: flex
  flex-direction: column
  align-items: center
  gap: 0.3em  // matches lm_pin_tab margin-right spacing between lm_tab buttons
  margin-bottom: 0.5em  // space between unpin button and text label below

// Shared base — icon-only buttons, same appearance as lm_tab buttons.
.auto-hide-strip-tab-btn
  display: block
  background-repeat: no-repeat
  background-position: center
  cursor: pointer
  border: none
  padding: 0
  background-color: transparent
  user-select: none
  border-radius: 0.375em
  transition: background-color 150ms ease

  // Hover matches .lm_controls > *:hover — subtle filled rounded rect.
  &:hover
    background-color: colors-ui-surface-primary-default-hover

// Close button — same icon and size as .lm_close_tab.
.auto-hide-strip-tab-close
  background-image: LAYOUT_TAB_CLOSE_ICON_PATH
  background-size: 0.6em 0.6em
  width: 0.6em
  height: 0.6em

// Unpin button — matches .lm_header .lm_tab .lm_pin_tab exactly:
// dimmed at 0.7 opacity by default, fully opaque on hover, no background fill.
.auto-hide-strip-tab-unpin
  background-image: url('../../public/resources/shared/sidebar_unpin.svg')
  background-size: 0.85em 0.85em
  width: 0.85em
  height: 0.85em
  opacity: 0.7

  &:hover
    opacity: 1
    background-color: transparent  // override .auto-hide-strip-tab-btn:hover

// The × on the active side tab (Nikolay, 2026-10-16): the same `close_sm`
// icon, 16px size and resting/hover colours as the × on the selected row of
// the status bar's tab-list menu (`.auto-hide-tablist-close` below), and the
// same job — hide the panel that is showing, keep the tab.  It sits where the
// label's text ends: below it on the left strip (read top-to-bottom), above it
// on the right (read bottom-to-top), 4px from the label.
.auto-hide-strip-tab-hide
  display: block
  flex: 0 0 1rem
  width: 1rem
  height: 1rem
  margin-top: 0.25rem
  cursor: pointer
  tab-icon(url('../../public/resources/shared/close_sm.svg'), 1rem 1rem)

#auto-hide-strip-right .auto-hide-strip-tab-hide
  order: -1
  margin-top: 0
  margin-bottom: 0.25rem

// (The `.auto-hide-bottom-tabs .ct-button-sm-secondary` overrides that used
// to live here were removed with the renderer that emitted them.  The status
// bar's bottom tabs are `#auto-hide-bottom-strip .auto-hide-strip-tab`
// elements — styled above — since commit b27da3947 redesigned the bar; the
// wrapper class and its `ct-button-sm-secondary` tabs had no live producer.)

// ---------------------------------------------------------------------------
// Backdrop — invisible click-to-dismiss layer behind the slide-in panel.
// No background color: the overlay appears without dimming any content.
// z-index: 98 — below the strips (100) so the backdrop never intercepts
// mouseenter/mouseleave on strip tabs (prevents hover-preview flicker).
// ---------------------------------------------------------------------------

#auto-hide-backdrop
  display: none
  position: fixed
  top: 0
  left: 0
  right: 0
  bottom: 0
  background-color: transparent
  z-index: 98

#auto-hide-overlay.visible ~ #auto-hide-backdrop
  display: block

// ---------------------------------------------------------------------------
// Overlay — the slide-in panel that appears when a strip tab is clicked.
// ---------------------------------------------------------------------------

#auto-hide-overlay
  position: fixed
  // Above the backdrop (98), the strips (100), a docked panel (101) and the
  // outline that traces one (202).
  //
  // It has to clear the outline, not just the panel: that outline must paint
  // above the docked panel or the panel's own background hides it, and a docked
  // panel and this overlay are both 101 — so no value sits between them.  The
  // overlay is the transient thing floating over the layout, so it goes on top
  // and the outline is occluded where the two meet, rather than the outline
  // being drawn across a hovered panel's content.
  z-index: 203
  background-color: colors-ui-surface-primary-default
  border: none
  border-radius: TAB_CORNER_RADIUS
  box-shadow: none
  margin: 0
  padding: 0
  display: none
  flex-direction: column
  // No overflow:hidden here — the resize handle must keep right-angle corners.
  // Rounding is applied to #auto-hide-overlay-body instead, which clips only
  // the panel content and leaves the handle unaffected.
  transition: transform 200ms ease

  &.visible
    display: flex

  // SLIDE IN.  An opening overlay slides in from its own edge — left panels
  // from the left, right from the right, bottom panels up — fast, 0.1s, easing
  // in (Nikolay, 2026-10-15; first tried at 0.5s).  It starts fully off the window (its own size
  // plus the 2rem strip), so it enters from the edge rather than appearing
  // part-way in.  `transform` only: the browser moves the already-painted
  // panel on the graphics chip, with no layout or repaint per frame.  Not for
  // anyone who has asked the system to reduce motion.
  &.visible.auto-hide-overlay-left
    animation: ct-overlay-slide-left OVERLAY_SLIDE_DURATION OVERLAY_SLIDE_EASING

  &.visible.auto-hide-overlay-right
    animation: ct-overlay-slide-right OVERLAY_SLIDE_DURATION OVERLAY_SLIDE_EASING

  &.visible.auto-hide-overlay-bottom
    animation: ct-overlay-slide-bottom OVERLAY_SLIDE_DURATION OVERLAY_SLIDE_EASING

  // SLIDE OUT — the same movement in reverse when the panel closes: back to
  // its own edge, same duration and easing (Nikolay, 2026-10-15).
  // `hideOverlay` (auto_hide.nim) adds `closing` and tears the panel down when
  // the slide is over; `forwards` holds it off-screen for that last frame.
  // A closing panel is on its way out: clicks pass through it to whatever it
  // is sliding across — the collapsed line or a tab it covers on its way —
  // instead of landing on a panel that is already closed.
  &.closing
    pointer-events: none

  &.visible.closing.auto-hide-overlay-left
    animation: ct-overlay-slide-left-out OVERLAY_SLIDE_DURATION OVERLAY_SLIDE_EASING forwards

  &.visible.closing.auto-hide-overlay-right
    animation: ct-overlay-slide-right-out OVERLAY_SLIDE_DURATION OVERLAY_SLIDE_EASING forwards

  &.visible.closing.auto-hide-overlay-bottom
    animation: ct-overlay-slide-bottom-out OVERLAY_SLIDE_DURATION OVERLAY_SLIDE_EASING forwards

  @media (prefers-reduced-motion: reduce)
    &.visible
      animation: none !important

  // ELEVATION.  A hovered panel floats over the layout, so it casts a soft,
  // blurred shadow on the layout around it (Nikolay, 2026-10-15) — on every
  // side but the one against its strip, where it continues into its tab and a
  // shadow there would cut the panel off from the tab.  `clip-path` trims that
  // one side exactly (per edge, below); the 3rem on the others is room for the
  // blur.  Two layers: a wide, faint one for depth and a tight one that keeps
  // the edge defined on the dark canvas.
  //
  // Cost: one static shadow on one element, painted when the panel opens and
  // never animated (the overlay transitions only `transform`).  No `filter`,
  // no `backdrop-filter`, nothing redrawn on scroll or per frame.
  box-shadow: OVERLAY_ELEVATION_SHADOW

// Edge-specific positioning: each overlay is flush with its edge and
// spans the full available dimension along that edge.

// Left overlay: flush with the strip's right edge (2em from screen left).
// `top` sits LAYOUT_TAB_TOP (4px, golden_layout.styl) below the caption bar —
// where the strip tabs and the docked panels start — so a hovered panel and the
// tab it opens from share one top edge.  Flush with the caption bar, the panel
// stood 4px above a top tab, and the step read as a broken corner (Nikolay,
// 2026-10-15).
#auto-hide-overlay.auto-hide-overlay-left
  top: "calc(%s + %s)" % (CAPTION_BAR_HEIGHT LAYOUT_TAB_TOP)
  left: 2em
  bottom: 2rem  // stop above the bottom tab strip (2rem)
  width: 360px
  clip-path: inset(-3rem -3rem -3rem 0)  // no shadow on the strip side

// Right overlay: mirrored.
#auto-hide-overlay.auto-hide-overlay-right
  top: "calc(%s + %s)" % (CAPTION_BAR_HEIGHT LAYOUT_TAB_TOP)
  right: 2em
  bottom: 2rem
  width: 360px
  clip-path: inset(-3rem 0 -3rem -3rem)  // no shadow on the strip side

// Bottom overlay: sits above the tab strip, inset to match #ROOT left/right padding.
#auto-hide-overlay.auto-hide-overlay-bottom
  left: 0.25em
  right: 0.25em
  bottom: 2rem
  height: 280px
  clip-path: inset(-3rem -3rem 0 -3rem)  // no shadow on the strip side

// ---------------------------------------------------------------------------
// Overlay resize handle — sits on the inner edge of the overlay (the edge
// closest to the GL content).  Drag to resize; size is stored per-panel.
// Styled identically to the docked-panel resize handles.
// ---------------------------------------------------------------------------

.auto-hide-overlay-resize-handle
  position: absolute
  z-index: 200  // above overlay GL content
  background: colors-ui-surface-primary-default
  opacity: unset
  transition: background 150ms ease

  &:hover,
  &.resizing
    background: colors-ui-border-action

// Left overlay: drag the RIGHT edge to widen.
.auto-hide-overlay-left .auto-hide-overlay-resize-handle
  right: 0
  top: 0
  bottom: 0
  width: 4px
  cursor: col-resize

// Right overlay: drag the LEFT edge to widen.
.auto-hide-overlay-right .auto-hide-overlay-resize-handle
  left: 0
  top: 0
  bottom: 0
  width: 4px
  cursor: col-resize

// Bottom overlay: drag the TOP edge upward to increase height.
.auto-hide-overlay-bottom .auto-hide-overlay-resize-handle
  top: 0
  left: 0
  right: 0
  height: 4px
  cursor: ns-resize

// The body carries the panel background and clips content to rounded corners.
// The resize handle is outside the body (absolute in the outer overlay) so it
// keeps right-angle corners and is not affected by this overflow:hidden.
//
// `box-shadow: none`, and the sentence that used to be here said the opposite —
// that a shadow "provides a subtle 1px outline that makes the rounded edges
// visible".  It had not for some time; the declaration was turned off and the
// prose describing it was not.  Anyone reading this block while chasing the
// missing auto-hide border would have been told there was already an outline
// here.  There is not: the line around this panel is `.ct-overlay-outline`, a
// stroked path above the overlay, for the reasons given on that rule.
//
// This element is nonetheless what the outline is MEASURED from — it is the
// box the user reads as the panel (the resize handle sits outside it, past the
// margin below) and the box that is actually rounded, since the outer overlay
// deliberately has no overflow:hidden.
#auto-hide-overlay-body
  background-color: colors-ui-surface-base-panel
  border-radius: TAB_CORNER_RADIUS
  overflow: hidden
  box-shadow: none

// Use margin (not padding) to separate the body from the resize handle.
// margin shrinks the body element itself, placing the handle visually OUTSIDE
// the rounded body — it becomes a straight divider between panel and GL content,
// not clipped or wrapped by the body's border-radius / box-shadow.
.auto-hide-overlay-right #auto-hide-overlay-body
  margin-left: 4px

.auto-hide-overlay-left #auto-hide-overlay-body
  margin-right: 4px

.auto-hide-overlay-bottom #auto-hide-overlay-body
  margin-top: 4px

// ---------------------------------------------------------------------------
// Overlay header — hidden: the active strip tab acts as the panel header.
// The close and unpin buttons are embedded in the strip tab itself.
// ---------------------------------------------------------------------------

#auto-hide-overlay-header
  display: none !important

// ---------------------------------------------------------------------------
// Overlay content area
// ---------------------------------------------------------------------------

#auto-hide-overlay-content
  flex: 1
  overflow: auto
  // PANEL_INSET (8px, button.styl) above the panel's first row — the same gap
  // the panel gets docked (`#auto-hide-docked-bottom-content`) or in the layout
  // (`.lm_content`).  The panels carry no top padding of their own, so without
  // this a panel previewed on hover had its first row against the body's top
  // edge.  The resize handle is outside the body (see the margins above), so
  // unlike the dock there is nothing to add for it.
  padding: PANEL_INSET 0 0
  position: relative  // Anchor for the floating pin button

// ---------------------------------------------------------------------------
// Restored panels (issue #691)
// ---------------------------------------------------------------------------

// The host `auto_hide.nim`'s `instantiatePanelElement` builds for a panel
// restored from `auto_hide_state.json`.  It plays the part a GoldenLayout
// container plays for a pinned panel: a full-size box the pane's
// `.component-container` mounts inside.
.auto-hide-restored-container
  width: 100%
  height: 100%
  overflow: hidden

// Shown IN PLACE OF the panel when even the stored config cannot be rebuilt.
// It exists because the alternative is a blank rectangle: both reveal paths
// used to answer a missing panel with a `console.warn` the user never sees.
.auto-hide-panel-unavailable
  padding: PANEL_INSET
  font-size: 12px
  line-height: 1.5
  color: PRIMARY_TEXT_COLOR
  white-space: normal

// ---------------------------------------------------------------------------
// Collapsed-mode overlay: hide the full header row and show a small
// floating pin/unpin button in the upper-right corner instead.
// The panel title is already visible in the side-edge tab bar.
// ---------------------------------------------------------------------------

#auto-hide-overlay.collapsed-overlay #auto-hide-overlay-header
  display: none

// Floating pin button — appears only in collapsed-overlay mode.
.overlay-floating-pin
  position: absolute
  top: 4px
  right: 4px
  z-index: 5
  cursor: pointer
  font-size: 14px
  width: 24px
  height: 24px
  display: flex
  align-items: center
  justify-content: center
  border-radius: 3px
  color: colors-ui-text-primary-label
  background-color: rgba(40, 40, 40, 0.7)
  border: 1px solid colors-ui-surface-primary-tertiary
  transition: background-color 150ms ease
  opacity: 0.6

  &:hover
    background-color: colors-ui-surface-primary-secondary-hover
    opacity: 1.0

  // The crossed-out pin — the same file and 12px size as
  // `.auto-hide-strip-tab-unpin` above, so "unpin" has one icon everywhere.
  // It replaces a ✕ glyph that read as "close" (see ui/auto_hide.nim).
  &::before
    content: ''
    display: block
    width: 0.75rem
    height: 0.75rem
    background-image: url('../../public/resources/shared/sidebar_unpin.svg')
    background-size: contain
    background-repeat: no-repeat
    background-position: center

// ---------------------------------------------------------------------------
// Collapsed-mode icon zone — rendered in the status bar.
// Uses the same accent color as the collapsed strip line.
// ---------------------------------------------------------------------------

.collapsed-icon-zone
  display: none

// The icon zone sits at the very left of the status bar, flush with the
// left edge so it visually connects with the collapsed side strip above.
// No margin-left, no border-radius on the left side.
.collapsed-icon-zone.has-icons
  display: flex
  flex-direction: row
  align-items: center
  gap: 2px
  margin: 0
  padding: 0 6px
  // No fill: the group sits on the status bar's own background (Nikolay,
  // 2026-10-15; it was a #3a5070 chip).
  height: 100%  // Full status bar height for seamless connection
  align-self: stretch

.collapsed-icon
  font-size: 14px
  // The glyph needs its own colour, because the chip it sits on has its own
  // background. `.collapsed-icon-zone.has-icons` paints `#3a5070`; the button
  // declared no `color`, so it inherited — black before `#status-base`
  // declared one (**2.56:1** on that blue), and grey-300 after, which is
  // **2.60:1** and still under the 3:1 floor for a non-text control. The bar
  // fix does not reach this one: inheriting a colour chosen for `#1b1b1b`
  // onto a `#3a5070` chip is how it stayed dark either way.
  //
  // `colors-ui-icon-primary-default` (grey-100, `#dddddd`) is the design
  // system's own default icon colour and gives 6.04:1 here, and 4.72:1
  // against the `#4a6080` this lightens to on hover — so both resting and
  // hover states clear the threshold, which is why the hover background did
  // not have to move. Hover is the tighter of the two and the only reason
  // this rule is not simply grey-150: `#c8c8c8` would land at 3.83:1 once
  // the chip lightens, i.e. legible at rest and not while being pointed at,
  // which is the wrong way round. It clears 4.5:1 as well, which matters
  // because these
  // are rendered as TEXT glyphs (`text icon.icon` in
  // `isonim_auto_hide_collapsed_icons_view.nim`), not as background images,
  // so the stricter text threshold is the honest one to hold them to.
  color: colors-ui-icon-primary-default
  cursor: pointer
  padding: 1px 3px
  border-radius: 2px
  background-color: transparent
  user-select: none
  transition: background-color 150ms ease

  &:hover
    background-color: colors-ui-surface-primary-secondary-hover

// ---------------------------------------------------------------------------
// Side-edge tabs — VS Studio style, inside the overlay.
// Rendered as a vertical strip between the screen edge and overlay content.
// ---------------------------------------------------------------------------

.overlay-side-tabs
  display: flex
  flex-direction: column
  flex-shrink: 0
  background-color: colors-ui-surface-primary-tertiary
  padding-top: 4px
  gap: 2px
  overflow: hidden

  &.hidden
    display: none

// Left-edge tabs: between screen left edge and overlay content.
// Background matches the overlay, border only on the content side.
.overlay-side-tabs.side-tabs-left
  width: 28px
  min-width: 28px
  border-right: 1px solid colors-ui-surface-primary-tertiary
  order: -1  // Place before overlay content in flex row
  background-color: colors-ui-surface-base-panel  // Match overlay background

// Right-edge tabs: between overlay content and screen right edge.
.overlay-side-tabs.side-tabs-right
  width: 28px
  min-width: 28px
  border-left: 1px solid colors-ui-surface-primary-tertiary
  order: 1  // Place after overlay content in flex row
  background-color: colors-ui-surface-base-panel

.overlay-side-tab
  writing-mode: vertical-lr
  text-orientation: mixed
  transform: rotate(180deg)
  font-family: "SpaceGrotesk"
  font-size: 12px
  font-weight: 600
  color: colors-ui-text-primary-label
  background-color: colors-ui-surface-primary-secondary
  cursor: pointer
  padding: 3px 6px
  margin: 2px
  max-height: 120px
  white-space: nowrap
  overflow: hidden
  text-overflow: ellipsis
  user-select: none
  transition: background-color 150ms ease

  &:hover
    background-color: colors-ui-surface-base-panel
    color: colors-ui-text-primary-body

  &.active
    background-color: colors-ui-surface-base-panel
    color: colors-ui-text-primary-body

// Right-edge tabs read top-to-bottom (no rotation).
.side-tabs-right .overlay-side-tab
  writing-mode: vertical-rl
  transform: none

#auto-hide-strip-left.drag-over,
#auto-hide-strip-right.drag-over
  width: 2em !important
  max-width: 2em !important
  background-color: rgba(65, 105, 225, 0.4) !important
  box-shadow: inset 0 0 10px rgba(65, 105, 225, 0.6)

#auto-hide-bottom-strip.drag-over
  background-color: rgba(65, 105, 225, 0.4) !important
  box-shadow: inset 0 0 10px rgba(65, 105, 225, 0.6)

// Presentation controls stay at the foot of each normal strip. Native buttons
// support keyboard activation; explicit focus rings remain visible in themes.
.auto-hide-mode-button
  margin-top: auto
  margin-bottom: 4px
  padding: 0
  min-height: 26px
  flex-shrink: 0
  border: 0
  border-radius: 3px
  background: transparent
  color: colors-ui-icon-primary-default
  font-size: 20px
  cursor: pointer
  -webkit-app-region: no-drag

  &:hover
    background-color: colors-ui-surface-base-panel

.auto-hide-mode-button:focus-visible,
.collapsed-icon:focus-visible
  outline: 2px solid colors-ui-icon-primary-default
  outline-offset: -2px

.collapsed-icon-zone.has-icons
  flex-shrink: 0

// Hidden for now (Nikolay, 2026-10-15): the per-panel icons of a minimal
// sidebar.  Only the sidebar toggle shows in the group; the panels are still
// reached through the thin edge line.  Delete this rule to bring them back.
.collapsed-icon-zone .collapsed-icon:not(.auto-hide-restore-button):not(.auto-hide-tablist-button)
  display: none

SIDEBAR_OPEN_ICON_PATH = url('../../public/resources/shared/sidebar_open.svg')
SIDEBAR_CLOSE_ICON_PATH = url('../../public/resources/shared/sidebar_close.svg')

// The sidebar toggle — the Figma design system's `icons-lg=sidebar-open`
// (sidebar expanded) and `icons-lg=sidebar-close` (sidebar minimal), drawn as
// masks so the colour comes from tokens, like the tab icons.  It is the zone's
// outer-end button in both modes, so it never moves.  The right edge's is
// mirrored: its sidebar is on the right.
.auto-hide-restore-button
  width: 1.5rem
  height: 1.5rem
  // Exactly 24px: the generic `button { flex: 0 0 1.75em }` made it 24.5px,
  // which put the 16px icon a fractional 4.25px in from the button's edge.
  flex: 0 0 1.5rem !important
  padding: 0
  border: 0
  -webkit-app-region: no-drag
  tab-icon(SIDEBAR_CLOSE_ICON_PATH, 1rem 1rem)
  transition: background-color 150ms ease

  &.sidebar-open
    -webkit-mask-image: SIDEBAR_OPEN_ICON_PATH
    mask-image: SIDEBAR_OPEN_ICON_PATH

  &.sidebar-right
    transform: scaleX(-1)

// 16px between each sidebar toggle's ICON and the text beside it, on both
// sides (Nikolay, 2026-10-15): the 24px button insets its 16px icon by 4px,
// and the group pads 12px on the side facing the text.  The neighbours' own
// spacing is cleared so it does not add on: "Ruby · UTF-8"'s 0.6em lead on
// the left, `.status-right`'s 8px end padding on the right.
#auto-hide-collapsed-icon-zone.has-icons
  padding-right: 0.75rem

#status-base #auto-hide-collapsed-icon-zone.has-icons + #file-info-status
  margin-left: 0

#auto-hide-collapsed-icon-zone-right.has-icons
  padding-left: 0.75rem

// `!important`: status_bar.styl sets it under `#status #status-base`.  (The
// certificate readout's end margin is cleared with the location path it
// separated it from — the "hidden for now" rule in status_bar.styl.)
#status-base .status-right:has(+ #auto-hide-collapsed-icon-zone-right.has-icons)
  padding-right: 0 !important

// ---------------------------------------------------------------------------
// Tab-list button and dropdown (Nikolay, 2026-10-16)
//
// Beside each sidebar toggle, on its inner side: the Figma design system's
// `icons-lg=tab_list_sm`, drawn as a mask like the toggle.  It opens a menu of
// that sidebar's pinned tabs, built like every other dropdown in the app —
// `dropdown-surface()` with `ct-menu-item` rows (shared_widgets.styl) — that
// opens UP from the status bar, DROPDOWN_TRIGGER_GAP above it, aligned to the
// zone's outer edge.  ui/auto_hide.nim owns the open state and dismissal.
// ---------------------------------------------------------------------------
TAB_LIST_ICON_PATH = url('../../public/resources/shared/tab_list_sm.svg')
CLOSE_SM_ICON_PATH = url('../../public/resources/shared/close_sm.svg')

.collapsed-icon-zone.has-icons
  position: relative

.auto-hide-tablist-button
  width: 1.5rem
  height: 1.5rem
  flex: 0 0 1.5rem !important
  padding: 0
  border: 0
  -webkit-app-region: no-drag
  tab-icon(TAB_LIST_ICON_PATH, 1rem 1rem)
  transition: background-color 150ms ease

  // Open: the icon stays lit while its menu is up.
  &.open
    background-color: TAB_ICON_COLOR_HOVER

// 8px between the toggle's icon and the tab-list icon (Nikolay, 2026-10-16):
// the two 24px buttons touch, and each insets its 16px icon by 4px.  So the
// zone's 2px item gap goes (the per-panel icons it spaced are hidden for now —
// restore it with them).
.collapsed-icon-zone.has-icons
  gap: 0

// Lifted to the top of the page by ui/auto_hide.nim (`liftTabListMenu`),
// which sets `bottom` and `left` / `right`: fixed, above every panel.
.auto-hide-tablist-menu
  position: fixed
  z-index: 100
  display: flex
  flex-direction: column
  min-width: 13.75rem
  max-width: 22.5rem
  max-height: 60vh
  dropdown-surface()
  // After the mixin on purpose, as the tab-overflow menu does: it sets
  // `overflow: hidden`, but a long list of pinned tabs has to scroll.
  overflow-y: auto
  -webkit-app-region: no-drag

.auto-hide-tablist-item
  dropdown-surface-row()
  // The generic `button { flex: 0 0 1.75em !important }` would squash the
  // 2.25rem `ct-menu-item` row to 24.5px in this column (cf. request_panel's
  // Handler button).
  flex: 0 0 auto !important
  white-space: nowrap
  // Rows are square, as in every dropdown; only the menu's outer corners
  // round.  The generic `button` rule rounds each row to 7px otherwise.
  border-radius: 0 !important

  &:first-child
    border-radius: DROPDOWN_RADIUS DROPDOWN_RADIUS 0 0 !important

  &:last-child
    border-radius: 0 0 DROPDOWN_RADIUS DROPDOWN_RADIUS !important

  .ct-menu-item-label
    overflow: hidden
    text-overflow: ellipsis

  .ct-menu-item-label
    flex: 1 1 auto
    min-width: 0

  // The × at the end of the selected row (Figma `icons-lg=close-sm`): closes
  // the panel that is showing.  A mask like the tab icons, so it takes their
  // resting and hover colours (TAB_ICON_COLOR / _HOVER, shared_widgets.styl).
  .auto-hide-tablist-close
    flex: 0 0 1rem
    width: 1rem
    height: 1rem
    margin-left: auto
    cursor: pointer
    tab-icon(CLOSE_SM_ICON_PATH, 1rem 1rem)

  // The tab whose panel is showing.  On the label as well: `ct-menu-item`
  // gives the label its own colour, which beat the row's.
  &.active,
  &.active .ct-menu-item-label
    color: colors-ui-text-primary-active

