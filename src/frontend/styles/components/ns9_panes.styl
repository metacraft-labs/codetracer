// NS9's two panes — Test Results and Constraints.
//
// Both are row lists with a label on the left and a number on the right, so
// they share a grid rather than each inventing one: a reader's eye lands in
// the same place in either pane, which is the point of them being siblings in
// one column.
//
// Colours come from the design-system variables the other panes use, so the
// two follow a theme change without knowing a theme exists.

ns9-row-padding = 2px 8px

// `colors-ui-surface-base-card` AND NOT `colors-ui-surface-hover-panel`, which
// is what these rules said and which IS NOT A TOKEN. Nothing in
// `styles/generated/{brand,alias,mapped}.styl` defines it, and Stylus emits an
// unknown identifier verbatim rather than failing — so `background-color:
// colors-ui-surface-hover-panel` reached the browser as an invalid value, was
// dropped, and every row hover in these two panes silently did nothing. A
// misspelling that compiles is the shape a token lint exists to catch; there is
// no such lint over `src/frontend/styles`, so it is named here instead.
//
// THERE IS NOW: `ci/test/css-token-resolution.sh` compiles every shipped
// stylesheet and fails the build on an identifier that resolves to nothing. It
// found a second one in this very rule — the body colour below said
// `colors-ui-text-default-label`, which is not a token either, so these two
// panes had no text colour and painted in whatever they inherited.
// `colors-ui-text-primary-label` is the label tier the sibling panes use:
// #c8c8c8 on the #282828 these panes sit on, measured at 8.81:1.

.test-results,
.constraints
  height: 100%
  display: flex
  flex-direction: column
  overflow: auto
  font-family: "SpaceGrotesk" !important
  font-style: normal
  font-weight: 400
  color: colors-ui-text-primary-label

  &:focus
    outline: 0px

.test-results-headline,
.constraints-headline
  padding: 6px 8px 4px 8px
  opacity: 0.75
  white-space: nowrap
  overflow: hidden
  text-overflow: ellipsis

// The headline and the ▶ share a row: the headline takes the slack and
// truncates, so a long "3 passed, 2 failed" never pushes the control off the
// pane. Same arrangement as the BUILD pane's header, which is where a reader
// has already learned to look for a run control.
.test-results-header
  display: flex
  align-items: baseline
  justify-content: space-between
  gap: 6px

  .test-results-headline
    flex: 1 1 auto
    min-width: 0

// DISABLED IS DIMMED, NOT ABSENT — see the view's header. A control that
// disappears cannot be told apart from a feature that is not there, and the
// three reasons it can be disabled are all temporary or deployment-specific.
.test-results-run-btn
  flex: 0 0 auto
  padding: 4px 8px
  cursor: pointer
  opacity: 0.75
  user-select: none

  &:hover
    opacity: 1
    background-color: colors-ui-surface-base-card

  &.disabled
    opacity: 0.3
    cursor: default

    &:hover
      opacity: 0.3
      background-color: transparent

.test-results-body,
.constraints-body
  display: flex
  flex-direction: column

// ---------------------------------------------------------------------------
// Test Results
// ---------------------------------------------------------------------------

.test-results-row
  display: grid
  // mark | name | where | duration | actions.
  //
  // THE NAME OUTRANKS THE LOCATION, and that ordering is the whole of the fix
  // for what adding a fifth column did to this pane. With `where` sized `auto`
  // it never shrank, so the controls' 45px came entirely out of the name and
  // the pane read `test_equa…  src/main.nr:18` — the file spelled out in full
  // beside a test whose name had been cut in half. A reader scanning for a
  // test scans the names; the path is context.
  //
  // Both flexible columns are `minmax(0, …)` because a grid track's default
  // `min-width: auto` refuses to go below its content, which is what makes
  // `text-overflow: ellipsis` silently do nothing inside a grid.
  grid-template-columns: 14px minmax(0, 1.8fr) minmax(0, 1fr) auto auto
  align-items: baseline
  column-gap: 6px
  padding: ns9-row-padding

  &:hover
    background-color: colors-ui-surface-base-card

// THE TWO PER-ROW CONTROLS.
//
// PERSISTENTLY VISIBLE AND NOT HOVER-REVEALED, at 0.45 rather than 0. A
// control that only exists under the pointer is one a reader scanning the pane
// never learns about, which is this campaign's commonest defect wearing a
// fashionable costume. They brighten on row hover so the row you are aiming at
// is the one that answers.
.test-results-actions
  display: inline-flex
  align-items: baseline
  gap: 2px
  opacity: 0.45

.test-results-row:hover .test-results-actions
  opacity: 0.95

.test-results-refresh-btn,
.test-results-open-btn
  padding: 0 4px
  cursor: pointer
  user-select: none
  border-radius: 3px

  &:hover
    background-color: colors-ui-surface-base-card

  // DIMMED, NOT ABSENT, and its `title` says why — the same rule the header's
  // ▶ follows. The two buttons can be disabled for DIFFERENT reasons (see
  // `test_results_vm.openAbsence`), so a shared look with per-control text is
  // exactly right: same affordance, different explanation.
  &.disabled
    opacity: 0.3
    cursor: default

    &:hover
      background-color: transparent

// SHIFT IS VISIBLE. The modifier changes what `⏵` does, so it changes what
// `⏵` looks like — a bordered, brightened control the eye catches while the
// key is down. A tooltip alone would be a promise only a reader who already
// suspected the feature would go looking for.
.test-results-open-btn.shift-armed
  opacity: 1
  // `colors-ui-text-information-primary` AND NOT an invented `…-accent-…`.
  // The header of this file records what an unknown token costs here: Stylus
  // emits the identifier verbatim, the browser drops the declaration, and the
  // rule silently does nothing. This one is in `generated/mapped.styl`; the
  // first name tried was not.
  color: colors-ui-text-information-primary
  box-shadow: inset 0 0 0 1px colors-ui-border-secondary

.test-results-mark
  text-align: center
  opacity: 0.8

.test-results-name
  overflow: hidden
  text-overflow: ellipsis
  white-space: nowrap

.test-results-where,
.test-results-duration
  opacity: 0.55
  font-size: 0.85em
  white-space: nowrap

// AND THE LOCATION IS WHAT TRUNCATES. See the row's grid comment: without
// this the ellipsis had nowhere to go and the name lost the argument instead.
.test-results-where
  overflow: hidden
  text-overflow: ellipsis
  min-width: 0

.test-results-row.passed .test-results-mark
  color: colors-ui-text-success-primary

.test-results-row.failed .test-results-mark,
.test-results-row.errored .test-results-mark
  color: colors-ui-text-error-primary

.test-results-row.not-run
  opacity: 0.7

.test-results-message
  grid-column: 2 / -1
  padding: 2px 0 4px 0
  font-size: 0.85em
  white-space: pre-wrap
  color: colors-ui-text-error-primary

// A RUN THAT FAULTED, and it is styled as an error because it is one. This is
// the one thing on this pane that is NOT ordinary content: the visitor pressed
// Run, the run was attempted, and it failed. Sharing `.test-results-absence`'s
// muted treatment would have put a real failure in the same register as "this
// deployment cannot run tests", which is a statement that was already true
// before anyone clicked.
.test-results-failure
  padding: 6px 8px
  border-top: 1px solid colors-ui-border-secondary

.test-results-failure-line
  font-size: 0.85em
  line-height: 1.35
  white-space: pre-wrap
  color: colors-ui-text-error-primary

// The absence line and the empty state are ordinary content, not errors. The
// absence is now a statement about a DEPLOYMENT that placed no Noir compiler
// module rather than about the product — an ordinary web bundle runs its tests
// and leaves this line empty.
.test-results-absence,
.test-results-empty,
.constraints-absence,
.constraints-provenance
  padding: 6px 8px
  font-size: 0.85em
  line-height: 1.35
  opacity: 0.6

.hidden
  display: none

// ---------------------------------------------------------------------------
// Constraints
// ---------------------------------------------------------------------------

.constraints-row
  display: grid
  // name | kind | count.  The count is right-aligned so a column of numbers
  // reads as a column of numbers.
  grid-template-columns: minmax(0, 1fr) auto 4em
  align-items: baseline
  column-gap: 6px
  padding: ns9-row-padding

  &:hover
    background-color: colors-ui-surface-base-card

// COUNTS THAT NO LONGER DESCRIBE THE SOURCE ON SCREEN. The rows are dimmed
// and the headline says `(stale)` beside them — both, not either. Dimming
// alone would be a change a reader cannot name, and the label alone leaves a
// column of confident-looking numbers at full contrast above it.
//
// The rows are dimmed and NOT hidden: the last count the project actually had
// is still the best available answer to "how big is this circuit", and
// blanking the pane on a keystroke would throw it away. See
// `viewmodel/viewmodels/constraints_vm.nim`'s decision 2.
.constraints.stale .constraints-body
  opacity: 0.45

.constraints-name
  overflow: hidden
  text-overflow: ellipsis
  white-space: nowrap

.constraints-kind
  opacity: 0.5
  font-size: 0.8em

.constraints-count
  text-align: right
  font-variant-numeric: tabular-nums

.constraints-row.unconstrained
  opacity: 0.75

// ---------------------------------------------------------------------------
// The generated code itself
// ---------------------------------------------------------------------------

// A function is its count row plus the opcodes under it, so the two scroll and
// dim together. Without the wrapper a long listing would separate a heading
// from the rows it heads the moment the pane scrolled.
.constraints-function
  display: flex
  flex-direction: column

// The count row is the listing's heading, so it stops being a table row and
// starts looking like one: it sticks to the top of the pane while its opcodes
// scroll past, which is the only way to know which function you are reading
// once the rows outnumber the pane.
.constraints-function > .constraints-row
  position: sticky
  top: 0
  z-index: 1
  background-color: colors-ui-surface-base-card

// MONOSPACE, because these are the compiler's characters. The pane's default
// is SpaceGrotesk, which is proportional — operand lists like `[w0 - w1]` and
// the 60-digit field constants the listing prints do not line up in it, and a
// listing whose columns do not line up is harder to read than the count it
// replaced.
.constraints-opcodes
  font-family: monospace
  font-size: 0.85em
  padding: 0

// The Low Level Code pane's row, re-columned for this pane's width.
//
// That pane's seven-column grid is sized for a full-width editor (5em + 6em +
// 18em + 14em + 7em + auto + 1fr) and this pane is a ~400px sidebar, so
// inheriting it would push the operands out of sight. The COLUMNS are what
// changes; the classes, the hover and the borders are the Low Level Code
// pane's own, which is the part §9.2 asks to be shared.
// FLEX, NOT THE GRID IT INHERITS, and the reason is visible the moment it is
// wrong. The Low Level Code pane's row is `display: grid`, and every row is a
// SEPARATE grid — column widths are not shared between siblings. Under `auto`
// columns each row therefore sized its own gutter and then stretched the
// remainder to the widest row in the pane, which pushed each operand list a
// different distance to the right and left the listing visibly ragged:
// `BRILLIG` on one line with its arguments 300px away, `BRILLIG CALL func: 0`
// flush on the next.
//
// A shared column geometry would need `display: grid` on the CONTAINER with
// `grid-template-columns` there and rows as contents — a bigger change to a
// pane this one only borrows. Flex gives the listing what it actually needs:
// a fixed gutter, then the opcode and its operands flowing as text.
.constraints-opcode.low-level-code-instruction
  display: flex
  align-items: baseline
  column-gap: 0.5em
  padding-left: 1em
  // Wrapping would break the one-row-per-opcode identity the index gutter
  // asserts, so the pane scrolls horizontally instead.
  white-space: nowrap

// The gutter is the one fixed column: a ragged left edge on the opcodes would
// undo the reason for numbering them.
.constraints-opcode .low-level-code-instruction-offset
  flex: 0 0 2.5em

.constraints-opcode .low-level-code-instruction-offset
  text-align: right
  font-variant-numeric: tabular-nums
  // Dimmer than the opcode it numbers, and no more: the gutter is for finding
  // your place, and at the Low Level Code pane's own 0.65 it competes with the
  // instruction beside it.
  opacity: 0.5

// Totals with no rows behind them. Says which of the two kinds of answer the
// pane is holding; see `listingNoticeFor`.
.constraints-listing-notice
  padding: 6px 8px
  font-size: 0.85em
  line-height: 1.35
  opacity: 0.6
