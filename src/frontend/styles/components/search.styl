.search-component
  height: 100%
  display: flex
  flex-direction: column
  overflow: hidden
  background: colors-ui-surface-base-panel
  color: colors-ui-text-primary-body
  font-family: "SpaceGrotesk", sans-serif
  font-size: 13px

// Command / File / Find in Files / Find Symbol: the shared segmented tabs
// (`segmented-tabs()`, shared_widgets.styl), like the State panel's.  8px in
// from the panel's top and left edges; the input row below keeps its own
// padding, so no margin underneath.
.search-mode-selector
  flex: 0 0 auto
  segmented-tabs()
  margin: 0.5rem 0.5rem 0

.search-input-row
  flex: 0 0 auto
  padding: 0.5em
  border-bottom: 1px solid colors-ui-surface-input-default

.search-query-input
  width: 100%
  // A panel field, so the medium input size (INPUT_HEIGHT_MD, input.styl);
  // this was 30px, off the scale.
  height: INPUT_HEIGHT_MD
  box-sizing: border-box
  border: CONTROL_BORDER_WIDTH solid CONTROL_BORDER_COLOR
  border-radius: CONTROL_RADIUS
  background: colors-ui-surface-input-secondary
  color: colors-ui-text-primary-body
  padding: 0 0.75em
  font: inherit
  outline: 0

.search-results
  flex: 1 1 auto
  min-height: 0
  overflow: auto
  background: colors-ui-surface-base-panel

  &[display="none"]
    display: none

.search-result-row
  display: grid
  grid-template-columns: minmax(12em, 1fr) minmax(14em, 32em) 6em
  align-items: center
  column-gap: 1em
  min-height: 28px
  padding: 0 0.75em
  border-bottom: 1px solid colors-ui-border-secondary
  cursor: pointer

  &:hover,
  &.selected
    background: colors-ui-surface-primary-secondary-hover

.search-result-label,
.search-result-detail
  min-width: 0
  overflow: hidden
  text-overflow: ellipsis
  white-space: nowrap

.search-result-detail,
.search-result-shortcut,
.search-selected-indicator
  color: colors-ui-text-primary-body

.search-selected-indicator
  display: block
  padding: 0.5em 0.75em
  font-family: "SpaceGrotesk"
  font-size: 12px

  &.active
    color: colors-ui-text-primary-body
