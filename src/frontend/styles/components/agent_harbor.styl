// Agent Harbor fleet panel (isonim_agent_harbor_fleet_view.nim): the sessions
// an Agent Harbor server lists, with a category filter strip.
//
// Built from the same parts as the VCS panel (vcs.styl) so it reads as a
// CodeTracer panel rather than as an embedded web page: the section header,
// the small toggle buttons, list rows that highlight like commit rows, and
// right-aligned ages like commit timestamps. Every colour is a design-system
// role (`colors-ui-*`, generated/mapped.styl, with its Light value under
// COLOR_MODE = "Light"); sizes are the type roles (`type-ui-size-*`, unitless
// px in the token files, converted to rem against the 16px root as
// session_tabs.styl does for the control radius) or the shared control and
// inset sizes of button.styl.

// Unitless design-token px -> rem.
ah-rem(px)
  unit(px / 16, 'rem')

AH_ROW_DOT = 0.5rem

.agent-harbor-fleet
  height: 100%
  display: flex
  flex-direction: column
  overflow: hidden
  background: colors-ui-surface-base-panel
  color: colors-ui-text-primary-body

.ah-fleet-body
  display: flex
  flex: 1 1 auto
  flex-direction: column
  min-height: 0
  overflow: hidden

// ---------------------------------------------------------------------------
// Header: section header + filter strip
// ---------------------------------------------------------------------------

.ah-fleet-head
  flex-shrink: 0
  background: colors-ui-surface-base-panel

// The VCS panel's section header (`.vcs-section-header`): an uppercase label
// over a hairline divider, with the source as a quieter second label.
.ah-fleet-section-header
  display: flex
  align-items: baseline
  gap: 0.5rem
  padding: 0.25rem PANEL_INSET
  border-bottom: 0.0625rem solid colors-ui-border-secondary
  user-select: none
  min-width: 0

.ah-fleet-title
  flex-shrink: 0
  font-size: ah-rem(type-ui-size-label-md)
  font-weight: 600
  text-transform: uppercase
  letter-spacing: 0.03125em
  color: colors-ui-text-primary-label

.ah-fleet-source
  flex: 1 1 auto
  min-width: 0
  font-size: ah-rem(type-ui-size-caption-md)
  color: colors-ui-text-primary-caption
  white-space: nowrap
  overflow: hidden
  text-overflow: ellipsis

// The VCS diff-toggle row (`.vcs-diff-toggle`): small toggles on the panel
// surface, the active one raised.
// A narrow panel wraps the strip onto a second line: every toggle stays
// visible (a strip scrolled sideways hid Failed and Ended at sidebar width).
.ah-fleet-filters
  display: flex
  flex-wrap: wrap
  row-gap: 0.25rem
  align-items: center
  gap: 0.25rem
  padding: 0.375rem PANEL_INSET
  border-bottom: 0.0625rem solid colors-ui-border-secondary

// No toggles before the fleet has loaded: no empty band between two rules.
.ah-fleet-filters:empty
  display: none

.ah-fleet-filter
  flex-shrink: 0
  height: CONTROL_HEIGHT_SM
  display: inline-flex
  align-items: center
  gap: 0.375rem
  padding: 0 0.5rem
  border: 0.0625rem solid transparent
  border-radius: ah-rem(border-border-radius-control)
  cursor: pointer
  font-family: inherit
  font-size: ah-rem(type-ui-size-label-md)
  color: colors-ui-text-primary-label
  background: transparent
  user-select: none

  &:hover
    background: colors-ui-surface-primary-secondary-hover
    color: colors-ui-text-primary-body

  &:focus-visible
    outline: none
    border-color: colors-ui-border-focus

  // As the VCS panel's active toggle (`.vcs-toggle-active`), in both modes.
  &.ah-fleet-filter-active
    background: colors-ui-surface-primary-secondary-hover
    color: colors-ui-text-primary-body

  &.ah-fleet-filter-empty .ah-fleet-filter-count
    color: colors-ui-text-primary-disabled

.ah-fleet-filter-count
  font-variant-numeric: tabular-nums
  color: colors-ui-text-primary-caption

.ah-fleet-filter-active .ah-fleet-filter-count
  color: colors-ui-text-primary-body

.ah-fleet-summary
  flex-shrink: 0
  margin-left: auto
  padding-left: 0.5rem
  font-size: ah-rem(type-ui-size-caption-md)
  color: colors-ui-text-primary-caption
  white-space: nowrap

// ---------------------------------------------------------------------------
// Session rows
// ---------------------------------------------------------------------------

.ah-fleet-list
  flex: 1 1 auto
  min-height: 0
  overflow-y: auto
  overflow-x: hidden

// [dot] [title / meta / activity] [age], like a commit row: the row is the
// click target, hover lifts it, the selection takes the action surface.
.ah-fleet-row
  display: grid
  grid-template-columns: AH_ROW_DOT minmax(0, 1fr) auto
  column-gap: 0.5rem
  align-items: start
  padding: 0.375rem PANEL_INSET
  // The hairline the VCS panel draws between its sections; the divider
  // roles' Dark values sit too close to the panel surface to be seen.
  border-bottom: 0.0625rem solid colors-ui-border-secondary
  cursor: pointer
  user-select: none

  &:hover
    background: colors-ui-surface-primary-secondary-hover

  &:focus-visible
    outline: 0.0625rem solid colors-ui-border-focus
    outline-offset: -0.0625rem

.ah-fleet-row-selected
  background: colors-ui-surface-action-primary

  &:hover
    background: colors-ui-surface-action-primary-hover

  // Every text of a selected row, status words and notes included, takes the
  // selected commit row's text colour (vcs.styl `.vcs-commit-header-selected`):
  // on-action in Dark, body text in Light, where the action surface is a pale
  // indigo on which white is 2:1.
  .ah-fleet-row-title,
  .ah-fleet-row-age,
  .ah-fleet-meta-text,
  .ah-fleet-status-label,
  .ah-fleet-prompt-note,
  .ah-fleet-row-failure,
  .ah-fleet-activity-line
    color: by-mode(colors-ui-text-on-action-primary, colors-ui-text-primary-body)

  // The dot keeps its category colour and is ringed like the selected
  // commit's graph dot, so the status mark survives the fill.
  .ah-fleet-dot
    outline: 0.125rem solid colors-base-white

.agent-harbor-fleet .ah-fleet-row-selected .ah-fleet-status-label
  color: by-mode(colors-ui-text-on-action-primary, colors-ui-text-primary-body)

// The status dot sits on the title's first line.
.ah-fleet-dot
  width: AH_ROW_DOT
  height: AH_ROW_DOT
  margin-top: 0.375rem
  border-radius: 50%
  background: colors-ui-icon-primary-subtle

// Needing input is told by the dot's colour and by the status word
// ("needs input"); no halo -- no warning role contrasts with the warning icon
// role in both modes.
.ah-fleet-cat-needs-input .ah-fleet-dot
  background: colors-ui-icon-warning-primary

.ah-fleet-cat-running .ah-fleet-dot
  background: colors-ui-icon-success-primary

.ah-fleet-cat-queued .ah-fleet-dot
  background: colors-ui-icon-information-primary

.ah-fleet-cat-failed .ah-fleet-dot
  background: colors-ui-icon-error-primary

.ah-fleet-cat-ended .ah-fleet-dot
  background: colors-ui-icon-primary-subtle

.ah-fleet-row-main
  display: flex
  flex-direction: column
  gap: 0.125rem
  min-width: 0

// The commit-row reading size (`.vcs-commit-msg`, 14px): the row's content.
.ah-fleet-row-title
  font-size: ah-rem(type-ui-size-body-md)
  line-height: ah-rem(type-ui-lineheight-body-sm)
  color: colors-ui-text-primary-body
  white-space: nowrap
  overflow: hidden
  text-overflow: ellipsis

// A withheld or missing prompt is a fact about the session, not its title.
.ah-fleet-row-title-placeholder
  font-style: italic
  color: colors-ui-text-primary-caption

.ah-fleet-row-meta
  display: flex
  align-items: center
  gap: 0.375rem
  min-width: 0
  font-size: ah-rem(type-ui-size-caption-md)
  line-height: ah-rem(type-ui-lineheight-caption-md)
  color: colors-ui-text-primary-caption

.ah-fleet-status-label
  flex-shrink: 0
  color: colors-ui-text-primary-label

.ah-fleet-cat-failed .ah-fleet-status-label
  color: colors-ui-text-error-primary

.ah-fleet-cat-running .ah-fleet-status-label
  color: colors-ui-text-success-primary

.ah-fleet-cat-needs-input .ah-fleet-status-label
  color: colors-ui-text-warning-primary

.ah-fleet-meta-text
  flex-shrink: 1
  min-width: 0
  white-space: nowrap
  overflow: hidden
  text-overflow: ellipsis

// "prompt withheld" beside a title that is not the prompt: a quiet note.
.ah-fleet-prompt-note
  margin-left: 0.5rem
  font-style: italic
  font-size: ah-rem(type-ui-size-caption-md)
  color: colors-ui-text-primary-caption-subtle

.ah-fleet-row-failure
  font-size: ah-rem(type-ui-size-caption-md)
  line-height: ah-rem(type-ui-lineheight-caption-md)
  color: colors-ui-text-error-primary
  white-space: nowrap
  overflow: hidden
  text-overflow: ellipsis

.ah-fleet-row-activity
  display: flex
  flex-direction: column
  min-width: 0

.ah-fleet-row-activity:empty
  display: none

.ah-fleet-activity-line
  font-size: ah-rem(type-ui-size-caption-md)
  line-height: ah-rem(type-ui-lineheight-caption-md)
  color: colors-ui-text-primary-caption-subtle
  white-space: nowrap
  overflow: hidden
  text-overflow: ellipsis

.ah-fleet-activity-error
  color: colors-ui-text-error-primary

// The commit-row timestamp column (`.vcs-commit-time-col`).
// On the title's first line: the same line box as the title.
.ah-fleet-row-age
  font-size: ah-rem(type-ui-size-caption-md)
  line-height: ah-rem(type-ui-lineheight-body-sm)
  font-variant-numeric: tabular-nums
  color: colors-ui-text-primary-body-subtle
  white-space: nowrap

// ---------------------------------------------------------------------------
// States
// ---------------------------------------------------------------------------

.ah-fleet-overlay
  flex: 1 1 auto

.ah-fleet-error
  display: flex
  flex: 1 1 auto
  flex-direction: column
  align-items: center
  justify-content: center
  gap: 0.5rem
  padding: 0 EMPTY_OVERLAY_SIDE_GAP
  text-align: center

.ah-fleet-error-title
  font-size: ah-rem(type-ui-size-body-md)
  color: colors-ui-text-error-primary

.ah-fleet-error-message
  font-size: ah-rem(type-ui-size-caption-md)
  color: colors-ui-text-primary-caption
  word-break: break-word

.ah-fleet-retry
  height: CONTROL_HEIGHT_SM
  display: inline-flex
  align-items: center
  line-height: 1
  padding: 0 0.75rem
  border: 0.0625rem solid colors-ui-border-primary
  border-radius: ah-rem(border-border-radius-control)
  font-family: inherit
  font-size: ah-rem(type-ui-size-label-md)
  color: colors-ui-text-primary-label
  background: colors-ui-surface-primary-secondary
  cursor: pointer

  &:hover
    background: colors-ui-surface-primary-secondary-hover
    border-color: colors-ui-border-primary-hover
