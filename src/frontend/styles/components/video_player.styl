// Video Player pane — Visual Replay GUI.
// Spec: codetracer-specs/GUI/Debugging-Features/Visual-Replay.md
//
// Theming strategy
// ----------------
// The pane chrome (transport bar, scrubber, text) is themed via CSS
// custom properties scoped to ``.video-player-component`` so the colours
// can swap at runtime without a Stylus rebuild.  Production users see
// dark theme (the only theme the Electron host currently ships), and
// the defaults below mirror the historical compile-time Stylus
// values exactly — pixel-identical for dark theme.
//
// Light theme is enabled by adding ``theme-light`` to ``<body>``; the
// override block below switches the same CSS variables to the values
// used by ``default_white_theme.styl``.  The storybook Playwright spec
// (``video-player-storybook.spec.ts``) uses the
// ``__CODETRACER_TEST__.setTheme`` hook installed by
// ``ui/video_player.nim`` to flip the class and capture light-theme
// snapshots without recompiling the Stylus bundle.
//
// Milestone: codetracer-specs/GUI/Debugging-Features/Visual-Replay.milestones.org
//            §M5-followup: light-theme storybook coverage.

.video-player-component
  // Dark-theme defaults — sourced from the surrounding Stylus
  // variables so the production look-and-feel keeps tracking the
  // global theme tokens.  The whole pane reads colours via
  // ``var(--video-player-*)``; the override block at the bottom of
  // this file swaps the values when ``<body>`` carries
  // ``theme-light``.
  --video-player-fg: colors-ui-text-primary-body
  --video-player-bg: colors-ui-surface-base-panel
  --video-player-chrome-bg: colors-ui-surface-primary-tertiary
  --video-player-chrome-border: colors-ui-surface-input-default
  --video-player-button-hover-bg: colors-ui-surface-input-default
  --video-player-button-active-bg: colors-ui-surface-input-default
  --video-player-divider: colors-ui-surface-input-default
  --video-player-scrub-labels-fg: colors-ui-text-primary-body

  display: flex
  flex-direction: column
  height: 100%
  width: 100%
  min-height: 0
  box-sizing: border-box
  overflow: hidden
  color: var(--video-player-fg)
  background: var(--video-player-bg)
  font-family: "SpaceGrotesk"
  font-size: 0.8125rem
  line-height: 1.25rem


  // --- Stage (frame canvas + overlays) ----------------------------------
  .video-player-stage
    position: relative
    flex: 1 1 auto
    min-height: 0
    overflow: hidden
    display: flex
    align-items: center
    justify-content: center
    background: #0a0a0a

  .video-player-image
    max-width: 100%
    max-height: 100%
    image-rendering: pixelated
    user-select: none
    pointer-events: none

  // Hidden mirror canvas at 1:1 source resolution — backs the magnifier
  // loupe's getImageData() reads. Kept in the DOM so the 2D context
  // survives across renders; never participates in layout.
  .video-player-mirror-canvas
    display: none !important
    position: absolute
    width: 0
    height: 0
    pointer-events: none

  .video-player-empty,
  .video-player-loading
    position: absolute
    top: 50%
    left: 50%
    transform: translate(-50%, -50%)
    color: #cccccc
    font-size: 0.875rem
    text-align: center
    pointer-events: none

  // --- M5: Startup spinner overlay (spec §Status Indicators) -----------
  // Centred over the canvas while ct_gfx_player is launching and /info
  // hasn't yet succeeded.  Pure CSS spinner — no SVG asset, no JS.
  .video-player-startup
    position: absolute
    top: 50%
    left: 50%
    transform: translate(-50%, -50%)
    display: flex
    flex-direction: column
    align-items: center
    gap: 0.625rem
    padding: 0.875rem 1.375rem
    border-radius: 0.375rem
    background: rgba(20, 20, 20, 0.78)
    color: #f5f5f5
    font-size: 0.8125rem
    line-height: 1.125rem
    pointer-events: none
    box-shadow: 0 0.375rem 1.125rem rgba(0, 0, 0, 0.45)

  .video-player-startup-spinner
    width: 1.75rem
    height: 1.75rem
    border-radius: 50%
    border: 0.1875rem solid rgba(255, 255, 255, 0.18)
    border-top-color: rgba(120, 180, 255, 0.95)
    animation: video-player-startup-spin 0.9s linear infinite

  .video-player-startup-label
    color: #eaeaea
    font-weight: 500

  @keyframes video-player-startup-spin
    from
      transform: rotate(0deg)
    to
      transform: rotate(360deg)

  // --- M5: Player-error badge (spec §Status Indicators) ----------------
  // Bottom-left red banner when ct_gfx_player exits or /info reports an
  // error.  Sits above the canvas, leaves the transport bar to its
  // disabled styling.
  .video-player-error
    position: absolute
    left: 0.625rem
    bottom: 0.625rem
    max-width: calc(100% - 1.25rem)
    display: flex
    align-items: flex-start
    gap: 0.5rem
    padding: 0.5rem 0.75rem
    border-radius: 0.25rem
    background: rgba(168, 27, 27, 0.92)
    color: #fff5f5
    font-size: 0.75rem
    line-height: 1rem
    box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.4)
    pointer-events: auto

  .video-player-error-icon
    width: 1.125rem
    height: 1.125rem
    border-radius: 50%
    background: #fff5f5
    color: #a81b1b
    font-weight: 700
    font-size: 0.75rem
    line-height: 1.125rem
    text-align: center
    flex: 0 0 auto

  .video-player-error-message
    white-space: pre-wrap
    word-break: break-word

  .video-player-canvas-overlay
    position: absolute
    top: 0
    left: 0
    right: 0
    bottom: 0
    pointer-events: none

    &.picker
      box-shadow: inset 0 0 0 0.125rem rgba(80, 160, 255, 0.85)

  // --- Magnifier loupe --------------------------------------------------
  .video-player-loupe
    display: none
    position: absolute
    width: 7.5rem
    pointer-events: none
    z-index: 10
    transform-origin: top left

    &.visible
      display: block

  .video-player-loupe-canvas
    width: 7.5rem
    height: 7.5rem
    border-radius: 50%
    border: 0.125rem solid rgba(255, 255, 255, 0.85)
    box-shadow: 0 0 0 0.0625rem rgba(0, 0, 0, 0.6), 0 0.5rem 1rem rgba(0, 0, 0, 0.5)
    background: #111
    image-rendering: pixelated

  .video-player-loupe-readout
    margin-top: 0.25rem
    padding: 0.125rem 0.375rem
    background: rgba(0, 0, 0, 0.78)
    color: #eaeaea
    font-size: 0.6875rem
    line-height: 0.875rem
    border-radius: 0.1875rem
    white-space: nowrap
    text-align: center

  // RGBA channel readout sits directly under the coordinates readout. The
  // distinct class keeps room for future styling (e.g. swatch chip) without
  // disturbing the existing coords line.
  .video-player-loupe-rgba
    margin-top: 0.125rem
    font-variant-numeric: tabular-nums
    color: #f4f4f4

  // --- Transport bar ----------------------------------------------------
  .video-player-transport
    flex: 0 0 auto
    display: flex
    align-items: center
    gap: 0.375rem
    padding: 0.375rem 0.625rem
    border-top: 0.0625rem solid var(--video-player-chrome-border)
    background: var(--video-player-chrome-bg)

    // M5 spec §Status Indicators / "Player error": controls disabled.
    // This one class greys every button and makes it inert in one place — no
    // per-button disabled state to keep in sync with the VM error signal.
    // Text and border only, never the fill (D-20).
    &.disabled
      pointer-events: none

      .video-player-button
        color: colors-ui-text-primary-disabled
        border-color: colors-ui-border-disabled

  .video-player-button
    display: inline-flex
    align-items: center
    justify-content: center
    min-width: 1.75rem
    height: 1.75rem
    box-sizing: border-box
    padding: 0 0.375rem
    border-radius: CONTROL_RADIUS
    // The button look (button.styl); pressed is its active state.
    control-button()
    font-size: 0.875rem
    line-height: 1
    user-select: none

    &:hover
      control-button-hover()

    &:active,
    &.pressed
      control-button-active()

  .video-player-divider
    width: 0.0625rem
    height: 1.125rem
    background: var(--video-player-divider)
    margin: 0 0.25rem

  .video-player-rate-badge
    margin-left: auto
    padding: 0.125rem 0.5rem
    border-radius: 0.1875rem
    background: rgba(80, 160, 255, 0.18)
    // Pale blue on the dark bar, the information text token on the light
    // one (`by-mode`, defaults.styl).
    color: by-mode(#cfe7ff, colors-ui-text-information-primary)
    font-size: 0.6875rem
    font-weight: 600
    text-transform: uppercase
    white-space: nowrap

  // M5 polish: yellow dot next to the rate badge.  The bullet glyph
  // ("●") in the markup is sized via font-size; the colour and
  // pulsing animation are CSS so the indicator reads as "active
  // network problem" rather than "static badge".
  .video-player-buffering
    display: inline-flex
    align-items: center
    justify-content: center
    margin-left: 0.375rem
    width: 0.875rem
    height: 0.875rem
    border-radius: 50%
    background: #ffcc55
    color: transparent
    font-size: 0
    line-height: 1
    box-shadow: 0 0 0 0.125rem rgba(255, 204, 85, 0.25)
    animation: video-player-buffering-pulse 1.4s ease-in-out infinite

  @keyframes video-player-buffering-pulse
    0%, 100%
      box-shadow: 0 0 0 0.125rem rgba(255, 204, 85, 0.18)
    50%
      box-shadow: 0 0 0 0.3125rem rgba(255, 204, 85, 0.28)

  // --- Scrub slider -----------------------------------------------------
  .video-player-scrubber
    flex: 0 0 auto
    padding: 0.25rem 0.625rem 0.5rem
    background: var(--video-player-chrome-bg)
    border-top: 0.0625rem solid var(--video-player-chrome-border)
    position: relative

  .video-player-scrub-range
    width: 100%
    accent-color: rgba(80, 160, 255, 0.85)

    &:disabled
      opacity: 0.5

  // M5 placeholder for clear-frame tick marks.  Today the contents
  // are empty (the /info endpoint doesn't expose clear-frame info —
  // see Visual-Replay.milestones.org M5-followup).  When the
  // backend lands, the view emits one .video-player-scrub-tick per
  // tick with ``left: <leftPercent>%`` inline-styled from
  // ``layoutScrubTicks`` in video_player_vm.nim.
  .video-player-scrub-ticks
    position: relative
    height: 0.25rem
    margin: 0 0.375rem

  .video-player-scrub-tick
    position: absolute
    top: 0
    width: 0.125rem
    height: 0.25rem
    background: rgba(200, 200, 200, 0.65)
    transform: translateX(-50%)

  .video-player-scrub-labels
    display: flex
    align-items: center
    justify-content: space-between
    gap: 0.75rem
    margin-top: 0.125rem
    color: var(--video-player-scrub-labels-fg)
    font-size: 0.6875rem
    line-height: 0.875rem

  .video-player-selected-pixel
    color: var(--video-player-fg)

// --- Light theme override (M5-followup) -------------------------------
// Activated by adding ``theme-light`` to ``<body>``.  Today this is
// driven exclusively by the storybook Playwright spec via the
// ``__CODETRACER_TEST__.setTheme`` hook in ``ui/video_player.nim``;
// when the broader app gains a runtime theme switch the same class
// will light up the override.
//
// Colour values mirror ``default_white_theme.styl`` for the
// corresponding global tokens so the panel reads visually consistent
// with the hypothetical light-themed shell.  ``colors-ui-text-primary-body``
// is undefined in that file, so ``colors-ui-text-primary-body`` falls back to
// ``colors-ui-text-primary-body`` here (the closest meaningful approximation
// for "secondary text on a light background").
body.theme-light .video-player-component
  --video-player-fg: #464646
  --video-player-bg: #F5F5F5
  --video-player-chrome-bg: #b8c0cf
  // In the light sheet the primary border token, as everything else there
  // (`by-mode`, defaults.styl); the dark sheet keeps this block's own value.
  --video-player-chrome-border: by-mode(#9aa3b5, colors-ui-border-primary)
  --video-player-button-hover-bg: rgba(0, 0, 0, 0.08)
  --video-player-button-active-bg: rgba(0, 0, 0, 0.14)
  --video-player-divider: rgba(0, 0, 0, 0.18)
  --video-player-scrub-labels-fg: #464646
