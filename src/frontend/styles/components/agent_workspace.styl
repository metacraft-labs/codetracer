// Agent Workspace component styles (M9).
//
// Layout: header bar, summary bar, and two-panel body with file list
// sidebar (left) and Monaco editor with coverage overlay (right).
// Reuses the DeepReview line decoration classes for coverage highlighting.

// --- The custom properties these panes read, in the light theme ---
//
// This file, `caption_bar_progress.styl` and the DeepReview header in
// `vcs.styl` paint through `var(--bg-hover, #2a2b34)`, `var(--text-primary,
// #c9c9c9)` and their siblings, and nothing defines those properties: under
// the dark theme every one falls back to the hex beside it, which is what
// those panes have always looked like, and that stays as it is. Under the
// light theme the same fallbacks were dark grounds with pale text. Defined on
// `:root` they reach every element, so no fallback paints in the light sheet;
// each takes the design token of its role. The other light-sheet readers of
// these names (the borders of `file_conflict_dialog.styl` and
// `hcr_live_edit_panel.styl`, the text of `async_flow.styl`) read them with no
// fallback at all, and take the same tokens from here.
if COLOR_MODE is defined and COLOR_MODE == "Light"
  :root
    // A pane's ground: the file list, the milestones popup.
    --bg-primary: colors-ui-surface-base-panel
    // A bar set off from that ground: the header and summary bars, the
    // progress track.
    --bg-secondary: colors-ui-surface-base-card
    // The list hover (LIST_HOVER_BG, button.styl).
    --bg-hover: colors-ui-surface-primary-secondary-hover
    // A selected row, as `.event-selected`.
    --bg-selected: colors-editor-surface-select
    --text-primary: colors-ui-text-primary-body
    --text-secondary: colors-ui-text-primary-caption
    --border-color: colors-ui-border-primary
    // The panes' links and toggles (cyan #a5f3fc in the dark).
    --accent-color: colors-ui-text-information-primary

.agent-workspace-container
  display flex
  flex-direction column
  height 100%
  width 100%
  overflow hidden
  font-family "SpaceGrotesk"

// --- Header ---

.agent-workspace-header
  display flex
  justify-content space-between
  align-items center
  padding 6px 16px
  background-color var(--bg-secondary, #1e1f26)
  border-bottom 1px solid var(--border-color, #3a3b44)
  flex-shrink 0

.agent-workspace-header-label
  font-size 13px
  font-weight bold
  color var(--text-primary, #c9c9c9)

.agent-workspace-header-path
  font-size 12px
  color var(--text-secondary, #8e8f92)
  margin-left 12px
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  flex 1

.agent-workspace-view-toggle
  font-size 12px
  color var(--accent-color, #A5F3FC)
  cursor pointer
  padding 3px 8px
  border-radius 4px
  transition background-color 0.15s ease

  &:hover
    background-color var(--bg-hover, #2a2b34)

// --- Summary bar ---

.agent-workspace-summary
  display flex
  align-items center
  gap 16px
  padding 4px 16px
  background-color var(--bg-secondary, #1e1f26)
  border-bottom 1px solid var(--border-color, #3a3b44)
  flex-shrink 0
  font-size 12px
  color var(--text-secondary, #8e8f92)

.agent-workspace-summary-item
  white-space nowrap

.agent-workspace-overlay-toggle
  margin-left auto
  cursor pointer
  color var(--accent-color, #A5F3FC)
  font-size 11px
  padding 2px 6px
  border-radius 3px
  transition background-color 0.15s ease

  &:hover
    background-color var(--bg-hover, #2a2b34)

// --- Body (two-panel layout) ---

.agent-workspace-body
  display flex
  flex 1
  overflow hidden

.agent-workspace-empty
  padding 24px
  font-size 14px
  color var(--text-secondary, #8e8f92)
  text-align center

// --- File list sidebar ---

.agent-workspace-file-list
  width 240px
  min-width 180px
  overflow-y auto
  border-right 1px solid var(--border-color, #3a3b44)
  background-color var(--bg-primary, #1a1b22)
  flex-shrink 0

.agent-workspace-file-item
  padding 6px 12px
  cursor pointer
  border-bottom 1px solid var(--border-color, #2a2b34)
  transition background-color 0.15s ease

  // The list hover (LIST_HOVER_BG, button.styl).
  &:hover
    background-color LIST_HOVER_BG

  &.selected
    background-color var(--bg-selected, #333444)

.agent-workspace-file-name
  font-size 13px
  color var(--text-primary, #c9c9c9)
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.agent-workspace-file-path
  font-size 11px
  color var(--text-secondary, #8e8f92)
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  margin-top 2px

.agent-workspace-coverage-badge
  display inline-block
  margin-top 2px
  font-size 11px
  color var(--text-secondary, #8e8f92)
  background-color var(--bg-hover, #2a2b34)
  padding 1px 6px
  border-radius 3px

.agent-workspace-flow-badge
  display inline-block
  margin-top 2px
  margin-left 6px
  font-size 10px
  // The success text token in the light theme (`by-mode`, defaults.styl).
  color by-mode(rgba(0, 180, 0, 0.8), colors-ui-text-success-primary)
  background-color rgba(0, 180, 0, 0.1)
  padding 1px 4px
  border-radius 3px

// --- Editor area ---

.agent-workspace-editor-area
  flex 1
  display flex
  flex-direction column
  min-width 0
  overflow hidden

.agent-workspace-editor
  flex 1
  min-height 0

// --- Coverage line highlighting (Monaco decorations) ---
//
// Applied by ``ui/agent_workspace.nim``'s ``deltaDecorations`` call when the
// agent runtime reports which lines of a workspace file were executed and
// which were not reachable.  The class names keep their ``deepreview-``
// prefix because they are what the component emits and what
// ``tests/agentic-coding/page-objects/agentic-page.ts`` locates; the rules
// moved here from the deleted ``components/deepreview.styl`` (DR-R8), where
// they sat next to the standalone review panel that used to share them.
// This component is now their only consumer.

.deepreview-line-executed
  background-color rgba(0, 180, 0, 0.08)
  // The coverage stripes: half-alpha green and red over the dark editor,
  // 1.5:1 and 2.6:1 over the light one. The success / error icon tokens in
  // the light theme (`by-mode`, defaults.styl).
  border-left 3px solid by-mode(rgba(0, 200, 0, 0.5), colors-ui-icon-success-primary)

.deepreview-line-unreachable
  background-color rgba(220, 0, 0, 0.08)
  border-left 3px solid by-mode(rgba(220, 0, 0, 0.5), colors-ui-icon-error-primary)
