// Agent Workspace component styles (M9).
//
// Layout: header bar, summary bar, and two-panel body with file list
// sidebar (left) and Monaco editor with coverage overlay (right).
// Reuses the DeepReview line decoration classes for coverage highlighting.

.agent-workspace-container
  display flex
  flex-direction column
  height 100%
  width 100%
  overflow hidden
  font-family "SpaceGrotesk"

// --- Header ---

.agent-workspace-header
  display flex
  justify-content space-between
  align-items center
  padding 6px 16px
  background-color colors-ui-surface-base-panel
  border-bottom 1px solid colors-ui-border-secondary
  flex-shrink 0

.agent-workspace-header-label
  font-size 13px
  font-weight bold
  color colors-ui-text-primary-body

.agent-workspace-header-path
  font-size 12px
  color colors-ui-text-primary-label-subtle
  margin-left 12px
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  flex 1

.agent-workspace-view-toggle
  font-size 12px
  color colors-ui-text-primary-active
  cursor pointer
  padding 3px 8px
  border-radius 4px
  transition background-color 0.15s ease

  &:hover
    background-color LIST_HOVER_BG

// --- Summary bar ---

.agent-workspace-summary
  display flex
  align-items center
  gap 16px
  padding 4px 16px
  background-color colors-ui-surface-base-panel
  border-bottom 1px solid colors-ui-border-secondary
  flex-shrink 0
  font-size 12px
  color colors-ui-text-primary-label-subtle

.agent-workspace-summary-item
  white-space nowrap

.agent-workspace-overlay-toggle
  margin-left auto
  cursor pointer
  color colors-ui-text-primary-active
  font-size 11px
  padding 2px 6px
  border-radius 3px
  transition background-color 0.15s ease

  &:hover
    background-color LIST_HOVER_BG

// --- Body (two-panel layout) ---

.agent-workspace-body
  display flex
  flex 1
  overflow hidden

.agent-workspace-empty
  padding 24px
  font-size 14px
  color colors-ui-text-primary-label-subtle
  text-align center

// --- File list sidebar ---

.agent-workspace-file-list
  width 240px
  min-width 180px
  overflow-y auto
  border-right 1px solid colors-ui-border-secondary
  background-color colors-ui-surface-primary-default
  flex-shrink 0

.agent-workspace-file-item
  padding 6px 12px
  cursor pointer
  border-bottom 1px solid colors-ui-border-tertiary
  transition background-color 0.15s ease

  // The list hover (LIST_HOVER_BG, button.styl).
  &:hover
    background-color LIST_HOVER_BG

  &.selected
    background-color colors-ui-surface-primary-secondary-hover

.agent-workspace-file-name
  font-size 13px
  color colors-ui-text-primary-body
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.agent-workspace-file-path
  font-size 11px
  color colors-ui-text-primary-label-subtle
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  margin-top 2px

.agent-workspace-coverage-badge
  display inline-block
  margin-top 2px
  font-size 11px
  color colors-ui-text-primary-label-subtle
  background-color colors-ui-surface-primary-secondary
  padding 1px 6px
  border-radius 3px

.agent-workspace-flow-badge
  display inline-block
  margin-top 2px
  margin-left 6px
  font-size 10px
  color rgba(0, 180, 0, 0.8)
  background-color rgba(0, 180, 0, 0.1)
  padding 1px 4px
  border-radius 3px

// --- Editor area ---

.agent-workspace-editor-area
  flex 1
  display flex
  flex-direction column
  min-width 0
  overflow hidden

.agent-workspace-editor
  flex 1
  min-height 0

// --- Coverage line highlighting (Monaco decorations) ---
//
// Applied by ``ui/agent_workspace.nim``'s ``deltaDecorations`` call when the
// agent runtime reports which lines of a workspace file were executed and
// which were not reachable.  The class names keep their ``deepreview-``
// prefix because they are what the component emits and what
// ``tests/agentic-coding/page-objects/agentic-page.ts`` locates; the rules
// moved here from the deleted ``components/deepreview.styl`` (DR-R8), where
// they sat next to the standalone review panel that used to share them.
// This component is now their only consumer.

.deepreview-line-executed
  background-color rgba(0, 180, 0, 0.08)
  border-left 3px solid rgba(0, 200, 0, 0.5)

.deepreview-line-unreachable
  background-color rgba(220, 0, 0, 0.08)
  border-left 3px solid rgba(220, 0, 0, 0.5)
