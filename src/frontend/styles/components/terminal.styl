.future
  // Lines after the current point, dimmed by the opacity below: white on the
  // dark terminal, body text on the light one (`by-mode`, defaults.styl).
  color: by-mode(white, colors-ui-text-primary-body)
  opacity: 0.5

.line-before, .line-before-or-on
  color: colors-ui-text-primary-body
  opacity: 1.0

.line-after
  color: TERMINAL_LESS_VISIBLE_COLOR
  opacity: 0.7

.terminal
  color: colors-ui-text-primary-body
  height: 100%
  if IS_EXTENSION
    overflow: auto

  .terminal-line
    cursor: pointer
    padding-left: 0.5em
    color: colors-ui-text-primary-body
    // font-weight: bold
    // font-family: monospace, monospace
    display: flex
    // font-size: 14px
    font-family: "SpaceMono" !important

  pre
    color: colors-ui-text-primary-body
    height: 100% // it seems to help with scroll on overflow

.terminal-output, .terminal-input
  background-color: transparent
  // Caption text in the light theme (`by-mode`, defaults.styl).
  color: by-mode(#ABABAB, colors-ui-text-primary-caption)
  word-wrap: break-all
  white-space: pre-line
  cursor: pointer
