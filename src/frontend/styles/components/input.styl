@import "../generated/index"

input
  font-family: "SpaceGrotesk" !important
  font-size: 0.875rem !important
  padding: 0.25em 0.75em 0.25em 0.75em
  outline: none
  color: colors-ui-text-primary-label !important

  &:hover
    color: colors-ui-text-primary-body !important

  &:focus
    outline: none !important

  &:focus-visible
    outline: none !important
    box-shadow: inset 0 0 0 0.125rem colors-ui-border-focus !important
    color: colors-ui-text-primary-body !important

  &:not(:placeholder-shown):not(:disabled)
    border-color: colors-ui-border-action
    background: colors-ui-surface-input-default
    color: colors-ui-text-primary-body !important

  // `colors-ui-text-primary-disabled` AND NOT `colors-ui-text-disabled-default`,
  // which is what this said and which is not a token — so the declaration was
  // dropped and a disabled input's text stayed at the enabled `#c8c8c8` set
  // above, on the disabled background. Nothing marked it as disabled but the
  // cursor.
  //
  // #727272 on #282828 is 3.06:1. Below the 4.5:1 of WCAG 1.4.3, and
  // deliberately so: 1.4.3 exempts text that is part of an inactive component,
  // and being visibly dimmer than live text is the whole signal here.
  &:disabled
    border: 0.0625rem solid colors-ui-border-disabled
    background: colors-ui-surface-primary-disabled
    color: colors-ui-text-primary-disabled !important
    pointer-events: none
    cursor: not-allowed

  // `colors-ui-text-primary-label-subtle` — #919191, which is 4.68:1 on the
  // lightest surface an empty input sits on (#282828, the form and command
  // palette fields) and 5.79:1 on the darkest (#151515, the search fields).
  // The name this rule carried, `colors-ui-text-default-placeholder`, resolved
  // to nothing, so every placeholder in the app painted in the enabled input
  // colour and read as typed text.
  //
  // The subtler `colors-ui-text-primary-caption-subtle` was the other
  // candidate and is rejected on measurement: #727272 gives 3.06:1 on
  // #282828, which is disabled-text contrast for text a user is meant to read.
  &::placeholder
    color: colors-ui-text-primary-label-subtle

  &:hover::placeholder,
  &:focus-visible::placeholder,
  &:not(:placeholder-shown):not(:disabled)::placeholder
    color: colors-ui-text-primary-body

  &:disabled::placeholder
    color: colors-ui-text-primary-disabled !important


.ct-input-search-image
  padding-left: 1.875em !important
  background-image: ct-images-empty-search-icon !important
  background-repeat: no-repeat !important
  background-position: 0.5em center !important
  background-size: 1em !important

  &:hover,
  &:focus-visible,
  &:not(:placeholder-shown):not(:disabled)
    background-image: ct-images-default-search-icon !important

  &:disabled
    background-image: ct-images-disabled-search-icon !important


.ct-input-form
  height: 2.25rem
  max-height: 2.25rem
  border-radius: 0.375rem
  background: colors-ui-surface-primary-secondary
  border: 0.0625rem solid colors-ui-surface-primary-secondary

  &:hover
    border-color: colors-ui-border-primary-hover


.ct-input-com-pal
  height: 1.75rem
  max-height: 1.75rem
  width: -webkit-fill-available
  max-width: -webkit-fill-available
  border-radius: 0.375rem
  border: 0.0625rem solid colors-ui-border-primary
  background: colors-ui-surface-primary-secondary

  &:hover
    border-color: colors-ui-border-primary-hover
    color: colors-ui-text-primary-body


.ct-input-small
.ct-input-panel
  border-radius: 0.375rem
  background: colors-ui-surface-primary-default

  &:hover
    border: 0.0625rem solid colors-ui-surface-primary-default
    border-color: colors-ui-border-primary-hover
    color: colors-ui-text-primary-body


// Field borders are 0.0625rem — 1px at the 16px root — not the 0.5px they used
// to be, and `rem` so the resting width and the `:hover` width cannot disagree.
//
// 0.5px is exactly one device pixel at DPR 2, which is crisp only while the edge
// it paints lands on the device grid. Golden Layout sizes stacks proportionally,
// so a panel is routinely a fractional number of pixels wide; `.ct-input-panel`
// is `width: -webkit-fill-available` and inherits that fraction, leaving its
// right edge off-grid while the left stays on it. The border was then spread
// across two device pixels at partial opacity and read as thinner on that side
// alone. `SELECTED_PANEL_BORDER` in golden_layout.styl carries the same note.
.ct-input-small
  height: 1.5rem
  max-height: 1.75rem
  border: 0.0625rem solid transparent

.ct-input-panel
  width: -webkit-fill-available
  height: 1.75rem
  max-height: 1.75rem
  border: 0.0625rem solid transparent
