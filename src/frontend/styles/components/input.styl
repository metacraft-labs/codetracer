@import "../generated/index"

// Input heights — the shared control scale (CONTROL_HEIGHT_*, button.styl), so a
// field and the button beside it are the same height, and a field's height
// says what kind of field it is:
//
//   extra large  34px  form fields on the welcome screens
//   large        28px  the command prompt, the app's primary field
//   medium       26px  every field inside a panel: search, filter, watch
//   small        24px  `.ct-input-small`
//   extra small  20px  compact inline fields, e.g. the event log's Rows
//
// Use these names rather than a literal: a field sized in `em` follows its own
// text size and lands wherever that puts it (the Requests search was 24.5px),
// and a literal repeated in several files drifts one file at a time.  `rem`
// keeps each a whole pixel at the 16px root, wherever the field sits.
INPUT_HEIGHT_XL = CONTROL_HEIGHT_XL
INPUT_HEIGHT_LG = CONTROL_HEIGHT_LG
INPUT_HEIGHT_MD = CONTROL_HEIGHT_MD
INPUT_HEIGHT_SM = CONTROL_HEIGHT_SM
INPUT_HEIGHT_XS = CONTROL_HEIGHT_XS

input
  font-family: "SpaceGrotesk" !important
  font-size: 0.875rem !important
  padding: 0.25em 0.75em 0.25em 0.75em
  outline: none
  color: colors-ui-text-primary-label !important

  &:hover
    color: colors-ui-text-primary-body !important

  // Active — the field has focus.  The same state as the Event Log filter
  // button while its menu is open (`#category-image.open`, button.styl): a
  // 1px `border/action` border and nothing else, so the 2px inset ring this
  // used to draw is gone.  `:focus` as well as `:focus-visible`, because a
  // field is active however it was entered.  `!important` so hovering an
  // active field keeps it indigo, as the button does: every field variant sets
  // its hover grey at a higher specificity than this.
  &:focus,
  &:focus-visible
    outline: none !important
    box-shadow: none !important
    border-color: colors-ui-border-action !important
    color: colors-ui-text-primary-body !important

  &:not(:placeholder-shown):not(:disabled)
    border-color: colors-ui-border-action
    background: colors-ui-surface-input-secondary
    color: colors-ui-text-primary-body !important

  // `colors-ui-text-primary-disabled` AND NOT `colors-ui-text-disabled-default`,
  // which is what this said and which is not a token — so the declaration was
  // dropped and a disabled input's text stayed at the enabled `#c8c8c8` set
  // above, on the disabled background. Nothing marked it as disabled but the
  // cursor.
  //
  // #727272 on #282828 is 3.06:1. Below the 4.5:1 of WCAG 1.4.3, and
  // deliberately so: 1.4.3 exempts text that is part of an inactive component,
  // and being visibly dimmer than live text is the whole signal here.
  &:disabled
    border: 0.0625rem solid colors-ui-border-disabled
    background: colors-ui-surface-primary-disabled
    color: colors-ui-text-primary-disabled !important
    pointer-events: none
    cursor: not-allowed

  // `colors-ui-text-primary-label-subtle` — #919191, which is 4.68:1 on the
  // lightest surface an empty input sits on (#282828, the form and command
  // palette fields) and 5.79:1 on the darkest (#151515, the search fields).
  // The name this rule carried, `colors-ui-text-default-placeholder`, resolved
  // to nothing, so every placeholder in the app painted in the enabled input
  // colour and read as typed text.
  //
  // The subtler `colors-ui-text-primary-caption-subtle` was the other
  // candidate and is rejected on measurement: #727272 gives 3.06:1 on
  // #282828, which is disabled-text contrast for text a user is meant to read.
  &::placeholder
    color: colors-ui-text-primary-label-subtle

  &:hover::placeholder,
  &:focus-visible::placeholder,
  &:not(:placeholder-shown):not(:disabled)::placeholder
    color: colors-ui-text-primary-body

  &:disabled::placeholder
    color: colors-ui-text-primary-disabled !important


// The magnifier: the Design System's `icons-lg=search` (Figma icons page,
// node 192:11871), built here as an SVG in the theme's own token colour.  A
// field cannot hold a `::before`, so it cannot use a mask painted in its text
// colour like the buttons (D-38); a background built from the token is the
// equivalent.  It used to be three fixed-colour files that the light theme
// borrowed from the dark one, so on hover, focus and with text in the field the
// light theme drew a near-white #F3F3F3 magnifier on its near-white field (D-39).
SEARCH_ICON_PATH = "M7.27637 1.92871C10.2298 1.92892 12.625 4.32357 12.625 7.27734C12.6249 8.57408 12.1624 9.76261 11.3945 10.6885L13.7471 13.042L14.1006 13.3955L13.3936 14.1025L13.04 13.749L10.6875 11.3955C9.76159 12.1633 8.57302 12.6259 7.27637 12.626C4.323 12.6258 1.92897 10.231 1.92871 7.27734C1.92875 4.32354 4.32286 1.92887 7.27637 1.92871ZM7.27637 2.92871C4.87529 2.92887 2.92875 4.87568 2.92871 7.27734C2.92897 9.67882 4.87543 11.6258 7.27637 11.626C9.67726 11.6258 11.6247 9.67879 11.625 7.27734C11.625 4.87571 9.6774 2.92892 7.27637 2.92871Z"

search-icon(color)
  hex = replace('#', '%23', '' + color)
  svg = "<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 16 16'><path d='" + SEARCH_ICON_PATH + "' fill='" + hex + "'/></svg>"
  unquote('url("data:image/svg+xml;utf8,' + svg + '")')

.ct-input-search-image
  padding-left: 1.875em !important
  // At rest the magnifier is the placeholder's colour; live, the text's.
  background-image: search-icon(colors-ui-text-primary-label-subtle) !important
  background-repeat: no-repeat !important
  background-position: 0.375rem center !important
  background-size: 1rem !important

  &:hover,
  &:focus-visible,
  &:not(:placeholder-shown):not(:disabled)
    background-image: search-icon(colors-ui-text-primary-body) !important

  &:disabled
    background-image: search-icon(colors-ui-text-primary-disabled) !important


// Welcome-screen form fields: the extra-large input size (34px; was 36px, off
// the scale).
.ct-input-form
  height: INPUT_HEIGHT_XL
  max-height: INPUT_HEIGHT_XL
  border-radius: 0.375rem
  background: colors-ui-surface-primary-secondary
  border: CONTROL_BORDER_WIDTH solid CONTROL_BORDER_COLOR

  // The backend dropdown: the 14px of the fields beside it (`input` above), and
  // D-26's row size, since the browser's list follows the <select>.
  select&
    font-size: 0.875rem

  &:hover
    border-color: colors-ui-border-primary-hover


.ct-input-com-pal
  height: INPUT_HEIGHT_LG
  max-height: INPUT_HEIGHT_LG
  width: -moz-available
  width: -webkit-fill-available
  width: stretch
  max-width: -moz-available
  max-width: -webkit-fill-available
  max-width: stretch
  border-radius: 0.375rem
  border: CONTROL_BORDER_WIDTH solid CONTROL_BORDER_COLOR
  background: colors-ui-surface-primary-secondary

  &:hover
    border-color: colors-ui-border-primary-hover
    color: colors-ui-text-primary-body


.ct-input-small
.ct-input-panel
  border-radius: 0.375rem
  background: colors-ui-surface-input-secondary

  &:hover
    border: 0.0625rem solid colors-ui-surface-primary-default
    border-color: colors-ui-border-primary-hover
    color: colors-ui-text-primary-body


// Field borders are 0.0625rem — 1px at the 16px root — not the 0.5px they used
// to be, and `rem` so the resting width and the `:hover` width cannot disagree.
//
// 0.5px is exactly one device pixel at DPR 2, which is crisp only while the edge
// it paints lands on the device grid. Golden Layout sizes stacks proportionally,
// so a panel is routinely a fractional number of pixels wide; `.ct-input-panel`
// is `width: -webkit-fill-available` and inherits that fraction, leaving its
// right edge off-grid while the left stays on it. The border was then spread
// across two device pixels at partial opacity and read as thinner on that side
// alone. `SELECTED_PANEL_BORDER` in golden_layout.styl carries the same note.
.ct-input-small
  height: INPUT_HEIGHT_SM
  max-height: INPUT_HEIGHT_SM
  border: CONTROL_BORDER_WIDTH solid CONTROL_BORDER_COLOR

.ct-input-panel
  width: -moz-available
  width: -webkit-fill-available
  width: stretch
  height: INPUT_HEIGHT_MD
  max-height: INPUT_HEIGHT_MD
  border: CONTROL_BORDER_WIDTH solid CONTROL_BORDER_COLOR
