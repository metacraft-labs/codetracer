// BP-M4: Problems panel styles
// Matches the dark theme of existing CodeTracer panels.

.problems-panel
  display: flex
  flex-direction: column
  height: 100%
  overflow: hidden
  color: colors-ui-text-primary-body
  font-size: 0.8125rem
  font-family: "SpaceGrotesk"
  background: colors-ui-surface-base-panel

// No top inset for Problems.  Every other panel opens with a row of controls
// and gets PANEL_INSET (8px, button.styl) above it; Problems opens with a
// header band — a full-width strip with its own background — which reads as
// the panel's top edge, so it sits flush against that edge instead:
//   * docked: right under the 4px resize handle (DOCK_BOTTOM_HANDLE_SIZE,
//     auto_hide.styl — imported ahead of this file);
//   * previewed on hover, and in the layout: at the top of the body.
// Each container only ever holds the panel it is showing, so `:has()` here
// cannot catch another panel.
#auto-hide-docked-bottom-content:has(.problems-panel)
  padding-top: DOCK_BOTTOM_HANDLE_SIZE

#auto-hide-overlay-content:has(.problems-panel),
.lm_content:has(.problems-panel)
  padding-top: 0

// -- Header bar --

.problems-header
  display: flex
  align-items: center
  justify-content: space-between
  // Content at the panel inset (PANEL_INSET, 8px, button.styl); the band runs
  // edge to edge.  6px above the counts and filters, 4px below: the band sits
  // flush against the panel's top edge (see the top of this file), so its own
  // top padding is the only room its contents get there.
  padding: 0.375rem PANEL_INSET 0.25rem
  border-bottom: 0.0625rem solid colors-ui-surface-input-default
  background: colors-ui-surface-primary-tertiary
  flex-shrink: 0
  user-select: none

.problems-counts
  display: flex
  align-items: center
  gap: 0.75rem

.problems-count-badge
  font-size: 0.75rem
  opacity: 0.8

.problems-count-error
  color: #f85149

.problems-count-warning
  // GitHub-dark's amber, 2.3:1 on the light ground: the warning text token
  // there (`by-mode`, defaults.styl).
  color: by-mode(#d29922, colors-ui-text-warning-primary)

// -- Filter / control buttons --

.problems-controls
  display: flex
  align-items: center
  gap: 0.25rem

.problems-filter-btn
  // The small control size (button.styl), the height of the count badges on
  // the same bar; the height was padding around the label, 28px.
  display: inline-flex
  align-items: center
  height: CONTROL_HEIGHT_SM
  box-sizing: border-box
  padding: 0 0.5rem
  border-radius: CONTROL_RADIUS
  font-size: 0.75rem
  // The button look (button.styl); the selected filter is its active state.
  control-button()
  &:hover
    control-button-hover()
  &.active
    control-button-active()

// -- Problem list --

.problems-list
  flex: 1
  overflow-y: auto
  overflow-x: hidden

.problems-empty
  padding: 1rem 0.625rem
  opacity: 0.6

// -- Individual problem row --

.problems-row
  display: flex
  align-items: baseline
  gap: 0.5rem
  padding: 0.1875rem PANEL_INSET
  white-space: nowrap
  border-bottom: 0.0625rem solid colors-ui-border-secondary
  // The list hover (LIST_HOVER_BG, button.styl).
  &:hover
    background: LIST_HOVER_BG

// The row `next error` / `previous error` has moved to, and the row a failed
// build highlights.
//
// WITHOUT THIS RULE THE SELECTION IS INVISIBLE. The view has always been able
// to add a class; nothing styled it, so a user pressing "next error" would see
// the caret move and the Problems list look identical — which is the
// "selecting without showing it" half of the confusion EMT-D22.5 is about.
//
// A left border as well as a background, because the background alone is
// nearly the hover colour and the two states must be distinguishable while the
// pointer is over the list.
.problems-row-selected
  background: colors-ui-surface-primary-secondary-hover
  box-shadow: inset 0.1875em 0 0 colors-ui-surface-action-primary
  &:hover
    background: colors-ui-surface-primary-secondary-hover

// What navigation announced -- "error 2 of 5", "wrapped to first error",
// "no errors". Sits in the header beside the counts.
//
// The repo has no status bar (the only `setStatus` in the tree is the LSP
// client's private one), so the announcement is painted in the pane it is
// about. Empty until something is announced, which is why there is no
// reserved height here: an always-present empty element would push the filter
// buttons around for no reason.
.problems-status
  margin-left: 0.625rem
  font-size: 0.6875rem
  opacity: 0.75
  font-style: italic
  white-space: nowrap
  overflow: hidden
  text-overflow: ellipsis

.problems-icon
  flex-shrink: 0
  width: 1rem
  text-align: center
  font-size: 0.75rem

.problems-icon-error
  color: #f85149

// The severity glyphs and the dimmed path text were written for the dark
// ground; the light theme takes the icon and caption tokens (`by-mode`, defaults.styl).
.problems-icon-warning
  color: by-mode(#d29922, colors-ui-icon-warning-primary)

.problems-icon-info
  color: by-mode(#58a6ff, colors-ui-icon-information-primary)

.problems-path
  color: by-mode(#8b949e, colors-ui-text-primary-caption)
  flex-shrink: 1
  overflow: hidden
  text-overflow: ellipsis
  font-size: 0.75rem

.problems-location
  color: by-mode(#8b949e, colors-ui-text-primary-caption)
  flex-shrink: 0
  font-size: 0.75rem

.problems-message
  flex: 1
  overflow: hidden
  text-overflow: ellipsis
  color: colors-ui-text-primary-body

// -- Grouped-by-file mode --

.problems-grouped
  // no additional wrapper styles needed
  display: block

.problems-file-group
  margin-bottom: 0.125rem

.problems-file-header
  padding: 0.25rem PANEL_INSET
  font-weight: 600
  font-size: 0.75rem
  // Caption text, and a hairline that is about `border/tertiary` over the
  // dark panel: those tokens in the light theme (`by-mode`, defaults.styl).
  color: by-mode(#8b949e, colors-ui-text-primary-caption)
  background: rgba(255, 255, 255, 0.03)
  border-bottom: 0.0625rem solid by-mode(rgba(255, 255, 255, 0.05), colors-ui-border-tertiary)

// Severity-tinted left border for quick scanning
.problems-severity-error
  border-left: 0.1875rem solid #f85149

// In the light theme the severity icon tokens, as the glyphs above.
.problems-severity-warning
  border-left: 0.1875rem solid by-mode(#d29922, colors-ui-icon-warning-primary)

.problems-severity-info
  border-left: 0.1875rem solid by-mode(#58a6ff, colors-ui-icon-information-primary)

// Build-Output-Pane.md §3.9: a build diagnostic's icon in the editor's
// gutter — the most severe one on the line, in the Problems pane's colours,
// in the gutter's pointer lane (the lane the current-line arrow and the
// run-test control use: an editor being built has no execution, and the
// Problems pane's icons are the ones a reader already knows). Put there by
// `ui/build.refreshBuildEditorMarks` as a Monaco margin decoration; the
// squiggles and the hover are Monaco's own markers.
.build-diagnostic-margin
  position: relative
  &:before
    position: absolute
    top: 0
    left: 0
    width: var(--ct-gutter-pointer-lane, 0.75em)
    height: 100%
    display: flex
    align-items: center
    justify-content: center
    font-size: 0.7em
    z-index: 3
    pointer-events: none

.build-diagnostic-margin-error:before
  content: "\25cf"
  color: #f85149

.build-diagnostic-margin-warning:before
  content: "\26a0"
  color: #d29922

.build-diagnostic-margin-info:before
  content: "\24d8"
  color: #58a6ff
