  // violet (`by-mode`, defaults.styl).
  color: by-mode(colors-editor-action-primary, colors-editor-syntax-number)
  background: colors-ui-surface-primary-secondary
  border-radius: 0.25em
  padding: 0.05em 0.25em
  font-size: 0.875em

// Inside the highlight overlay the inline-code span must NOT change padding or
// font-size — those shift the overlay text relative to the textarea, causing
// the cursor (which the textarea owns) to appear at the wrong position.
// Color-only styling is safe; layout properties are not.
.agent-input-highlight .agent-inline-code
  padding: 0 !important
  font-size: inherit !important
  font-family: inherit !important

