// Every control in the prompt toolbar — icon buttons, the branch and model
// buttons, send — is this tall, with these corners (see "Prompt toolbar: one
// size, one corner" at the end of this file); the menus, the message field and
// the prompt area share the corners.  28px, 6px (Nikolay, 2026-10-11: 8px → 6px,
// the app's control radius, CONTROL_RADIUS in button.styl).
AGENT_TOOLBAR_CONTROL_SIZE = 1.75rem
AGENT_TOOLBAR_CONTROL_RADIUS = 0.375rem

