  padding: 0.5em 0.75em
  border-top: 1px solid colors-ui-border-secondary
  cursor: pointer
  user-select: none

  &:hover
    background: colors-ui-surface-primary-secondary-hover

    .agent-diff-file-path
      color: colors-ui-text-primary-body

.agent-diff-file-path
  flex: 1
  font-size: 0.8125rem
  color: colors-ui-text-primary-body-subtle
  overflow: hidden
  text-overflow: ellipsis
  white-space: nowrap

.agent-diff-stat-added
  font-size: 0.8125rem
  font-weight: 600
  color: colors-ui-icon-success-primary
  flex-shrink: 0

.agent-diff-stat-removed
  font-size: 0.8125rem
  font-weight: 600
  color: colors-ui-icon-error-primary
  flex-shrink: 0

.agent-diff-open-icon
  width: 11px
  height: 13px
  background-image: url("data:image/svg+xml,%3Csvg width='11' height='13' viewBox='0 0 11 13' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0.5 2.57324C0.776004 2.57324 0.999775 2.79729 1 3.07324V9.65234C1.0002 10.4803 1.67147 11.1503 2.5 11.1504H7.09766C7.37351 11.1504 7.59718 11.3747 7.59766 11.6504C7.59766 11.9265 7.3738 12.1504 7.09766 12.1504H2.5C1.11978 12.1503 0.000204816 11.0331 0 9.65234V3.07324C0.000224474 2.79734 0.224065 2.57332 0.5 2.57324ZM7.69629 0.00878906C7.78876 0.0266271 7.87584 0.071257 7.94531 0.136719L10.7393 2.77539C10.8392 2.86976 10.8954 3.00222 10.8955 3.13965V8.85742C10.8955 9.23267 10.7379 9.58654 10.4668 9.84277C10.1965 10.098 9.8354 10.2372 9.46484 10.2373H3.41016C3.0396 10.2372 2.67844 10.098 2.4082 9.84277C2.13723 9.58655 1.97852 9.2326 1.97852 8.85742V1.37988C1.97862 1.00464 2.13706 0.650698 2.4082 0.394531C2.67844 0.139294 3.0396 0.000119562 3.41016 0H7.60156L7.69629 0.00878906ZM3.41016 1C3.28703 1.00012 3.17363 1.04661 3.09473 1.12109C3.01684 1.19469 2.97862 1.28882 2.97852 1.37988V8.85742C2.97852 8.94846 3.01698 9.04256 3.09473 9.11621C3.17363 9.19073 3.287 9.23718 3.41016 9.2373H9.46484C9.58789 9.23721 9.70038 9.19059 9.7793 9.11621C9.85734 9.0425 9.89551 8.94863 9.89551 8.85742V3.35352L7.40234 1H3.41016ZM6.93945 4.55273H8.41895V5.55273H6.93945V7.03223H5.93945V5.55273H4.45996V4.55273H5.93945V3.07324H6.93945V4.55273Z' fill='%23DDDDDD'/%3E%3C/svg%3E")
  background-repeat: no-repeat
  background-size: contain
  flex-shrink: 0
  opacity: 0.7

.agent-diff-file-row:hover .agent-diff-open-icon
  opacity: 1

.agent-diff-editor-wrapper
  display: none

.agent-diff-editor-wrapper.agent-diff-editor-visible
  display: block

// Tool calls section — rendered inside the agent thought block
.agent-tc-section
  margin-top: 0.625em
  display: flex
  flex-direction: column
  gap: 0.25em

// History rows: hidden by default, shown when .agent-tc-history-expanded is toggled
.agent-tc-history
  display: none
  flex-direction: column
  gap: 0.25em

  &.agent-tc-history-expanded
    display: flex

// Toggle button showing how many tools were used; click expands history
.agent-tc-toggle
  display: flex
  align-items: center
  gap: 0.375em
  padding: 0.25em 0.5em
  cursor: pointer
  user-select: none
  color: colors-ui-text-primary-body-subtle
  font-size: 0.75rem

  &:hover
    color: colors-ui-text-primary-body

.agent-tc-toggle-icon
  width: 10px
  height: 10px
  flex-shrink: 0
  opacity: 0.6
  background-image: url("data:image/svg+xml,%3Csvg width='10' height='10' viewBox='0 0 10 10' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M5 2L9 6H1L5 2Z' fill='%23888'/%3E%3C/svg%3E")
  background-repeat: no-repeat
  background-position: center
  background-size: contain

.agent-tc-history-expanded ~ .agent-tc-toggle .agent-tc-toggle-icon
  background-image: url("data:image/svg+xml,%3Csvg width='10' height='10' viewBox='0 0 10 10' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M5 8L1 4H9L5 8Z' fill='%23888'/%3E%3C/svg%3E")

// Individual tool call row
.agent-tc-row
  display: flex
  align-items: center
  gap: 0.625em
  padding: 0.5em 0.75em
  border-radius: 0.375em
  background: colors-ui-surface-primary-tertiary

.agent-tc-row-current
  // No extra style needed; kept for selector specificity if needed

// Expanded state: full tool name wraps instead of truncating with ellipsis
.agent-tc-row-expanded
  align-items: flex-start

  .agent-tc-name
    white-space: normal
    overflow: visible
    text-overflow: unset

  .agent-tc-icon
    transform: rotate(0deg)
    margin-top: 0.2em

// Chevron icon (left side of each row) — same icon as model/branch arrow buttons.
// Default: rotate -90deg so it points right (collapsed). When expanded: 0deg (down).
.agent-tc-icon
  width: 1.25em
  height: 1.25em
  flex-shrink: 0
  cursor: pointer
  opacity: 0.65
  transition: transform 0.15s ease
  transform: rotate(-90deg)
  background-image: COMMAND_PALETTE_ARROW_IMG
  background-repeat: no-repeat
  background-size: 0.5625em 0.375em
  background-position: center

  &:hover
    opacity: 0.9

// Tool name — monospace, truncated
.agent-tc-name
  flex: 1
  font-family: monospace
  font-size: 0.8125rem
  color: colors-ui-text-primary-body-subtle
  overflow: hidden
  text-overflow: ellipsis
  white-space: nowrap

// Status dot (right side)
.agent-tc-dot
  width: 10px
  height: 10px
  border-radius: 50%
  flex-shrink: 0
  align-self: center

.agent-tc-dot-running
  background: colors-ui-icon-warning-primary
  animation: agent-tc-pulse 1.2s ease-in-out infinite

.agent-tc-dot-done
  background: colors-ui-icon-success-primary

.agent-tc-dot-failed
  background: colors-ui-icon-error-primary

@keyframes agent-tc-pulse
  0%, 100%
    opacity: 1
  50%
    opacity: 0.35

.component-wrapper
  background: colors-ui-surface-base-panel
  border-radius: 0.25em
  margin: 0.5em
  color: colors-ui-text-primary-body

  .header-wrapper
    background: colors-ui-surface-base-canvas
    border-top-right-radius: 0.375em
    border-top-left-radius: 0.375em
    border-bottom: 0 !important

.editor-wrapper
  height: 100%
  margin-top: 0.5em

.agent-editor
  min-height: 15.625em
  max-height: 15.625em
  height: 15.625em

  .line-numbers
    height: 100%

.agent-interaction
  background: colors-ui-surface-base-canvas
  border-radius: 0.5em
  padding: 0.5em
  flex: 0 0 auto

.prompt-wrapper
  background: colors-ui-surface-base-canvas
  border-radius: 0.375em
  display: flex
  flex-direction: column
  margin-top: 0.5em
  margin-bottom: 0.5em
  padding: 0.75em

  .password-wrapper
    display: flex
    flex-wrap: wrap
    align-items: center
    gap: 0.5em

    .password-prompt-input
      flex: 1 1 12em
      background-image: none !important
      margin-left: 0 !important
      margin-bottom: 0 !important
      padding-left: 0.5em !important
      background: #2C2C2C

    .password-continue-button
      flex: 0 0 auto !important

  .header-wrapper
    border-bottom: 0 !important
    padding: 0 0 1em 0 !important

  .user-options-wrapper
    display: flex
    flex-direction: row
    flex-wrap: wrap
    gap: 0.5em

    .user-option
      flex: 0 0 auto !important

.permission-prompt
  background: colors-ui-surface-primary-default
  border: 1px solid colors-ui-border-error
  border-radius: 0.25em
  display: flex
  flex-direction: column
  gap: 0.5em
  margin-top: 0.5em
  margin-bottom: 0.5em
  padding: 0.75em

  .permission-header
    display: flex
    flex-direction: row
    align-items: center
    gap: 0.375em

  .permission-dot
    background-image: AGENT_PERMISSION_DOT_IMG
    background-repeat: no-repeat
    background-size: contain
    background-position: center
    width: 0.4375rem
    height: 0.4375rem
    flex-shrink: 0

  .permission-action-label
    font-size: 0.875rem
    font-weight: 500
    color: colors-red-400

  .permission-description
    font-size: 0.875rem
    color: colors-ui-text-primary-default
    line-height: 1.4

  .permission-subtitle
    font-size: 0.75rem
    color: colors-ui-icon-primary-subtle
    line-height: 1.4

  .permission-buttons
    display: flex
    flex-direction: row
    flex-wrap: wrap
    gap: 0.5em
    margin-top: 0.25em

    button
      flex: 0 0 auto !importantimportant

.ai-status
  background-image: AI_LOADING_ANIMATION
  background-position-y: 70%
  background-size: 0.75em 0.75em
  width: 1.75em
  height: 1.75em
  background-repeat: no-repeat

// Final text summary shown outside the collapsed thought block when done.
// Hidden when the user expands the block (via agent-final-message-hidden toggle).
.agent-final-message
  padding: 0.25em 0.5em 0.375em
  white-space: pre-wrap
  word-break: break-word
  color: colors-ui-text-primary-body
  font-size: 0.875rem
  line-height: 1.5

.agent-final-message-hidden
  display: none !important

// "... Agent is working" indicator shown below message content while the agent
// is still producing output after the thinking phase ended.
.agent-working-indicator
  display: flex
  flex-direction: row
  align-items: center
  gap: 0.25em
  padding: 0.375em 0.5em 0.25em
  color: colors-ui-text-primary-body-subtle
  font-size: 0.8125rem

  .ai-status
    width: 1.25em
    height: 1.25em
    background-size: 0.625em 0.625em

// ---------------------------------------------------------------------------
// Empty prompt — idle state (shown when the conversation has no messages yet)
// ---------------------------------------------------------------------------

.agent-idle-state
  display: flex
  flex-direction: column
  align-items: center
  justify-content: center
  height: 100%
  padding: 1.5em 1em
  gap: 1.25em
  text-align: center

.agent-idle-header
  display: flex
  flex-direction: column
  align-items: center
  gap: 0.5em

.agent-idle-heading
  font-size: 1.25em
  font-weight: 600
  color: colors-ui-text-primary-headings
  font-family: "SpaceGrotesk", sans-serif
  line-height: 1.3

.agent-idle-subtitle
  font-size: 0.9em
  color: colors-ui-text-primary-caption
  line-height: 1.5

.agent-idle-suggestions
  display: flex
  flex-wrap: wrap
  gap: 0.5em
  justify-content: center

.agent-idle-chip
  background: colors-ui-surface-input-default
  border: 0.0625em solid colors-ui-border-secondary
  border-radius: 9999px !important
  color: colors-ui-text-primary-body
  font-size: 0.8em
  font-family: inherit
  padding: 0.4em 1em
  cursor: pointer
  transition: background-color 0.15s ease, border-color 0.15s ease
  white-space: nowrap
  line-height: 1.5

  &:hover
    background: colors-ui-surface-primary-secondary
    border-color: colors-ui-border-primary

// Branch context button in the agent toolbar
.agent-branch-wrapper
  position: relative
  flex: 0 1 max-content
  min-width: 2em
  display: flex

.agent-branch-button
  flex: 1 1 auto !important
  min-width: 0 !important
  padding-left: 0.5em !important

  .agent-model-img
    margin-left: auto
    flex-shrink: 0

.agent-branch-label
  display: flex
  align-items: center
  gap: 0.375em
  min-width: 0
  overflow: hidden

.agent-branch-text
  overflow: hidden
  text-overflow: ellipsis
  white-space: nowrap
  min-width: 0

.agent-branch-img
  background-image: AGENT_BRANCH_IMG
  background-size: 0.875em 0.875em
  background-position: center
  background-repeat: no-repeat
  width: 1em
  min-width: 1em
  height: 1em
  flex-shrink: 0

.agent-branch-dropdown
  position: absolute
  top: calc(100% + 0.375em)
  left: 0
  right: 0
  z-index: 100
  dropdown-surface()
  padding: 0.25em
  max-height: 12.5em
  overflow-y: auto

// Settings button in the agent toolbar
