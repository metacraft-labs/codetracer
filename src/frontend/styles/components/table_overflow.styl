// PLAT-70 Part B (Horizontal-Overflow.md §5): THE TABLE PANES TRUNCATE. A
// cell whose text does not fit its column is drawn cut with `…` by the
// browser (`text-overflow: ellipsis`); which cells are cut is the shared
// model's decision, marked `[data-ct-cut]` by `views/table_overflow_dom.nim`,
// and that mark is what takes the hover and the `…` click. The Variables pane
// does not scroll sideways (Variable-State-Pane Decision 3).

[data-ct-cell]
  overflow: hidden
  text-overflow: ellipsis
  white-space: nowrap
  min-width: 0

// PLAT-70 Part I (Horizontal-Overflow.md §5.5.5 — OQ-H5, proposed, awaiting
// the user's confirmation): THE CALL TRACE FITS OR SCROLLS. Each row's call
// box is a table cell ending at the row column's edge (`views/
// table_fit_dom.fitCallTrace` sets its `max-width`); the list scrolls
// sideways only when a row's indent and callee name do not fit. The box is a
// flex row of the call's parts, which `text-overflow` cannot cut, so a cut
// box draws its `…` over its last character: a last flex item stuck to the
// box's right edge (`sticky`, so the box is not made a positioned ancestor —
// the call guides measure their anchors against the row's offset parent).
// The box clips its parts; none of them gives up width to fit it (a shrunk
// toggle would move the call guides' anchor off its centre).
.isonim-calltrace .call-child-box[data-ct-cell] > *
  flex-shrink: 0

.isonim-calltrace .call-child-box[data-ct-cut]::after
  content: "…"
  position: sticky
  right: 0
  flex-shrink: 0
  margin-left: auto
  align-self: stretch
  display: flex
  align-items: center
  padding-left: 0.125em
  background-color: colors-ui-surface-base-panel
  color: colors-ui-text-primary-body

.isonim-calltrace .event-selected .call-child-box[data-ct-cut]::after
  background-color: colors-editor-surface-select

// The Variables pane's value takes what the row has left, and is cut there:
// every box from the row down to the value gives up its content width
// (`min-width: 0`), and the value — otherwise `display: contents`, which
// has no box to cut — is a block that shrinks.
.isonim-state .value-expanded > .value-expanded-atom-parent,
.isonim-state .value-expanded > .value-expanded-compound-parent
  flex: 1 1 auto
  min-width: 0
  max-width: 100%

.isonim-state .value-expanded-atom-parent > div,
.isonim-state .value-expanded-compound-parent > div
  min-width: 0
  flex: 1 1 auto
  overflow: hidden

.isonim-state .value-view
  min-width: 0
  max-width: 100%
  overflow: hidden

.isonim-state .value-view > [data-ct-cell]
  display: block
  position: static
  width: auto
  flex: 0 1 auto

// A cut cell's `…` is its last character: the pointer says it can be pressed
// (Pointer-Affordances: a truncated cell's `…` is `pointer`).
[data-ct-cut]
  cursor: pointer

// PLAT-70 Part I (§5.5): in SCROLL the Event Log's body scrolls sideways and
// its header strip follows it by a translation (`views/table_fit_dom`); the
// table clips the header's part left of the pane.
.eventLog-dense-table[data-ct-fit="scroll"]
  overflow-x: hidden

// The Event Log's column separators: a grip at each header cell's right edge.
.eventLog-column-header > span
  position: relative

.eventLog-column-grip
  position: absolute
  top: 0
  right: 0
  width: 6px
  height: 100%
  cursor: col-resize

// A row's full text, open under it.
.ct-table-detail
  display: block
  white-space: pre
  color: colors-ui-text-primary-body
  font-family: inherit

td > .ct-table-detail-line,
.ct-table-detail > .ct-table-detail-line
  white-space: pre

// The full text of a truncated cell, after the pointer rested on it.
.ct-table-tooltip
  position: fixed
  z-index: 1000
  background-color: colors-ui-surface-base-canvas
  color: colors-ui-text-primary-body
  padding: 0.25em 0.5em
  border-radius: 0.25em
  box-shadow: 0 0.25em 0.5em rgba(0, 0, 0, 0.2)
  font-family: inherit
  white-space: pre
  pointer-events: none
