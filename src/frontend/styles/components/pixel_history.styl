.pixel-history-component
  display: flex
  flex-direction: column
  height: 100%
  width: 100%
  min-height: 0
  box-sizing: border-box
  overflow: hidden
  color: colors-ui-text-primary-body
  background: colors-ui-surface-base-panel
  font-family: "SpaceGrotesk"
  font-size: 0.8125rem
  line-height: 1.25rem

  .pixel-history-header
    display: flex
    align-items: center
    justify-content: space-between
    gap: 0.625rem
    padding: 0.4375rem 0.625rem
    flex: 0 0 auto
    border-bottom: 0.0625rem solid colors-ui-surface-input-default
    background: colors-ui-surface-primary-tertiary

  .pixel-history-title
    font-weight: 600

  .pixel-history-pixel
    color: colors-ui-text-primary-body
    min-width: 0
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap

  .pixel-history-loading,
  .pixel-history-error,
  .pixel-history-empty
    padding: 0.625rem
    color: colors-ui-text-primary-body

    &[display="none"]
      display: none

  .pixel-history-error
    color: colors-ui-text-error-primary

  .pixel-history-list
    min-height: 0
    overflow: auto
    flex: 1 1 auto

  .pixel-history-entry
    display: grid
    grid-template-columns: 1fr
    gap: 0.375rem
    width: 100%
    min-height: 5.25rem
    padding: 0.5rem 0.625rem
    border: 0
    border-bottom: 0.0625rem solid colors-ui-border-secondary
    background: transparent
    color: colors-ui-text-primary-body
    font: inherit
    text-align: left
    cursor: pointer

    &:hover,
    &.selected
      background: colors-ui-surface-primary-secondary-hover

  .pixel-history-entry-main
    display: grid
    grid-template-columns: auto auto 1fr
    gap: 0.5rem
    align-items: center
    min-width: 0

  .pixel-history-draw,
  .pixel-history-geid
    color: colors-ui-text-primary-body

  .pixel-history-pass
    min-width: 0
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap
    color: colors-ui-text-primary-body

  .pixel-history-colors
    display: grid
    grid-template-columns: repeat(3, minmax(0, 1fr))
    gap: 0.375rem
    min-width: 0

  .pixel-history-color
    display: flex
    align-items: center
    gap: 0.3125rem
    min-width: 0

  .pixel-history-swatch
    flex: 0 0 auto
    width: 0.875rem
    height: 0.875rem
    border: 0.0625rem solid colors-ui-border-secondary
    border-radius: 0.1875rem

  .pixel-history-color-label,
  .pixel-history-tests
    min-width: 0
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap
    color: colors-ui-text-primary-body
    font-size: 0.75rem
