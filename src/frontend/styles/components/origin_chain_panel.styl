// Origin Chain side panel (spec
// GUI/Debugging-Features/Value-Origin-Tracking.md §3.2.2 "a side panel
// that opens/closes from the editor zone").
//
// The host element is created in `ui/state.nim::ensureOriginSidePanelHost`
// and appended to `document.body` rather than docked into GoldenLayout,
// so without these rules it renders as an unpositioned block at the very
// top of the document — overlapping the menu bar, which both looks wrong
// and makes its own buttons unclickable because the toolbar sits on top.

#ct-origin-chain-side-panel
  position: fixed
  top: 3em
  right: 0
  bottom: 2em
  width: 24em
  max-width: 40vw
  box-sizing: border-box
  padding: 0.5em
  overflow-y: auto
  z-index: 200
  background-color: colors-ui-surface-base-panel
  border-left: 1px solid colors-ui-border-base
  font-size: 0.85rem

  nav
    display: flex
    flex-wrap: wrap
    gap: 0.25em
    margin-bottom: 0.5em

  ol
    list-style: none
    margin: 0
    padding: 0

  li
    display: flex
    align-items: center
    gap: 0.35em
    padding: 0.2em 0

  button
    cursor: pointer

  footer
    margin-top: 0.5em

.ct-origin-breadcrumb-chip
  padding: 0.1em 0.5em
  border-radius: 0.8em
  border: 1px solid colors-ui-border-base
  background-color: colors-ui-surface-base-raised

  // Zero-hop spans: the chain reached the recording but found nothing
  // further there (see `isPlaceholderSpan`). Shown, because the walk
  // really did get there — but visibly inert, because there is no hop
  // to jump to.
  &.ct-origin-breadcrumb-chip-placeholder
    opacity: 0.45
    font-style: italic
    cursor: default

.ct-origin-cross-process-badge
  padding: 0 0.4em
  border-radius: 0.3em
  font-size: 0.75rem
  background-color: colors-ui-surface-alert-information
  color: colors-ui-text-on-color-body
