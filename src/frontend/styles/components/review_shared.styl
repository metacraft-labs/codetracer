// Shared layout primitives for review-oriented panes.
// Keep selectors in the component files; only centralize repeated rules.

reviewPaneBase()
  display flex
  flex-direction column
  height 100%
  width 100%
  overflow hidden
  font-family "SpaceGrotesk"

reviewHeaderBar()
  display flex
  justify-content space-between
  align-items center
  padding 6px 16px
  background-color colors-ui-surface-base-panel
  border-bottom 1px solid colors-ui-border-secondary
  flex-shrink 0

reviewSidebar(sidebarWidth)
  width sidebarWidth
  min-width 180px
  overflow-y auto
  border-right 1px solid colors-ui-border-secondary
  background-color colors-ui-surface-primary-default
  flex-shrink 0

reviewFileItem()
  padding 6px 12px
  cursor pointer
  border-bottom 1px solid colors-ui-border-tertiary
  transition background-color 0.15s ease

  &:hover
    background-color LIST_HOVER_BG

  &.selected
    background-color colors-ui-surface-primary-secondary-hover

reviewFileName()
  font-size 13px
  color colors-ui-text-primary-body
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

reviewFilePath()
  font-size 11px
  color colors-ui-text-primary-label-subtle
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  margin-top 2px

reviewCoverageBadge()
  display inline-block
  margin-top 2px
  font-size 11px
  color colors-ui-text-primary-label-subtle
  background-color colors-ui-surface-primary-secondary
  padding 1px 6px
  border-radius 3px

reviewEditorArea()
  flex 1
  display flex
  flex-direction column
  min-width 0
  overflow hidden

reviewEditorPane()
  flex 1
  min-height 0
