// Shared layout primitives for review-oriented panes.
// Keep selectors in the component files; only centralize repeated rules.

reviewPaneBase()
  display flex
  flex-direction column
  height 100%
  width 100%
  overflow hidden
  font-family "SpaceGrotesk"

reviewHeaderBar()
  display flex
  justify-content space-between
  align-items center
  padding 0.375rem 1rem
  background-color colors-ui-surface-base-panel
  border-bottom 0.0625rem solid colors-ui-border-secondary
  flex-shrink 0

reviewSidebar(sidebarWidth)
  width sidebarWidth
  min-width 11.25rem
  overflow-y auto
  border-right 0.0625rem solid colors-ui-border-secondary
  background-color colors-ui-surface-primary-default
  flex-shrink 0

reviewFileItem()
  padding 0.375rem 0.75rem
  border-bottom 0.0625rem solid colors-ui-border-tertiary
  transition background-color 0.15s ease

  &:hover
    background-color LIST_HOVER_BG

  &.selected
    background-color colors-ui-surface-primary-secondary-hover

reviewFileName()
  font-size 0.8125rem
  color colors-ui-text-primary-body
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

reviewFilePath()
  font-size 0.6875rem
  color colors-ui-text-primary-label-subtle
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  margin-top 0.125rem

reviewCoverageBadge()
  display inline-block
  margin-top 0.125rem
  font-size 0.6875rem
  color colors-ui-text-primary-label-subtle
  background-color colors-ui-surface-primary-secondary
  padding 0.0625rem 0.375rem
  border-radius 0.1875rem

reviewEditorArea()
  flex 1
  display flex
  flex-direction column
  min-width 0
  overflow hidden

reviewEditorPane()
  flex 1
  min-height 0
