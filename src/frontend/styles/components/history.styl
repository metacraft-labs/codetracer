.history-list
  position: absolute
  display: flex
  flex-direction: column
  margin-top: 2.125rem
  white-space: nowrap
  padding: 0.125rem
  padding-top: 0.25rem
  padding-bottom: 0.25rem
  transform: translate(0, 50%)
  border-radius: 0.375rem
  background: colors-ui-surface-input-default

  .history-list-item-wrapper
    padding-left: 0.125rem
    padding-right: 0.125rem

    .history-list-item
      width: 100%
      padding-left: 0.5rem
      padding-right: 0.5rem
      cursor: pointer
      font-family: "SpaceGrotesk"
      color: colors-ui-text-primary-body
      border-radius: 0.375rem
      font-size: 0.875rem
      line-height: 1.5rem
      display: flex
      justify-content: space-between


      &:hover
        background: colors-ui-surface-primary-secondary-hover

      &:focus
        outline: none

.full-history-list
  display: flex
  position: absolute
  background: colors-ui-surface-input-default
  flex-direction: column
  padding: 0.125rem
  padding-top: 0.25rem
  padding-bottom: 0.25rem
  left: 100%
  transform: translateY(-1.75rem)
  overflow-y: auto
  min-height: 0
  max-height: 30vh
  border-radius: 0.375rem

  &::-webkit-scrollbar-thumb
    border-color: colors-ui-surface-input-default

.menu-expand
  width: MENU_EXPAND_WIDTH
  float: left
  position: relative
  margin-left: 0.5rem
  display: flex
  align-items: center

  &::after
    position: absolute
    right: 0.25rem
    // top: calc(50% - 6px)
    width: 0.4375rem
    height: 0.5rem
    content: MENU_EXTEND_ARROW_ICON
    display: flex
    align-items: center
    padding-bottom: 0.125rem
    transform: translateY(0.0625rem)
// .full-history-item:after
//   content: MENU_EXTEND_ARROW_ICON
//   width: 7px
//   height: 8px
//   padding-bottom: 2px
//   position: absolute
//   bottom: 10px
//   right: 12px
//   display: flex
//   align-items: center

.history-list-item.active
  background-color: colors-ui-surface-primary-secondary-hover
  // The error text token in the light theme (`by-mode`, defaults.styl).
  color: by-mode(red, colors-ui-text-error-primary)

#history
  display: flex
  flex-direction: column

  > #results
    display: flex
    flex-direction: column

#history-switch
  margin-left: 5.625rem

#values-switch
  margin-left: 5.625rem

.history-expandable
  color: colors-ui-text-primary-body

.value-name-container
  white-space: nowrap

  .toggle-value-history
    transform: translateY(0)
    margin-left: 0.25rem

.toggle-value-history
  background-image: HISTORY_VALUE_VIEW_TOGGLE_IMAGE
  background-size: 0.625rem 0.625rem
  background-position: center
  background-repeat: no-repeat
  display: inline-block
  height: 1rem
  min-width: 1rem
  margin-left: 0.5rem
  transform: translateY(0.1875rem)
  padding: 0.125rem
  border-radius: 6.25rem
  cursor: pointer
  outline: 0.0625rem solid colors-ui-border-primary-hover

  &.active
    outline: 0.125rem solid colors-ui-border-primary-hover

  &:hover > .custom-tooltip
    opacity: 1
    visibility: visible
    transition-delay: TOOLTIP_DELAY_TIMER

  .custom-tooltip
    top: -30%
    left: 120%

.history-text
  display: flex
  flex-direction: column
  align-items: start
  width: inherit
  padding-left: 0.25rem
  padding-right: 0.25rem

  .history-text-element
    display: flex
    justify-content: flex-start
    width: inherit
    // border: 1px colors-ui-text-primary-body solid

    .history-location-element
      margin-right: 0.5rem
      display: flex
      flex-direction: column
      align-items: end

    .history-value-element
      width: inherit

    .history-location
      // flex-basis: 25%
      width: fit-content
      color: colors-ui-text-primary-body


    .history-value
      flex-basis: 25%
      white-space: nowrap
      color: colors-ui-text-warning-primary
      margin-right: 1.5625rem
      padding-left: 0.25rem

      // The list hover (LIST_HOVER_BG, button.styl), square.
      &:hover
        background: LIST_HOVER_BG !important
        border-radius: 0 !important

.history-header
  position: relative
  top: 0
  height: 1.875rem
  margin-top: 0.3125rem

.history-container
  display: flex
  width: -moz-available
  width: -webkit-fill-available
  width: stretch
  margin-left: 0.75rem

.inline-history, .history
  background-color: colors-ui-surface-input-default
  color: colors-ui-text-primary-body
  font-size: 0.875rem
  cursor: pointer
  max-height: 6.25rem !important
  min-height: fit-content
  position: relative
  display: flex
  overflow-y: scroll
  border-radius: 0.375rem
  padding-left: 0.25rem
  width: -moz-available
  width: -webkit-fill-available
  width: stretch

  // &::-webkit-scrollbar-thumb
  //   border-color: colors-ui-surface-input-default

  &::-webkit-scrollbar-corner
    background-color: colors-ui-surface-input-default !important

  .inline-history-event
    display: flex
    border-style: solid
    border-width: 0.0625rem
    border-color: colors-ui-text-primary-body
    padding: 0.0625rem

    .inline-history-event-codeID
      border-right: solid 0.0625rem colors-ui-text-primary-body
      flex-basis: 50%

    .inline-history-event-value
      flex-basis: 50%
      padding: 0.0625rem

.history
  width: 100%

// The debugger's history popup is anchored to back/forward by its view. Scope
// these rules so older history surfaces retain their own positioning.
.isonim-debug-controls .history-list-host
  position: fixed
  z-index: 1500
  width: max-content
  max-width: calc(100vw - 1rem)
  -webkit-app-region: no-drag

  .history-list
    position: relative
    margin: 0
    transform: none
    min-width: 12rem
    max-width: calc(100vw - 1rem)
    color: colors-ui-text-primary-body
    border: 0.0625rem solid colors-ui-border-primary-hover

  .history-list-rows
    display: flex
    flex-direction: column
    max-height: min(45vh, 24rem)
    overflow: auto

  .history-list-entry,
  .history-list-close
    border: 0
    background: transparent
    color: inherit
    font-family: "SpaceGrotesk"
    font-size: 0.875rem
    line-height: 1.5rem
    padding: 0.125rem 0.5rem
    text-align: left
    white-space: nowrap
    cursor: pointer
    flex-shrink: 0

    &:hover,
    &:focus-visible
      background: colors-ui-surface-primary-secondary-hover

  .history-list-entry
    width: max-content
    min-width: 100%

  .history-list-close
    border-top: 0.0625rem solid colors-ui-border-primary-hover
