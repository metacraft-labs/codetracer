// Event-log-specific DataTable overrides.
// The HTML structure is: .eventLog > .eventLog-dense-table.data-table > (DataTables) > table > tr
// So overrides must be scoped as .eventLog .data-table, NOT .data-table .eventLog.
.eventLog
  .data-table
    tr
      border-top: none !important
      align-items: center !important

    .direct-location-rr-ticks
      overflow: visible !important
      max-height: none !important
      transform: none !important
      padding-left: 0.5em !important
      padding-right: 0.75em !important

    // Combined selector beats .eventLog-cell alone so overflow: visible wins
    .eventLog-cell.direct-location-rr-ticks
      overflow: visible !important

.paging-content
  display: flex
  flex-direction: column

  .paging-child
    display: flex

    .paging-view
      flex-basis: 80%

    .paging-expand
      color: green
      flex-basis: 20%

    .paging-collapse
      color: red
      flex-basis: 20%

