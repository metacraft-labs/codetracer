// The Scene-1 live-edit panel (`ui/hcr_live_edit_panel.nim`).
//
// Deliberately NOT a modal backdrop, which is the one decision here worth
// writing down. The whole point of the panel is that the running program
// reshapes WHILE YOU TYPE, so whatever is showing that program must stay
// visible and stay interactive. A full-screen scrim of the kind
// `file_conflict_dialog.styl` uses would cover the thing the user is looking
// at, and a live-edit surface that hides the live result is the same tool with
// the feedback removed.

.hcr-live-edit-backdrop
  position fixed
  right 1.5rem
  bottom 1.5rem
  z-index 10000

.hcr-live-edit-panel
  width 26.25rem
  max-width calc(100vw - 3rem)
  padding 1rem
  border 0.0625rem solid colors-ui-border-secondary
  border-radius 0.375rem
  background colors-ui-surface-base-panel
  color colors-ui-text-primary-body
  box-shadow 0 0.75rem 2rem rgba(0, 0, 0, 0.35)

.hcr-live-edit-panel h2
  margin 0 0 0.375rem
  font-size 0.9375rem
  font-weight 600

.hcr-live-edit-hint
  margin 0 0 0.75rem
  font-size 0.75rem
  line-height 1.4
  opacity 0.75

.hcr-live-edit-label
  display block
  margin 0 0 0.25rem
  font-size 0.75rem
  opacity 0.75

.hcr-live-edit-input
  width 100%
  min-height 1.75rem
  padding 0.25rem 0.5rem
  border 0.0625rem solid colors-ui-border-secondary
  border-radius 0.25rem
  background colors-ui-surface-input-default
  color colors-ui-text-primary-body
  font-family monospace
  font-size 0.8125rem

.hcr-live-edit-row
  display flex
  gap 0.5rem
  justify-content flex-end
  margin-top 0.625rem

.hcr-live-edit-row button
  min-height 1.75rem
  padding 0.25rem 0.625rem
  border-radius 0.25rem
  control-button()

.hcr-live-edit-row button:hover
  control-button-hover()

// The status line is where the provider's answer STAYS. Notifications expire;
// a panel that publishes on every pause needs somewhere the last named outcome
// is still readable a minute later.
.hcr-live-edit-status
  margin 0.75rem 0 0
  font-family monospace
  font-size 0.8125rem
  font-weight 600
  overflow-wrap anywhere

.hcr-live-edit-detail
  margin 0.25rem 0 0
  font-size 0.75rem
  line-height 1.4
  opacity 0.8
  overflow-wrap anywhere
