// Welcome screen widget styles

// How far the "Welcome to CodeTracer" title and the version number sit above
// the logo's bottom edge (see `.welcome-title`).  4px.
WELCOME_TITLE_RAISE = 0.25rem

// Where text starts in the Recent traces / Recent folders cards, measured from
// the rows' edge: the card titles, the empty messages and each row's first text
// all sit this far in.  8px.
RECENT_LIST_TEXT_INSET = 0.5rem

#welcomeScreen
  position: fixed
  top: CAPTION_BAR_HEIGHT  // flush below the caption bar (shared_widgets.styl)
  left: 0
  right: 0
  bottom: 2em
  z-index: 10
  display: none
  pointer-events: none
  overflow: auto

  .window-menu
    align-items: start
    height: 1.75em

#welcomeScreen .welcome-screen-root
  height: 100%
  min-height: 100%

// While a welcome screen is up (welcome, Start Debugger, online trace), there
// is no trace for the rest of the window to act on:
//   * the footer (`#status-base`, status_bar.styl) is hidden, and the welcome
//     screen runs down to the window's bottom edge in its place;
//   * the caption bar's controls — the debugger toolbar, the command prompt and
//     (Windows/Linux) the navigation menu — look disabled and ignore the
//     pointer, the way a disabled button does (`button:disabled`,
//     button.styl: 50% and no pointer events).  The trace tabs and their "+"
//     stay live: they are how you get back to a trace.
//
// "Up" is read from the DOM: the welcome view renders into `#welcomeScreen`
// and empties it when a trace takes over, so the condition cannot outlive the
// screen.
body:has(> #welcomeScreen .welcome-screen-wrapper)
  #status-base
    display: none

  #welcomeScreen
    bottom: 0

  #menu
    #isonim-debug-controls,
    #debug,
    #navigation-menu
      opacity: 0.5
      pointer-events: none

.welcome-screen-loading-overlay
  position: absolute
  top: 0
  background-color: black
  width: 100%
  height: 100%
  opacity: 0.8
  z-index: 100
  display: flex
  align-items: center
  justify-content: center

  &-text
    padding-left: 0.625em
    color: white
    font-size: x-large
    font-style: italic

  .welcome-screen-loading-overlay-icon
    width: 2em
    height: 2em
    background-repeat: no-repeat
    background-position: center
    background-image: url("../../public/resources/welcome/loading_sign_dots_32.svg")
    animation: infinite linear
    animation-name: loading
    animation-duration: 3s

.welcome-logo
  background-image: url('../../public/resources/shared/codetracer_welcome_logo.svg')
  // Sized in rem, not em: this sits inside `.welcome-text`, whose `font-size: 2em`
  // makes 1em == 32px here.  5rem is 80px at the 16px root either way.
  min-width: 5rem
  min-height: 5rem
  background-size: 5rem 5rem
  background-position: center
  margin-right: 0.75em
  background-repeat: no-repeat

// The welcome screens' title type — "Welcome to CodeTracer", and the heading
// of every screen behind it ("Start Debugger", "Download and open online
// trace").  One definition so the screens read as one flow; the other two were
// Space Mono at 32px on a 64px line, a different voice from the screen they
// open from.
//
// 32px on a 40px line: the design system's Title / md size
// (`titles-title-md` — fontsize-6, lineheights-1), both whole pixels.  It was
// 2.3em (36.8px) on a 1.2em (44.16px) line, which landed between pixels.  In
// rem so it no longer depends on what the title's parent inherits.
welcome-heading-type()
  font-family: "SpaceGrotesk"
  font-weight: BOLD_WEIGHT
  font-size: 2rem
  letter-spacing: -0.02em
  line-height: 2.5rem
  color: colors-ui-text-primary-body

.welcome-screen-wrapper
  color: colors-ui-text-primary-body;
  background-color: colors-ui-surface-input-default;
  min-height: 100%;
  height: 100%;
  position: relative;
  width: 100%;
  z-index: 50
  display: flex;
  justify-content: center;
  align-items: center
  border-radius: 0
  pointer-events: auto

  .welcome-screen
    position: relative
    height: fit-content
    background-color: gradien
    width: 56.25em
    padding: 3em
    padding-bottom: 3.75em
    background: colors-ui-surface-input-default
    display: flex
    flex-direction: column
    border-radius: 0.75em
    align-items: center
    border: 0.0625em solid colors-ui-border-secondary

    &.welcome-screen-loading
      cursor: wait !important

    // One line: the logo, "Welcome to CodeTracer" and the version.  The title
    // and the version share one baseline, 4px above the logo's bottom edge
    // (WELCOME_TITLE_RAISE below).
    //
    // `baseline` at both levels lines them up.  The logo is an empty box, so it has
    // no text baseline of its own; flexbox then uses its bottom edge
    // (https://www.w3.org/TR/css-align-3/#synthesize-baseline), which puts the
    // logo's bottom on the title's baseline.  `.welcome-text` in turn exposes
    // that shared baseline to this row, where the version text sits on it too.
    // `flex-end` aligned boxes instead, and the text's line boxes end below
    // the letters, so the version's letters ended 3px above the logo's bottom
    // and the title's last line 8.5px above it.
    .welcome-title
      position: relative
      font-family: "SpaceGrotesk"
      text-align: start
      display: flex
      align-items: baseline
      justify-content: space-between
      color: colors-ui-text-primary-body
      width: -moz-available
      width: -webkit-fill-available
      width: stretch

      .welcome-text
        display: flex
        align-items: baseline
        welcome-heading-type()
        // As wide as the one-line title needs.  It was a fixed 19em that
        // wrapped the title onto two lines.
        white-space: nowrap
        flex-shrink: 0

        // The markup has "Welcome to" and the product name as two block
        // elements, one per line.  Inline, they run on as one line; the
        // space after the first is a real word space in the title's font.
        > div:not(.welcome-logo)
          > div
            display: inline

          > div:first-child::after
            content: " "

      .welcome-version
        color: colors-ui-text-primary-disabled
        font-size: 0.75em
        font-family: "SpaceGrotesk"
        font-weight: 400
        line-height: normal
        text-align: center
        // Keep the version on one line, whatever room the title leaves.
        white-space: nowrap
        flex-shrink: 0

      // The title and the version sit 4px higher than the shared baseline
      // above puts them, so their letters end 4px above the logo's bottom
      // edge rather than on it.  One value for both, so they stay on one line.
      // `top` on a relative element moves only where it is painted: the logo
      // and the layout below stay where they are.
      .welcome-text > div:not(.welcome-logo),
      .welcome-version
        position: relative
        top: -(WELCOME_TITLE_RAISE)

    .welcome-content
      display: flex
      flex-direction: row
      gap: 1em
      width: -moz-available
      width: -webkit-fill-available
      width: stretch

    .welcome-left-panel
      flex: 1
      display: flex
      flex-direction: column
      min-width: 0

    .welcome-right-panel
      flex: 1
      display: flex
      flex-direction: column
      min-width: 0

    // The standing explanation under the strip (issue #734).  Rendered only
    // when the ViewModel carries one, which today means the web arm, where
    // every start option is refused and a `title` per button is not enough:
    // a user has to suspect a control before hovering it, and the reporter
    // had no reason to suspect five grey rectangles rather than the product.
    .start-options-note
      margin-top: 0.75em
      font-family: "SpaceGrotesk"
      font-size: 0.75em
      line-height: 1.5
      max-width: 44em
      color: colors-ui-text-primary-body
      opacity: 0.75

    // Start options - direct child of .welcome-screen
    .start-options
      position: relative
      display: flex
      width: -moz-available
      width: -webkit-fill-available
      width: stretch
      gap: 0.5em
      justify-content: flex-start

      .start-option
        position: relative
        right: 0
        display: flex
        cursor: pointer
        justify-content: center
        font-family: "SpaceGrotesk"

        &.hovered
          opacity: 1

      // A REFUSED option, which must still be READABLE and still HOVERABLE.
      //
      // Issue #734: this rule used to be `opacity: 0.2` plus
      // `pointer-events: none`. The first made the label almost illegible and
      // the second suppressed the browser's native `title` tooltip — so on the
      // web arm, where every option is refused, the strip was five unreadable
      // ghosts that could not be interrogated. The reporter concluded the
      // product was broken, which was the only conclusion available.
      //
      // The click is refused in CODE (`triggerStartOption` in
      // `isonim_welcome_screen_view.nim` returns early on `opt.inactive`), so
      // `pointer-events: none` was never what made the refusal safe; it only
      // hid the explanation. `cursor: not-allowed` says the same thing to the
      // pointer without taking the hover away.
      .inactive-start-option
        opacity: 0.45
        cursor: not-allowed

        &.hovered
          color: inherit
          opacity: 0.45

      .start-option-icon
        width: 6.25em
        height: 6.25em
        background-image: WELCOME_SCREEN_OPTIONS_RECORD_ICON
        background-repeat: no-repeat
        background-position: center

        &.hovered
          background-image: WELCOME_SCREEN_OPTIONS_RECORD_ICON_HOVERED
          opacity: 1

      .start-option-name
        text-align: center
        font-size: 0.875em
        font-weight: BOLD_WEIGHT
        letter-spacing: -0.00875em
        line-height: 1.125em
        background-color: colors-ui-surface-primary-secondary-hover
        display: flex
        align-items: center
        color: colors-ui-text-primary-body
        justify-content: center
        white-space: nowrap
        padding: 0.375em
        padding-left: 0.875em
        padding-right: 0.875em
        border-radius: 0.375em

        &.hovered
          // color: colors-ui-text-primary-active
          // background-color: colors-ui-surface-primary-tertiary
          outline: 0.0625em solid colors-ui-border-primary
          opacity: 1

    // Recent traces styles - in welcome-right-panel
    .recent-traces
      position: relative
      width: -moz-available
      width: -webkit-fill-available
      width: stretch
      background-color: colors-ui-surface-base-panel
      border-radius: 0.375em
      padding: 0.5em
      margin-top: 3em
      margin-bottom: 3em
      overflow: visible

    // The title, the empty message and every row's text start on one line:
    // 8px inside the rows (RECENT_LIST_TEXT_INSET).  The rows themselves stay
    // flush with the card's padding so their hover fill keeps its width.
    .recent-traces-title
      text-align: start
      font-size: 1.125em
      font-weight: BOLD_WEIGHT
      line-height: 1.125em
      letter-spacing: -0.01125em
      font-family: "SpaceGrotesk"
      margin-bottom: 0.375em
      padding-left: RECENT_LIST_TEXT_INSET

    .recent-traces-list
      max-height: 10.75em
      overflow-y: auto
      overflow-x: visible
      // Allow tooltips to overflow - they use position: absolute and high z-index
      clip-path: none
      // No space between the rows and the scrollbar: the rows run right up to
      // it (Nikolay, 2026-09-15).  An 8px gap here was tried and removed.
      padding-right: 0

      .empty-state-message
        display: flex
        flex-direction: column
        gap: 0.5em
        padding-left: RECENT_LIST_TEXT_INSET

        .empty-state-welcome
          font-size: 1em
          font-weight: 600
          font-family: "SpaceGrotesk"
          color: colors-ui-text-primary-body

        .empty-state-text
          font-size: 0.8125em
          font-family: "SpaceGrotesk"
          color: #888888
          line-height: 1.5

      .recent-trace-container
        display: flex
        align-items: center
        justify-content: space-between

      // No fill at rest; under the pointer, the VCS panel's row hover
      // (`.vcs-commit-header:hover`, vcs.styl): `surface/primary/secondary-hover`.
      // The same for the Recent folders rows below, so the two lists match.
      .recent-trace
        color: colors-ui-text-warning-on-color
        background-color: transparent
        height: 1.75em
        margin-top: 0.125em
        margin-bottom: 0.375em
        display: flex
        position: relative
        text-align: left
        border-radius: 0.25em
        width: -moz-available
        width: -webkit-fill-available
        width: stretch

        &:hover
          cursor: pointer
          background-color: LIST_HOVER_BG

          .recent-trace-tooltip
            opacity: 1
            visibility: visible
            transition-delay: 0.5s

        .recent-trace-title
          display: flex
          align-items: center
          position: relative
          flex: 1
          min-width: 0

          // No divider between the time and the name: the fixed time column
          // below already separates them.
          .separate-bar
            display: none

          // A fixed column, so every trace name starts on the same line
          // whatever the time reads.  90px holds the widest label
          // `formatWelcomeTimeAgo` can produce, "59 minutes ago" (89.2px in
          // this 12px face); "4 days ago" and "2 weeks ago" were 8.4px apart.
          .recent-trace-title-time
            flex: 0 0 5.625rem
            margin-left: RECENT_LIST_TEXT_INSET
            margin-right: 0
            font-size: 0.75em
            font-family: "SpaceGrotesk"
            line-height: 1.125em
            color: #888888
            white-space: nowrap

          // 8px after the time column.
          .recent-trace-title-content
            margin-left: 0.5rem
            margin-right: RECENT_LIST_TEXT_INSET
            font-size: 0.875em
            font-weight: BOLD_WEIGHT
            font-family: "SpaceGrotesk"
            line-height: 1.125em
            letter-spacing: -0.00875em
            position: relative
            overflow: hidden
            white-space: nowrap
            text-overflow: ellipsis
            flex: 1

        .recent-trace-tooltip
          position: fixed
          background-color: #1B1B1B
          color: #f3f3f3
          padding: 0.5em 0.75em
          font-size: 0.75em
          font-family: "SpaceGrotesk"
          border-radius: 0.25em
          white-space: pre-line
          box-shadow: 0 0.25em 0.75em rgba(0, 0, 0, 0.4)
          opacity: 0
          visibility: hidden
          transition: opacity 0.2s ease, visibility 0.2s ease
          pointer-events: none
          z-index: 1000
          max-width: 40em
          line-height: 1.4
          overflow-wrap: break-word
          word-break: break-all
          // Position is set via JavaScript on hover (right of the trace row).
          // Off-screen default in px so it never flashes at center.
          left: -9999px
          top: -9999px
          transform: none

    // Recent folders styles - in welcome-left-panel
    .recent-folders
      position: relative
      width: -moz-available
      width: -webkit-fill-available
      width: stretch
      background-color: colors-ui-surface-base-panel
      border-radius: 0.375em
      padding: 0.5em
      margin-top: 3em
      margin-bottom: 3em

    // The same text inset as Recent traces, so the two cards match.
    .recent-folders-title
      text-align: start
      font-size: 1.125em
      font-weight: BOLD_WEIGHT
      line-height: 1.125em
      letter-spacing: -0.01125em
      font-family: "SpaceGrotesk"
      margin-bottom: 0.375em
      padding-left: RECENT_LIST_TEXT_INSET

    .recent-folders-list
      max-height: 10.75em
      overflow-y: scroll
      overflow-x: visible
      // No space between the rows and the scrollbar, as in Recent traces.
      padding-right: 0

      .empty-state-message
        display: flex
        flex-direction: column
        gap: 0.5em
        padding-left: RECENT_LIST_TEXT_INSET

        .empty-state-welcome
          font-size: 1em
          font-weight: 600
          font-family: "SpaceGrotesk"
          color: colors-ui-text-primary-body

        .empty-state-text
          font-size: 0.8125em
          font-family: "SpaceGrotesk"
          color: #888888
          line-height: 1.5

      .recent-folder-container
        display: flex
        align-items: center
        justify-content: space-between

      // Same rows as Recent traces: no fill at rest, the VCS row hover.
      .recent-folder
        color: colors-ui-text-warning-on-color
        background-color: transparent
        height: 1.75em
        margin-top: 0.125em
        margin-bottom: 0.375em
        display: flex
        position: relative
        text-align: left
        border-radius: 0.25em
        width: -moz-available
        width: -webkit-fill-available
        width: stretch

        &:hover
          cursor: pointer
          background-color: LIST_HOVER_BG

        .recent-folder-name
          margin-left: RECENT_LIST_TEXT_INSET
          margin-right: RECENT_LIST_TEXT_INSET
          font-size: 0.875em
          font-weight: BOLD_WEIGHT
          font-family: "SpaceGrotesk"
          line-height: 1.125em
          letter-spacing: -0.00875em
          position: relative
          overflow: hidden
          white-space: nowrap
          text-overflow: ellipsis
          display: flex
          align-items: center

  .new-record-screen
    position: relative
    display: flex
    align-items: center
    justify-content: center
    z-index: 50

    hr
      border-color: colors-ui-surface-primary-tertiary

    .new-record-screen-content
      position: relative
      width: 43.75em
      background: colors-ui-surface-input-default
      border: 0.0625em solid colors-ui-border-secondary
      border-radius: 0.75em
      padding: 3em
      padding-bottom: 3.75em

      .welcome-logo
        min-width: 2.5em
        max-width: 2.5em
        min-height: 2.5em
        background-size: 2.5em 2.5em

    .new-record-title
      position: relative
      welcome-heading-type()
      text-align: start
      width: 100%
      // 42px above, between the logo and the title ("Start Debugger",
      // "Download and open online trace"), and 32px below, down to the first
      // input field — both measured from the title's 40px line box.  The first
      // form row's own 5px top margin collapses into the 32px, so the field
      // starts exactly 32px under the title.  rem: in em these would follow
      // the heading's own 32px font size.
      margin-bottom: 2rem
      margin-top: 2.625rem

    .new-record-form

      .new-record-form-row
        display: flex;
        align-items: center;
        flex-direction: column;
        margin-top: 0.3125em

        .form-validation-row
          height: 1em;
          font-size: 0.875em;
          position: relative;
          width: 100%;
          text-indent: 13vw;
          font-style: italic;
          color: colors-ui-text-error-primary;

        .new-record-input-row
          position: relative
          width: 100%
          display: flex
          align-items: center
          // 6px between a field and its "Choose" button — the same gap as the
          // State panel's tabs and watch field.  The field gives up the width;
          // the button keeps its own.
          gap: 0.375rem
          margin-bottom: 1em

        .checkmark
          position: relative
          margin-right: 0.5em !important
          top: 0 !important

        label
          margin-bottom: 0 !important
          position: relative
          width: fit-content
          // Left-aligned with the fields above and below it ("Use default
          // output folder").  The row is a centred column, so on its own the
          // label sat in the middle of the form.
          align-self: flex-start
          text-align: left
          color: colors-ui-text-primary-label
          font-family: "SpaceGrotesk"
          font-weight: bold
          font-size: 0.875em
          font-weight: 400

        // input
        //   background-color: colors-ui-surface-base-panel
        //   margin-left: 0px !important
        //   margin-bottom: 0px !important
        //   background-image: none !important
        //   color: colors-ui-text-primary-label
        //   padding-left: 8px !important

        //   &.disabled
        //     pointer-events: none
        //     opacity: 0.4

        //   &.invalid
        //     outline: 2px solid colors-ui-text-error-primary

        // button
        //   min-width: 8px
        //   background-color: colors-ui-surface-primary-secondary
        //   margin-left: 8px
        //   position: relative
        //   border: 0
        //   border-radius: 6px
        //   color: colors-ui-text-primary-body
        //   font-weight: 400
        //   padding: 0px !important
        //   padding-left: 22px !important
        //   padding-right: 22px !important
        //   font-family: "SpaceMono"
        //   font-size: 14px
        //   height: 28px
        //   display: flex
        //   align-items: center
        //   justify-content: center

        //   &.disabled
        //     pointer-events: none
        //     opacity: 0.4

        //   &:hover
        //     opacity: 0.5
        //     // background-color: colors-ui-text-primary-body
        //     // color: colors-ui-surface-base-panel

        //   &.cancel-button
        //     background-color: colors-ui-surface-primary-secondary-hover !important
        //     margin: 0px !important

        //   &.confirmation-button
        //     background-color: colors-ui-surface-action-primary !important
        //     margin-left: 8px !important
        //     width: 146px
        //     padding-left: 16px
        //     padding-right: 16px

        //     &:hover
        //       background-color: colors-ui-surface-action-primary !important
        //       opacity: 1 !important

        //     &:active
        //       outline: 1px solid colors-ui-border-focus !important

      .new-record-form-row:last-child
        display: flex
        flex-direction: row !important
        justify-content: flex-start !important

      // Record / Download turn indigo only once there is something to submit.
      // Until then they look exactly like the Back button beside them: the
      // tertiary fill and text, and the tertiary hover (button.styl).
      //
      // "Something to submit" is the field the form cannot go without —
      // Record's "Local project path" (`isNewRecordValid` in
      // viewmodel/viewmodels/welcome_screen_vm.nim requires only it) and
      // Download's URL field.  A field reads `:placeholder-shown` while it is
      // empty, including after the "Choose" picker fills or clears it.
      //
      // The change fades with every button's transition (BUTTON_TRANSITION,
      // button.styl): 250ms after a 100ms beat, both ways.

    .new-record-form:not(.new-online-trace-form):not(:has(#new-record-executable:not(:placeholder-shown))),
    .new-online-trace-form:not(:has(input.ct-input-form:not(:placeholder-shown)))
      .ct-button-sm-primary
        background-color: colors-ui-surface-primary-tertiary
        color: colors-ui-text-primary-body-subtle

        // `!important` only to beat the primary hover, which is itself
        // `!important` (button.styl).
        &:hover
          background-color: colors-ui-surface-primary-tertiary-hover !important

    .new-record-result-wrapper
      display: flex
      align-items: center
      justify-content: center
      margin-bottom: 1em
      border-radius: 0.375em
      padding: 0.5em

      &.empty
        outline: none

      &.in-progress
        outline: 0.0625em solid colors-ui-text-information-primary

      &.failed
        outline: 0.0625em solid colors-ui-text-error-primary

      &.success
        outline: 0.0625em solid colors-ui-text-success-primary

      .new-record-result
        position: relative
        width: 100%
        text-align: center
        font-family: "SpaceGrotesk"
        display: flex
        align-items: center

        &.empty
          display: none

        .new-record-status-icon
          position: relative
          width: 1.5em
          height: 1.5em
          background-repeat: no-repeat
          background-size: 1.125em 1.125em
          background-position: center
          margin-right: 0.25em

          &.in-progress
            background-image: url("../../public/resources/welcome/loading_sign_dots_128.svg")
            animation: infinite linear
            animation-name: loading
            animation-duration: 3s

          &.failed
            background-image: ct-images-notification-error
          &.success
            background-image: ct-images-notification-success

        .new-record-result-info
          text-align: center
          position: relative
          width: 100%
          height: 1.875em
          font-family: "SpaceGrotesk"
          font-size: 1.25em

.online-functionality-buttons
  display: flex
  padding-right: 0.125em

  .recent-trace-buttons
    margin-left: 0.5em
    margin-top: 0.125em
    margin-bottom: 0.375em
    height: 1.75em
    width: 1.75em
    background-color: colors-ui-surface-primary-secondary-hover
    border-radius: 0.25em
    cursor: pointer
  upload
    &:hover
      outline: 0.0625em solid colors-ui-border-secondary

    &:active
      background-color: colors-ui-surface-primary-secondary

    &.trace-info-button-active
      background-color: colors-ui-text-warning-primary

  .recent-trace-buttons-image
    background-repeat: no-repeat
    background-size: 1em 1em
    background-position: center
    height: 1.75em

  .progress-circle
    width: 1.25em
    height: 1.25em
    border-radius: 50%
    position: absolute
    background-image: conic-gradient(#6B6B6B 0% 0%, #2C2C2C 0% 100%)
    background-size: auto
    z-index: 1
    transform: translate(0.25em, 0.25em)

  .inner-circle
    width: 0.875em
    height: 0.875em
    border-radius: 50%
    background-color: colors-ui-surface-primary-secondary-hover
    position: absolute
    z-index: 2
    transform: translate(0.4375em, 0.4375em)

  #progress-bar
    position: relative

  #trace-upload-button
    background-image: WELCOME_SCREEN_UPLOAD_BUTTON

  #trace-copy-button
    background-image: WELCOME_SCREEN_COPY_BUTTON

  #trace-delete-button
    background-image: WELCOME_SCREEN_DELETE_BUTTON

  #trace-info-button
    background-image: WELCOME_SCREEN_INFO_BUTTON

  #trace-info-button-active
    background-image: WELCOME_SCREEN_INFO_ACTIVE_BUTTON

  .welcome-path-active
    opacity: 1
    visibility: visible
    height: 1.5em
    left: calc(100% + 0.5em)
    position: absolute
    width: fit-content

    &:after
      top: 18%
      left: -0.875em
      border-color: transparent colors-ui-surface-base-canvas transparent transparent !important

