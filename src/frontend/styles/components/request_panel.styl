// HTTP Request Panel
// Styled to match the reference design.
// All colours use design-system tokens from generated/mapped.styl.

.request-panel
  height: 100%
  display: flex
  flex-direction: column
  overflow: hidden
  background: colors-ui-surface-base-panel
  color: colors-ui-text-primary-body-subtle
  font-size: 0.75rem !important

// ---------------------------------------------------------------------------
// Filter bar: [🔍 Find by URL...]  [Method: All ▼]  [Status: All ▼]
// ---------------------------------------------------------------------------

.request-panel-filters
  display: flex
  align-items: center
  gap: 0.667em
  padding: 0.5em 1em
  flex-shrink: 0
  background: colors-ui-surface-base-panel
  border-bottom: 1px solid colors-ui-border-secondary

// URL search input — uses design-system input tokens via ct-input-panel + ct-input-search-image
// Override height to match filter bar; font-family stays monospace for URL readability.
.request-filter-search
  flex: 1
  font-family: "SpaceGrotesk" !important
  height: 1.75em
  max-height: 1.75em


// ---------------------------------------------------------------------------
// Table header
// ---------------------------------------------------------------------------

.request-table-header
  display: flex
  align-items: center
  padding: 0.4167em 1em
  font-size: 0.9167em
  font-weight: 500
  letter-spacing: 0.06em
  text-transform: uppercase
  color: colors-ui-text-primary-label
  background: colors-ui-surface-primary-default
  border-bottom: 1px solid colors-ui-border-secondary
  flex-shrink: 0
  user-select: none

// ---------------------------------------------------------------------------
// Table body (scrollable)
// ---------------------------------------------------------------------------

.request-table-body
  flex: 1
  overflow-y: auto
  overflow-x: hidden
  min-height: 0

// ---------------------------------------------------------------------------
// Rows
// ---------------------------------------------------------------------------

.request-row
  display: flex
  align-items: center
  padding: 0.5em 1em
  cursor: pointer
  border-bottom: 1px solid colors-ui-border-secondary
  color: colors-ui-text-primary-body-subtle

  &:hover
    background: colors-ui-surface-primary-secondary-hover

  &.selected
    background: colors-ui-surface-action-primary

// ---------------------------------------------------------------------------
// Column widths — mirroring the reference proportions
// ---------------------------------------------------------------------------

.request-col-id
  min-width: 2.3333em
  max-width: 2.3333em
  color: colors-ui-text-primary-label
  text-align: right
  padding-right: 1em

.request-col-method
  min-width: 7.3333em
  max-width: 7.3333em

.request-col-url
  flex: 1
  overflow: hidden
  text-overflow: ellipsis
  white-space: nowrap
  padding: 0 1em

.request-col-status
  min-width: 6.6667em
  max-width: 6.6667em
  display: flex
  justify-content: flex-end

.request-col-duration
  min-width: 6em
  max-width: 6em
  text-align: right
  color: colors-ui-text-primary-label

.request-col-size
  min-width: 5.3333em
  max-width: 5.3333em
  text-align: right
  color: colors-ui-text-primary-label
  padding-right: 0.1667em

// ---------------------------------------------------------------------------
// Method badges — coloured pill for each HTTP verb
// Uses alert-surface + matching text-color pairs so both are design-system tokens.
// ---------------------------------------------------------------------------

.request-method-badge
  display: inline-block
  font-size: 0.9167em
  font-weight: 700
  font-family: "SpaceGrotesk"
  padding: 0.25em 0.8333em
  border-radius: 0.3333em
  text-transform: uppercase
  letter-spacing: 0.03em

.request-method-get
  background: colors-ui-surface-alert-information
  color: colors-ui-text-information-primary

.request-method-post
  background: colors-ui-surface-alert-success
  color: colors-ui-text-success-primary

.request-method-delete
  background: colors-ui-surface-alert-error
  color: colors-ui-text-error-primary

.request-method-put,
.request-method-patch
  background: colors-ui-surface-alert-warning
  color: colors-ui-text-warning-primary

.request-method-head,
.request-method-options
  background: colors-ui-surface-primary-secondary
  color: colors-ui-text-primary-label

// ---------------------------------------------------------------------------
// Status codes — coloured number only (no bullet dot)
// ---------------------------------------------------------------------------

.request-status-success,
.request-status-redirect,
.request-status-client-error,
.request-status-server-error,
.request-status-unknown
  font-weight: 600
  white-space: nowrap

// 2xx — green
.request-status-success
  color: colors-ui-text-success-primary

// 3xx — blue (information)
.request-status-redirect
  color: colors-ui-text-information-primary

// 4xx — orange (warning)
.request-status-client-error
  color: colors-ui-text-warning-primary

// 5xx — red (error)
.request-status-server-error
  color: colors-ui-text-error-primary

.request-status-unknown
  color: colors-ui-text-primary-label

// ---------------------------------------------------------------------------
// Detail panel host — always in DOM; collapses to zero when empty.
// flex-basis is set imperatively via inline style by the resize JS logic
// (initial value 50%, then maintained as a percentage so it scales with
// component resizes).
// ---------------------------------------------------------------------------

.request-detail-host
  flex-shrink: 0
  min-height: 0

// ---------------------------------------------------------------------------
// Resize handle — draggable strip at the top of the detail panel.
// Height is set in em so it scales with the component font-size.
// ---------------------------------------------------------------------------

.request-detail-resize-handle
  flex-shrink: 0
  height: 0.3333em
  cursor: ns-resize
  background: transparent


// ---------------------------------------------------------------------------
// Detail panel — shown below the table when a row is selected
// ---------------------------------------------------------------------------

.request-detail
  height: 100%
  display: flex
  flex-direction: column
  border-top: 2px solid colors-ui-border-secondary
  overflow: hidden
  background: colors-ui-surface-base-panel

// ---------------------------------------------------------------------------
// Detail header — method badge | URL | status text | Handler button
// ---------------------------------------------------------------------------

.request-detail-header
  display: flex
  align-items: center
  justify-content: space-between
  padding: 0.8333em 1em
  background: colors-ui-surface-primary-default
  flex-shrink: 0
  gap: 1em

.request-detail-header-left
  display: flex
  align-items: center
  gap: 0.8333em
  min-width: 0
  overflow: hidden

.request-detail-header-url
  font-family: "SpaceMono", monospace
  font-size: 1.0833em
  color: colors-ui-text-primary-body
  white-space: nowrap
  overflow: hidden
  text-overflow: ellipsis

.request-detail-header-status
  font-size: 1.0833em
  font-weight: 600
  white-space: nowrap

  &.request-status-success
    color: colors-ui-text-success-primary

  &.request-status-redirect
    color: colors-ui-text-information-primary

  &.request-status-client-error
    color: colors-ui-text-warning-primary

  &.request-status-server-error
    color: colors-ui-text-error-primary

  &.request-status-unknown
    color: colors-ui-text-primary-label

.request-detail-header-right
  flex-shrink: 0

// Override the generic `button { flex: 0 0 1.75em }` rule so the Handler
// button auto-sizes to its text content instead of being 1.75em wide.
button.request-detail-handler-btn
  flex: 0 0 auto !important
  white-space: nowrap

// ---------------------------------------------------------------------------
// Detail tab bar
// ---------------------------------------------------------------------------

.request-detail-tabs
  display: flex
  align-items: flex-end
  padding: 0 0.3333em
  background: colors-ui-surface-base-panel
  border-bottom: 1px solid colors-ui-border-secondary
  flex-shrink: 0

.request-detail-tab
  padding: 0.5em 1em
  font-family: "SpaceGrotesk"
  color: colors-ui-text-primary-label
  cursor: pointer
  border-bottom: 2px solid transparent
  user-select: none

  &:hover
    color: colors-ui-text-primary-body

.request-detail-tab--active
  color: colors-ui-text-primary-body
  border-bottom-color: colors-ui-surface-action-primary

// ---------------------------------------------------------------------------
// Detail content area
// ---------------------------------------------------------------------------

.request-detail-content
  flex: 1
  overflow-y: auto
  overflow-x: hidden
  padding: 1em

.request-detail-section-title
  font-size: 0.9167em
  font-weight: 600
  letter-spacing: 0.08em
  text-transform: uppercase
  color: colors-ui-text-primary-label
  margin-bottom: 0.6667em

.request-detail-row
  display: flex
  gap: 1.3333em
  padding: 0.3333em 0

.request-detail-key
  color: colors-ui-text-information-primary
  font-family: "SpaceMono", monospace
  min-width: 10em

.request-detail-value
  color: colors-ui-text-primary-body

.request-detail-placeholder
  color: colors-ui-text-primary-label
  padding: 0.3333em 0

// ---------------------------------------------------------------------------
// Timing tab
// ---------------------------------------------------------------------------

.request-timing-row
  display: flex
  align-items: center
  gap: 0.6667em
  padding: 0.25em 0

.request-timing-label
  min-width: 6.6667em
  color: colors-ui-text-primary-label

.request-timing-value
  color: colors-ui-text-primary-body
  text-align: right
  min-width: 4em
