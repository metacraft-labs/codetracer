.select-view-kind
  position: relative
  display: none

.select-view-kind-button
  text-align: center
  height: 1.5625rem
  width: 6.25rem
  background-color: colors-ui-surface-primary-tertiary
  color: colors-ui-text-primary-body
  font-size: 0.9375rem
  border-radius: 0.9375rem
  cursor: pointer
  display: none
  position: absolute
  // right: 75px
  left: 0

  &.active
    border-radius: 0.9375rem
    border: 0.125rem solid
    border-color: rgb(126, 126, 126)
    text-align: center
    height: 1.5625rem
    width: 6.25rem
    background-color: #b8c0cf
    // A surface token as text: #b5ae9f on this #b8c0cf in the light theme,
    // 1.2:1, so there body text (`by-mode`, defaults.styl).
    color: by-mode(colors-ui-surface-primary-tertiary, colors-ui-text-primary-body)
    font-size: 0.9375rem
    cursor: pointer
    position: absolute
    // right: 75px
    left: 0

  &:hover
    background-color: #b8c0cf
    // As `&.active` above.
    color: by-mode(colors-ui-surface-primary-tertiary, colors-ui-text-primary-body)

  ::after
    margin-left: 0.625rem !important

.expanded-compound-select-view-kind
  margin-left: 32%

