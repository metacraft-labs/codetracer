.write-file
  background-color: colors-ui-surface-base-panel
  color: colors-ui-text-primary-body

  .write-file-path
    color: blue
  .write-file-content
    height: 6.25rem



.read-file
  background-color: blue
  color: white

  .read-file-path
    color: #eee
  .read-file-content
    height: 6.25rem
    overflow: hidden

.open-dir, .read-dir
  background-color: green
  color: black

.traceLog
  display: flex;
  flex-direction: column;
  color: colors-ui-text-primary-body
  height: 100%
  min-height: 0
  overflow: hidden

  .trace-log-table-header
    display: grid
    grid-template-columns: 7.5rem 10rem 11.25rem minmax(0, 1fr)
    flex: 0 0 1.5rem
    align-items: center
    border-bottom: 0.0625rem solid colors-ui-surface-input-default
    color: colors-ui-text-primary-body
    font-family: "SpaceGrotesk"
    font-size: 0.8125rem
    line-height: 1.25rem
    padding: 0 0.5rem

  .trace-log-table-body
    flex: 1 1 auto
    min-height: 0
    overflow-y: auto
    overflow-x: hidden
    font-family: "SpaceMono", monospace
    font-size: 0.8125rem
    line-height: 1.25rem

  .trace-log-row
    display: grid
    grid-template-columns: 7.5rem 10rem 11.25rem minmax(0, 1fr)
    min-height: 1.5rem
    align-items: center
    border-top: 0.0625rem solid colors-ui-border-secondary
    color: colors-ui-text-primary-body
    padding: 0 0.5rem
    cursor: pointer

    &:hover,
    &.selected
      background: colors-ui-surface-primary-secondary-hover

  .trace-col-rr-ticks,
  .trace-col-location,
  .trace-col-function,
  .trace-col-locals
    min-width: 0
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap

  .trace-col-rr-ticks
    position: relative
    padding-left: 0.25rem

    .event-rr-ticks-line
      position: absolute
      left: 0
      right: 0.75rem
      bottom: 0.25rem
      height: 0.125rem
      background: colors-ui-text-primary-active

  .trace-log-empty
    padding: 0.75rem 0.5rem
    color: colors-ui-text-primary-body
    font-family: "SpaceGrotesk"
    font-size: 0.8125rem

    &.hidden
      display: none

  .trace-location
    width: 20%

  .trace-function-name
    width: 10%

  .trace-values
    width: 45%
    cursor: pointer
    text-overflow: ellipsis
    overflow: visible
    white-space: nowrap
    display: flex


.trace-main
  // stop:8px
  top: 0.5rem
  background-color: colors-ui-surface-base-panel
  color: colors-ui-text-primary-body
  // width: calc(100%+71px)
  width: 100% !important
  padding-right: 1ch
  // height: 36ch
  position: absolute
  if IS_EXTENSION
    max-width: calc(100% - 0.9375rem)
  // left: -81px

  .editor-textarea
    z-index: TRACE_LOG_EDITOR_Z_INDEX + 5

  .cursor
    z-index: TRACE_LOG_EDITOR_Z_INDEX + 4

  .view-overlays.focused
    z-index: TRACE_LOG_EDITOR_Z_INDEX + 3
    opacity: 0.4
    cursor: text

  .view-overlays
    z-index: 5
    cursor: text

  .view-lines
    z-index: TRACE_LOG_EDITOR_Z_INDEX + 1

  .trace-view
    position: relative
    width: 100%
    display: flex
    flex: 1 1 0
    height: 100%
    flex-direction: column
    min-height: 0
    overflow: hidden

    .chart-results-container
      display: flex
      flex: 1 1 auto
      flex-direction: column
      width: 100%
      height: 100%
      min-height: 0
      overflow: hidden

    .dt-scroll
      overflow-x: auto !important

    .dt-scroll-body
      overflow-x: auto !important
      overflow-y: auto !important

    .trace-table
      width: max-content !important
      min-width: 100%
      max-width: none

      tbody
        width: max-content
        min-width: 100%

    .direct-location-rr-ticks
      transform: translateY(0)
      padding-top: 0.125em
      flex: 0 0 auto
      min-width: max-content

    tbody
      tr
        height: 1.5em
        width: max-content
        min-width: 100%

      td
        height: 1.5em
        flex-shrink: 0

    .rr-ticks-time-container
      height: 1em
      line-height: normal

    .trace-line
      width: 20%
      color: colors-ui-text-primary-body

    .trace-values
      padding-top: 0.25em !important
      line-height: 1em !important
      width: auto
      min-width: max-content
      flex: 0 0 auto
      color: colors-ui-text-primary-body
      cursor: pointer
      overflow: visible
      white-space: nowrap
      display: block

      // &:hover
      //   overflow-x: overlay !important

      //   &::-webkit-scrollbar-thumb:horizontal
      //     border: 0px !important
      //     background-color: colors-ui-surface-primary-tertiary

      //   &::-webkit-scrollbar
      //     height: 4px !important

    // .odd, .even
    //  opacity: 0.5

    .direct-location-rr-ticks
      width: 20%
      height: 1.375em

    .chart-table
      width: 100%
      display: flex
      flex: 1 1 auto
      flex-direction: column
      height: 100%
      min-height: 0
      overflow: hidden

  .scrollbar
    .slider
      border-radius: 0.15625em

  .trace-chevron
    position: absolute
    left:50%

    .trace-chevron-baseline
      position: absolute;
      width: 5rem;
      height: 0.125rem;
      top: 0;
      background-color: colors-ui-text-primary-label;
      z-index: 3;
      left: calc(50% - 2.5rem);
      border-top-left-radius: 0.125rem
      border-top-right-radius: 0.125rem

    .trace-chevron-baseline-cut
      position: absolute;
      width: 0.625rem;
      height: 0.125rem;
      top: 0;
      background-color: colors-ui-surface-input-default;
      z-index: 3;
      left: calc(50% - 0.3125rem);

    .trace-chevron-arrow
      color: colors-ui-text-primary-label
      cursor: pointer
      position: absolute
      left: 50%
      z-index: 4

      &::before
        border-style: solid
        border-width: 0.125rem 0.125rem 0 0
        content: ''
        display: inline-block
        height: 0.5625rem
        left: -0.28125rem
        position: absolute
        top: -0.3125rem
        transform: rotate(315deg)
        vertical-align: top
        width: 0.5625rem

  .trace-modal
    border: 0.0625rem solid black
    position: relative
    display: none
    margin-left: 3.75rem
    background-color: colors-ui-surface-input-default
    width: 85%
    overflow: visible
    z-index: TRACE_LOG_EDITOR_Z_INDEX + 5

    .value-view
      position: relative !important

    .modal-close-button
      position: absolute
      top: 0.1875rem
      right: 0
      height: 1.0625rem
      display: flex
      z-index: 2

    .modal-close-button::after
      content: "X"
      font-size: 0.9375rem
      font-weight: bold

    .select-kind-button-container
      display: none

    .value-expanded-compound
      height: 100%

    .value-expanded-view
      overflow-x: auto
      background-color: inherit

    .atom-even
      height: 100%
      background-color: inherit

    .atom-odd
      height: 100%
      background-color: inherit


.current-trace
  border-color: #00a

.trace-menu
  min-height: 2.25rem
  // width: 100%
  display: flex
  flex: 0 0 auto
  padding-left: 0.375rem
  padding-right: 0.375rem
  // padding-bottom: 8px
  padding-top: 0.375rem
  align-items: start
  justify-content: space-between
  border-radius: 0.375rem

  .trace-search
    line-height: 0

  .dropdown-list
    position: absolute
    top: 100%
    background-color: transparent
    width: fit-content !important

    .trace-dropdown-list-container
      padding: 0.25rem
      background-color: colors-ui-surface-base-raised
      border-radius: 0.375rem

  .dropdown-list.active
    .fa
      // A surface token as an icon: the window ground's own colour in the
      // light theme, so there the icon token (`by-mode`, defaults.styl).
      color: by-mode(colors-ui-surface-input-default, colors-ui-icon-primary-default)

  .run-trace-button
    border-radius: 0.375rem;
    // The run glyph: white (BORDER_COLOR is DEFAULT, white) on the tertiary
    // surface, 2.2:1 in the light theme, which takes the icon token
    // (`by-mode`, defaults.styl).
    color: by-mode(BORDER_COLOR, colors-ui-icon-primary-default);
    cursor: pointer;
    height: 1.5rem;
    background: colors-ui-surface-primary-tertiary;
    width: 1.5rem;
    position: relative;
    z-index: TRACE_LOG_EDITOR_Z_INDEX + 7
    display: flex
    justify-content: center
    align-items: center

    &:hover
      background: colors-ui-surface-base-panel

  .trace-search
    width: -moz-available
    width: -webkit-fill-available
    width: stretch
    padding-right: CONTROL_GAP

    // input
    //   height: 24px
    //   font-size: 14px
    //   border: 0
    //   background-color: colors-ui-surface-primary-tertiary
    //   color: colors-ui-text-primary-body
    //   margin-left: 10%
    //   // margin-top: 5px
    //   margin-bottom: 0px !important
    //   border-radius: 6px
    //   padding-left: 24px

    //   &:focus
    //     border: 1px solid colors-ui-border-secondary
    //     outline: none

  .hamburger-dropdown
    border-radius: 0.375rem
    height: 1.5rem
    z-index: TRACE_LOG_EDITOR_Z_INDEX + 7
    top: 0

  .trace-dropdown-menu
    display: none

    &.active
      background: #b8c0cf !important
      position: absolute
      border: 0.0625rem solid
      border-radius: 0.625rem
      // A dropdown's outline: the primary border token in the light theme
      // (`by-mode`, defaults.styl).
      border-color: by-mode(darkgrey, colors-ui-border-primary)
      padding-top: 0
      padding-left: 0.3125rem
      padding-right: 0.625rem
      padding-bottom: 0.625rem
      margin-top: 0.3125rem
      z-index: 56
      top: 0
      right: 1.25rem
      transform: translate3d(0, 1.625rem, 0)
      display: block
      color: black

  .trace-search-unselected
    flex-basis: 75%

  .trace-right
    position: relative
  // right: 0px

  .trace-menu-header
    height: 1.875rem
    margin-top: 0.3125rem

    // button
    //   background-color: TRACE_HEADER_BACKGROUND_COLOR
    //   color: colors-ui-text-primary-body
    //   height: 25px
    //   margin-top: 0
    //   margin-left: 0
    //   margin-right: 0
    //   padding: 0
    //   width: 50%
    //   float: left

    .dropdown
      border-radius: 0.9375rem
      color:#434f6a
      cursor: pointer
      height: 1.875rem
      margin-top: 0.625rem
      background-color: colors-ui-surface-input-default
      padding-top: 0.125rem
      padding-left: 0.9375rem
      padding-right: 1.875rem
      right: 0.625rem
      width: 1.875rem
      position: absolute
      z-index: 1

  .search-traces
    flex-basis: 50%
    margin: 0
    padding: 0

  .trace-buttons-container
    display: flex
    gap: 0.375rem

.kind-dropdown-menu
  background: #b8c0cf !important
  position: absolute
  border: 0.0625rem solid
  border-radius: 0.625rem
  // As `.trace-dropdown-menu` above.
  border-color: by-mode(darkgrey, colors-ui-border-primary)
  padding-top: 0
  padding-left: 0.3125rem
  padding-right: 0.625rem
  padding-bottom: 0.625rem
  margin-top: 0.3125rem
  width: fit-content
  z-index: 56
  top: 0 !important
  // right: 75px
  transform: translate3d(0, 1.3125rem, 0)
  display: block
  color: black
  user-select: none


