.tracepoint-overlay
  opacity: 0.8
  background-color: colors-ui-surface-base-panel
  color: colors-ui-text-primary-body
  z-index: TRACE_LOG_EDITOR_Z_INDEX + 6
  position: absolute
  width: 100%
  height: 100%
  display: flex
  align-items: center
  justify-content: center
  overflow: hidden !important

.trace-overlay
  font-family: "SpaceGrotesk"
  position: relative
  // top: calc(50% - 0.5ex)
  font-size: 0.875rem
  text-align: center
  cursor: text
  user-select: text

.graph
  position: absolute
  z-index: 21
  visibility: hidden

.expand-trace
  cursor: pointer
  opacity: 0

.trace
  // width: 100%
  height: 100%
  z-index: TRACE_LOG_EDITOR_Z_INDEX

// .trace > div
//   width: 100%

.error-trace
  color: colors-ui-text-error-primary
  padding-right: 0.5rem

// The tracepoint view-kind menu (table / line / pie) is Bootstrap markup, and
// Bootstrap's `.dropdown-item:hover` paints a LIGHT #f8f9fa row with dark text —
// on the dark theme.  The list hover instead (LIST_HOVER_BG, button.styl), with
// the text left as it is.  One class deeper than Bootstrap's rule, to win.
.dropdown-menu .dropdown-item:hover,
.dropdown-menu .dropdown-item:focus
  background-color: LIST_HOVER_BG
  color: inherit
