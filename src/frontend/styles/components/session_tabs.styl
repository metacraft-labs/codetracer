// Session tab bar (M10) — rendered inside the caption/menu bar area,
// next to the omnibox / command palette.  Visually sits in the title bar
// like browser tabs.

.session-tab-bar
  display flex
  align-items center
  // Flex child of the caption bar: menu/debug controls/omnibox/tabs share
  // one row, so the new-tab button cannot drift over the omnibox.
  order 4
  position relative
  // Basis 0 so this and the debug toolbar split the caption bar's free space
  // evenly, which is what leaves the command prompt centred between them.
  flex 1 1 0
  min-width 3.5em
  max-width 100%
  height 100%
  padding 0
  // #menu has gap: 0.5em between flex children. Negative margin brings the
  // effective gap between the omnibox and the "+" button down to 0.25em.
  margin-left calc(0.25em - 0.5em)
  z-index 21  // Above #menu (z-index 20) so tabs are clickable
  -webkit-app-region drag  // Empty bar area is draggable; child tabs/buttons override with no-drag
  overflow hidden
  box-sizing border-box

  // When there is only a single session, keep the tab bar in the DOM but
  // hide the individual tab labels (the lone tab just shows the trace path
  // and wastes horizontal space).  The "+" button remains visible so the
  // user can open additional sessions at any time.
  &.single-session
    .session-tab
      display none

  &.has-overflow
    .session-tab-overflow
      display flex

  &.overflow-open
    overflow visible

    .session-tab-overflow-menu
      display flex

    // Open: the chevron points up and the circle is the hover fill at 35%
    // (Nikolay, 2026-11-03; D-33).
    .session-tab-overflow
      background-color rgba(colors-ui-surface-primary-tertiary-hover, 0.35)

      &::before
        transform rotate(180deg)

      &:hover
        background-color colors-ui-surface-primary-tertiary-hover

.session-tab
  display flex
  align-items center
  flex 0 1 10em
  min-width 6em
  max-width 10em
  padding 0 0.625em
  height 1.625em
  cursor pointer
  // Caption text, dimmed further by the opacity below. The dark theme keeps
  // its #b0b0b0 (no token has that Dark value; `by-mode`, defaults.styl); the
  // light one takes `text/primary/caption`, since #b0b0b0 is 2:1 on the light
  // tab bar.
  color by-mode(#b0b0b0, colors-ui-text-primary-caption)
  opacity 0.7
  // The hover colour (`surface/primary/tertiary-hover`) at 25% on screen
  // (D-33). Written as 0.25 / 0.7 because the tab's 0.7 opacity above dims its
  // fill too; change both together (Nikolay, 2026-11-03).
  background-color rgba(colors-ui-surface-primary-tertiary-hover, (0.25 / 0.7))
  // The design system's control radius (`border/radius/control`, 6px) — the
  // same corners as the command prompt beside these tabs (command-palette.styl,
  // 0.375rem).  Was 0.25em (4px).  The token is unitless px, hence the rem
  // conversion against the 16px root.
  border-radius unit(border-border-radius-control / 16, 'rem')
  // 6px to the next tab, the overflow button or the "+", as between any two
  // controls (CONTROL_GAP, D-32).  Was 0.25em (4px) (Nikolay, 2026-11-03).
  margin-right CONTROL_GAP
  white-space nowrap
  user-select none
  transition background-color 150ms ease, color 150ms ease, opacity 150ms ease
  -webkit-app-region no-drag
  &:hover
    color colors-ui-text-primary-body
    opacity 1.0
    background-color colors-ui-surface-primary-secondary-hover
  // The active session. The dark theme keeps its #3c3c3c (no token has that
  // Dark value; `by-mode`, defaults.styl); the light one takes
  // `surface/primary/tertiary`, one step above the hover surface as #3c3c3c is
  // in the dark, and body text, since white would not read on it.
  &.active
    background-color by-mode(#3c3c3c, colors-ui-surface-primary-tertiary)
    color by-mode(#ffffff, colors-ui-text-primary-body)
    opacity 1.0

.session-tab-label
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  min-width 0
  flex 1 1 auto

.session-tab-close
  width 0.6em
  height 0.6em
  background-image LAYOUT_TAB_CLOSE_ICON_PATH
  background-size 0.6em 0.6em
  background-repeat no-repeat
  background-position center
  margin-left 0.5em
  flex-shrink 0
  cursor pointer
  opacity 0.4
  transition opacity 150ms ease
  &:hover
    opacity 1

// Session GL containers — each session keeps its own GoldenLayout instance
// alive.  Switching sessions toggles visibility instead of destroy/recreate.
.session-container
  width 100%
  height 100%

.session-container.hidden
  display none

.session-tab-add
  display flex
  align-items center
  justify-content center
  flex 0 0 auto
  // The trace tabs' height, 26px (`.session-tab`, 1.625em at 16px) — the
  // MEDIUM control size (button.styl) — so the circle sits level with the tab
  // it opens, top and bottom.  Not the caption bar's large size: it belongs to
  // the tab strip, not to the toolbar.
  width CONTROL_HEIGHT_MD !important
  max-width CONTROL_HEIGHT_MD !important
  height CONTROL_HEIGHT_MD !important
  max-height CONTROL_HEIGHT_MD !important
  cursor pointer
  user-select none
  font-size 1em
  -webkit-app-region no-drag

// The "+" that opens a new trace tab.  NOT an ordinary icon button: a filled
// circle with no outline, and it behaves like the trace tabs beside it
// (`.session-tab` above) — its mark rests dim at 70% in the tab's #b0b0b0,
// comes up to full strength under the pointer, and goes white while pressed.
// Timing: the shared button transition (BUTTON_TRANSITION, button.styl), like
// every other button — the fill, the mark's colour and its opacity together.
//
// Fill: `surface/primary/tertiary` at rest, `surface/primary/tertiary-hover`
// under the pointer, and the active trace tab's #3c3c3c while pressed.
//
// The mark is drawn as a mask filled with `currentColor` rather than as a
// background image: the SVG bakes its colour in (#dddddd), so as an image it
// could not follow the tab's states.
//
// `#menu` in the selector only for weight — the icon-button outline and the
// secondary-button fill (button.styl) both outrank a single class.
#menu .session-tab-add
  border none !important
  border-radius 50% !important
  background-color colors-ui-surface-primary-tertiary
  background-image none !important
  // The "+" mark, drawn in currentColor on the tertiary disc: in the light
  // theme the label token, as caption text would be 2:1 on that disc.
  color by-mode(#b0b0b0, colors-ui-text-primary-label)
  transition BUTTON_TRANSITION

  &::before
    content ""
    width 0.75em
    height 0.75em
    background-color currentColor
    -webkit-mask-image url('../../public/resources/shared/session_tab_add.svg')
    mask-image url('../../public/resources/shared/session_tab_add.svg')
    -webkit-mask-repeat no-repeat
    mask-repeat no-repeat
    -webkit-mask-position center
    mask-position center
    -webkit-mask-size contain
    mask-size contain
    opacity 0.7
    transition opacity BUTTON_TRANSITION_TIMING

  &:hover
    background-color colors-ui-surface-primary-tertiary-hover
    color colors-ui-text-primary-body

    &::before
      opacity 1

  // The active tab's colours, as the note above says. In the light theme
  // that fill is also this button's resting one, so a press shows only as the
  // ink and the mark's opacity.
  &:active
    background-color by-mode(#3c3c3c, colors-ui-surface-primary-tertiary)
    color by-mode(#ffffff, colors-ui-text-primary-body)

    &::before
      opacity 1

.session-tab-overflow
  display none
  align-items center
  justify-content center
  // Looks and behaves like the "+" beside it (`#menu .session-tab-add`): a
  // 26px circle (CONTROL_HEIGHT_MD) with the same fill, mark colour and 70%
  // mark at rest, and the same hover and press (Nikolay, 2026-11-03; D-33).
  flex 0 0 CONTROL_HEIGHT_MD
  width CONTROL_HEIGHT_MD
  height CONTROL_HEIGHT_MD
  // 6px to the "+", as between any two controls (D-32).
  margin-right CONTROL_GAP
  cursor pointer
  background-color colors-ui-surface-primary-tertiary
  color by-mode(#b0b0b0, colors-ui-text-primary-label)
  user-select none
  border-radius 50%
  -webkit-app-region no-drag
  transition BUTTON_TRANSITION

  // The Design System's chevron-down (Figma `icons-lg=chevron-down`),
  // painted in currentColor so it follows the caption/hover colours. It
  // replaced a typed "⌄" character (Nikolay, 2026-11-03; D-33).
  &::before
    content ""
    // 18px (Nikolay, 2026-11-03).
    width 1.125rem
    height 1.125rem
    background-color currentColor
    -webkit-mask-image url('../../public/resources/shared/build_chevron_down.svg')
    mask-image url('../../public/resources/shared/build_chevron_down.svg')
    -webkit-mask-repeat no-repeat
    mask-repeat no-repeat
    -webkit-mask-position center
    mask-position center
    -webkit-mask-size contain
    mask-size contain
    opacity 0.7
    transition opacity BUTTON_TRANSITION_TIMING, transform 150ms ease

    @media (prefers-reduced-motion: reduce)
      transition opacity BUTTON_TRANSITION_TIMING

  &:hover
    background-color colors-ui-surface-primary-tertiary-hover
    color colors-ui-text-primary-body

    &::before
      opacity 1

  &:active
    background-color by-mode(#3c3c3c, colors-ui-surface-primary-tertiary)
    color by-mode(#ffffff, colors-ui-text-primary-body)

    &::before
      opacity 1

.session-tab-overflow-menu
  display none
  position absolute
  right 0.25em
  // Below the caption bar, by DROPDOWN_TRIGGER_GAP
  // (components/shared_widgets.styl), like the application menu on the other
  // side of the bar.
  //
  // Measured from THIS element's containing block, which is `.session-tab-bar`
  // — and the tab bar starts 0.375rem (6px) down, inside `#menu`'s top padding
  // (CAPTION_BAR_PADDING_TOP, menu_bar.styl).  So the offset is the bar's
  // height less that inset, plus the gap: 38px - 6px + 6px = 38px (it was
  // 34px while the bar's bottom padding was 2px).
  // It was 2.25em while the bar's top padding was 4px; left there, the menu
  // would open 8px below the bar rather than 6.
  // 6px below the caption bar, like every menu (DROPDOWN_TRIGGER_GAP): the
  // bar's height less the 6px the tab bar starts below the bar's top, plus
  // the gap — measured from the tab bar, which is what this menu hangs from.
  top "calc(%s - %s + %s)" % (CAPTION_BAR_HEIGHT CAPTION_BAR_PADDING_TOP DROPDOWN_TRIGGER_GAP)
  min-width 13.75em
  max-width 22.5em
  max-height 70vh
  flex-direction column
  padding 0.25em
  dropdown-surface()
  // After the mixin on purpose: it sets `overflow: hidden` so rows cannot spill
  // past the rounded corners, but this menu has to scroll once enough tabs
  // overflow to fill it.
  overflow auto
  z-index 120
  -webkit-app-region no-drag

.session-tab-overflow-item
  // D-26.  The height and padding are rem so they stay 28px and 10px.
  font-size 0.875rem
  min-height 1.75rem
  padding 0 0.625rem
  display flex
  align-items center
  // Caption text in the light theme, as the tabs (`.session-tab`).
  color by-mode(#b0b0b0, colors-ui-text-primary-caption)
  cursor pointer
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  // The active session, in its tab's colours.
  &.active
    background-color by-mode(#3c3c3c, colors-ui-surface-primary-tertiary)
    color by-mode(#ffffff, colors-ui-text-primary-body)
  // The dropdown hover (DROPDOWN_HOVER_BG, button.styl): background only, square.
  &:hover
    background-color DROPDOWN_HOVER_BG
