// Session tab bar (M10) — rendered inside the caption/menu bar area,
// next to the omnibox / command palette.  Visually sits in the title bar
// like browser tabs.

.session-tab-bar
  display flex
  align-items center
  // Flex child of the caption bar: menu/debug controls/omnibox/tabs share
  // one row, so the new-tab button cannot drift over the omnibox.
  order 4
  position relative
  flex 1 1 auto
  min-width 3.5em
  max-width 100%
  height 100%
  padding 0
  // #menu has gap: 0.5em between flex children. Negative margin brings the
  // effective gap between the omnibox and the "+" button down to 0.25em.
  margin-left calc(0.25em - 0.5em)
  z-index 21  // Above #menu (z-index 20) so tabs are clickable
  -webkit-app-region no-drag
  overflow hidden
  box-sizing border-box

  // When there is only a single session, keep the tab bar in the DOM but
  // hide the individual tab labels (the lone tab just shows the trace path
  // and wastes horizontal space).  The "+" button remains visible so the
  // user can open additional sessions at any time.
  &.single-session
    .session-tab
      display none

  &.has-overflow
    .session-tab-overflow
      display flex

  &.overflow-open
    overflow visible

    .session-tab-overflow-menu
      display flex

.session-tab
  display flex
  align-items center
  flex 0 1 10em
  min-width 6em
  max-width 10em
  padding 0 0.625em
  height 1.625em
  cursor pointer
  color #b0b0b0
  opacity 0.7
  border-radius 0.25em
  margin-right 0.25em
  white-space nowrap
  user-select none
  transition background-color 150ms ease, color 150ms ease, opacity 150ms ease
  -webkit-app-region no-drag
  &:hover
    color colors-ui-text-primary-body
    opacity 1.0
    background-color colors-ui-surface-primary-secondary-hover
  &.active
    background-color #3c3c3c
    color #ffffff
    opacity 1.0

.session-tab-label
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  min-width 0
  flex 1 1 auto

.session-tab-close
  width 0.6em
  height 0.6em
  background-image LAYOUT_TAB_CLOSE_ICON_PATH
  background-size 0.6em 0.6em
  background-repeat no-repeat
  background-position center
  margin-left 0.5em
  flex-shrink 0
  cursor pointer
  opacity 0.4
  transition opacity 150ms ease
  &:hover
    opacity 1

// Session GL containers — each session keeps its own GoldenLayout instance
// alive.  Switching sessions toggles visibility instead of destroy/recreate.
.session-container
  width 100%
  height 100%

.session-container.hidden
  display none

.session-tab-add
  display flex
  align-items center
  justify-content center
  flex 0 0 auto
  width 1.75em !important
  max-width 1.75em !important
  height 1.75em !important
  max-height 1.75em !important
  cursor pointer
  user-select none
  border-radius 50% !important
  border none !important
  background-image url('../../public/resources/shared/session_tab_add.svg')
  background-position center
  background-repeat no-repeat
  background-size 0.75em 0.75em !important
  font-size 1em
  -webkit-app-region no-drag

.session-tab-overflow
  display none
  align-items center
  justify-content center
  flex 0 0 1.625em
  width 1.625em
  height 1.625em
  margin-right 0.125em
  cursor pointer
  color #b0b0b0
  font-size 1.25em
  line-height 1
  user-select none
  border-radius 0.25em
  -webkit-app-region no-drag
  transition color 150ms ease, background-color 150ms ease
  &:hover
    color colors-ui-text-primary-body
    background-color colors-ui-surface-primary-secondary-hover

.session-tab-overflow-menu
  display none
  position absolute
  right 0.25em
  top 2.125em
  min-width 13.75em
  max-width 22.5em
  max-height 70vh
  overflow auto
  flex-direction column
  padding 0.25em
  border-radius 0.375em
  background-color colors-ui-surface-primary-default
  border 1px solid colors-ui-border-primary
  box-shadow 0 0.75em 1.875em rgba(0, 0, 0, 0.35)
  z-index 120
  -webkit-app-region no-drag

.session-tab-overflow-item
  min-height 1.75em
  padding 0 0.625em
  display flex
  align-items center
  color #b0b0b0
  cursor pointer
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  border-radius 0.25em
  &.active
    background-color #3c3c3c
    color #ffffff
  &:hover
    color colors-ui-text-primary-body
    background-color colors-ui-surface-primary-secondary-hover
