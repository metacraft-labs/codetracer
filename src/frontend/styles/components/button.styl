@import "../generated/index"

// -- Buttons --
button
  font-family: "SpaceMono"
  border-radius: 0.5em !important
  display: inline-flex
  outline: none
  border-width: 0em
  flex: 0 0 1.75em !important
  box-sizing: border-box
  white-space: nowrap


  &:hover:not(:disabled)
    color: colors-ui-text-primary-body

  &:focus-visible:not(:disabled)
    outline: none !important
    box-shadow: inset 0 0 0 0.125em colors-ui-border-focus !important
    color: colors-ui-text-primary-body

  &:disabled
    // `colors-ui-text-disabled-default` was never a token. The generated set
    // spells it `colors-ui-text-primary-disabled` (`generated/mapped.styl`),
    // and Stylus passes an unknown identifier through as a bare literal
    // rather than failing, so the built CSS carried
    // `color: colors-ui-text-disabled-default` — which no browser can parse
    // and every browser drops. A disabled button therefore got `opacity` and
    // no colour change at all, for as long as the rule has existed.
    //
    // That matters here beyond tidiness: the toolbar's marks are now inline
    // SVG painted `currentColor`, so this declaration IS the inert treatment.
    // Left misspelled, the marks would inherit the enabled colour and be told
    // apart from live controls by opacity alone.
    color: colors-ui-text-primary-disabled !important
    opacity: 0.5
    pointer-events: none
    cursor: not-allowed

// Sizes
//
// Each size matches TWO spellings, because the class the markup emits carries a
// variant segment: an icon button is `ct-button-image-md-secondary` and a text
// button is `ct-button-text-md-secondary`.  Neither contains the substring
// `ct-button-md-`, so a bare `[class*="ct-button-md-"]` matches NEITHER — and
// the text buttons went unstyled for their whole existence, falling back to the
// user-agent's `padding: 1px 6px`.  That 1px is why the edit-mode toolbar's
// labels sat crammed against their borders.
//
// Only the `-text-` spellings are added.  Icon buttons miss these rules too,
// but they set their own `width`/`height` and centre their glyph, so padding
// has nothing to push there — adding it would move glyphs that are correct
// today, which is a different change from fixing a selector that matches
// nothing.
[class*="ct-button-lg-"]
[class*="ct-button-text-lg-"]
  padding: 0.75em 0.875em 0.75em 0.875em

[class*="ct-button-md-"]
[class*="ct-button-text-md-"]
  padding: 0.5em 0.75em 0.5em 0.75em

[class*="ct-button-sm-"]
[class*="ct-button-text-sm-"]
  padding: 0.25em 0.625em 0.25em 0.625em

// TODO: For now restrict to button class -
// later on maybe combine the three styles?
[class*="-button-"][class*="-primary"]
  background-color: colors-ui-surface-action-primary
  color: colors-ui-text-on-action-primary

  &:hover
    background-color: colors-ui-surface-action-primary-hover !important

[class*="-button-"][class*="-tertiary"]
  background-color: colors-ui-surface-primary-tertiary
  color: colors-ui-text-primary-body-subtle

  &:disabled
    border: 0.03125em solid colors-ui-border-disabled

[class*="-button-"][class*="-primary"]
[class*="-button-"][class*="-tertiary"]
  &:hover
    background-color: colors-ui-surface-primary-tertiary-hover

  &:disabled
    background-color: colors-ui-surface-primary-disabled

[class*="-button-"][class*="-secondary"]
  background-color: colors-ui-surface-primary-default
  border: 0.03125em solid colors-ui-border-primary
  color: colors-ui-text-primary-body-subtle

  &:hover
    background-color: colors-ui-surface-primary-default-hover

  &:focus-visible:not(:disabled)
    background-color: colors-ui-surface-primary-secondary

[class*="ct-button-sm-secondary"]
    border: 0em !important

// -- Icon-buttons --
[class*="ct-button-image-"]
  background-position: center
  background-size: auto 1em !important
  background-repeat: no-repeat
  border-radius: 0.375em !important
  // `button` is already `display: inline-flex`; these two centre an inline
  // SVG mark the way `background-position: center` centred the images that
  // some of these buttons still use.
  align-items: center
  justify-content: center

[class*="ct-button-image-lg-"]
  width: 2em
  max-width: 2em
  height: 2em
  max-height: 2em

[class*="ct-button-image-md-"]
  width: 1.75em
  max-width: 1.75em
  height: 1.75em
  max-height: 1.75em

[class*="ct-button-image-sm-"]
  width: 1.25em
  max-width: 1.25em
  height: 1.25em
  max-height: 1.25em

[class*="ct-button-image-xs-"]
  width: 1em
  max-width: 1em
  height: 1em
  max-height: 1em

// -- The debugger control strip's marks --
//
// The twelve marks on this bar are inline SVG (`views/debug_control_marks`),
// not `background-image`. They used to be twelve `.svg` files with a
// near-white fill baked in, named by `ct-images-*` variables that ONLY
// `default_dark_theme.styl` defined. On the white theme those identifiers
// resolved to nothing, and Stylus emits an unknown identifier as a bare
// literal instead of failing — so the built white CSS carried
// `background-image: ct-images-continue`, which every browser drops, and the
// strip rendered twelve blank buttons. A mark that inherits `color` cannot
// have either failure: there is no asset to leave undefined and no colour to
// bake in.
//
// This rule sizes them and nothing else. No `fill` or `stroke` here: those
// are `currentColor` on the paths themselves, and a CSS `fill` would override
// the `fill="none"` that the stroked marks need on their arrow.
.ct-control-mark
  // 1em square, which is the height `background-size: auto 1em` gave the
  // assets this replaces, so the strip's optical weight is unchanged.
  width: 1em
  height: 1em
  flex: 0 0 auto
  // The mark is decoration inside a button that already handles the click;
  // without this, `:hover` flickers as the pointer crosses the glyph's edge.
  pointer-events: none

#reset-operation-loading-image
  background-image: ct-images-reset-operation-loading

#stop-image
  background-image: ct-images-stop

#jump-before-image
  background-image: ct-images-jump-before

#jump-after-image
  background-image: ct-images-jump-after

// `run-tests-image` is the ONE id the two topbar surfaces share, and the
// page-object contract says so out loud (`EDIT_TOOLBAR_IDS.runTests` in
// `src/tests/gui/page-objects/debug-toolbar-ids.ts`).  On the debugger strip it
// is an ICON button; on the edit-mode strip it is the TEXT button labelled
// "Run Tests".  Keyed on the id alone, this rule reached both.
//
// On a text button the damage is not a stray icon, it is an unreadable control.
// The declarations that tame a background image — `no-repeat`, `auto 1em`,
// `center` — all live on `[class*="ct-button-image-"]`, which a text button
// does not carry, so the 21x16 asset fell back to the initial values and TILED
// across the button: four columns by two rows of `</  />` chevrons printed on
// top of the words. That is what "the toolbar looks broken" was pointing at.
//
// Requiring the image-button class is therefore not a specificity tweak but the
// actual precondition: this declaration is only meaningful on an element that
// also gets the sizing rules above.
#run-tests-image[class*="ct-button-image-"]
#jump-to-live-debug
  background-image: ct-images-run-tests

#run-tests-loading-image
  background-image: ct-images-run-tests-loading

#copy-path-image
  background-image: ct-images-copy-path

#category-image
  background-image: ct-images-layout-tab
  background-size: 1em auto !important

  // States match `.vcs-branch-current` (vcs.styl), the reference for anything
  // that opens a menu: a 1px border, transparent at rest, grey on hover and
  // blue while the menu is open, with the surface left alone throughout.
  //
  // Two inherited behaviours have to be undone for that. `ct-button-no-border`
  // sets `border: none !important`, so the width has to come back with
  // `!important`; and `[class*="-secondary"]:hover` lightens the background,
  // which would double up on the border as a second state cue.
  //
  // The width lives on the base rule and `box-sizing: border-box` is already
  // set on `button`, so the control stays 28x28 in every state and the centred
  // icon does not move.  This replaces an inset `box-shadow` that drew a fake
  // border in `em` — 0.0625em against a 16px button, so a hair under 1px.
  border: 0.0625rem solid transparent !important

  &:hover
    border-color: colors-ui-border-primary-hover !important
    background-color: colors-ui-surface-primary-default

  &.open
    border-color: colors-ui-border-action !important
    background-color: colors-ui-surface-primary-default

#close-element
  background-image: ct-images-close-button
  background-size: 0.5em 0.5em !important

#backward-loop
  background-image: ct-images-omni-backward
  background-size: 0.5em !important
  z-index: 10
  height: 1.3em !important
  width: 1.3em !important
  max-width: 1.3em !important
  max-height: 1.3em !important

#forward-loop
  background-image: ct-images-omni-forward
  background-size: 0.5em !important
  z-index: 10
  height: 1.3em !important
  width: 1.3em !important
  max-width: 1.3em !important
  max-height: 1.3em !important

#trace-run-button
  background-image: ct-images-run-tracepoint
  background-size: 1.75em 1.75em !important
  z-index: 100

#hamburger-dropdown
  background-image: ct-images-hamburger-dropdown
  z-index: 100

.value-history-button
  background-image: ct-images-value-history-toggle
  background-size: auto 0.5em !important

  &:hover > .custom-tooltip
    opacity: 1
    visibility: visible
    transition-delay: TOOLTIP_DELAY_TIMER

  .custom-tooltip
    top: -30%
    left: 120%

    &:after
      content: '';
      position: absolute;
      left: -0.875em
      top: 20%
      border-width: 0.5em
      border-style: solid
      border-color: transparent colors-ui-surface-base-canvas transparent transparent

.ct-button-no-border
  border: none !important

.custom-tooltip
  display: block
  position: absolute
  font-family: "SpaceGrotesk"
  top: 100%
  background-color: colors-ui-surface-base-canvas
  color: colors-ui-text-primary-body
  padding: 0.3125em 0.625em
  font-size: 0.75em
  border-radius: 0.25em
  white-space: nowrap
  box-shadow: 0 0.25em 0.5em rgba(0, 0, 0, 0.2)
  opacity: 0
  visibility: hidden
  transition: opacity 0.3s ease, visibility 0.3s ease, top 0.3s ease
  pointer-events: none
  text-align: start
  line-height: 1em

  &.active
    opacity: 1
    visibility: visible
    top: -100%
    height: 1.5em
    right: 0.25em

    &:after
      content: ''
      position: absolute
      top: 100%
      left: unset
      right: 0.25em
      border-width: 0.5em
      border-style: solid
      border-color: colors-ui-surface-base-canvas transparent transparent transparent

  &:after
    content: ''
    position: absolute
    bottom: 100%
    left: calc(50% - 0.5em)
    border-width: 0.5em
    border-style: solid
    border-color: transparent transparent colors-ui-surface-base-canvas transparent

[class*="ct-button-image-"]:hover > .custom-tooltip
  opacity: 1
  visibility: visible
  top: calc(100% + 0.3125em)
  transition-delay: TOOLTIP_DELAY_TIMER

.ct-origin-badge
  display: inline-flex
  align-items: center
  justify-content: center
  padding: 0.2em 0.5em
  gap: 0.25em
  border-radius: 0.375em !important
  font-family: inherit
  font-size: 0.75em
  line-height: 1
  cursor: pointer
  user-select: none
  transition: background-color 0.15s ease, border-color 0.15s ease
  vertical-align: middle
  margin-left: 0.5em

  // Design system colors matching secondary image button
  background-color: colors-ui-surface-primary-default
  border: 0.03125em solid colors-ui-border-primary
  color: colors-ui-text-primary-body-subtle

  &:hover
    background-color: colors-ui-surface-primary-default-hover
    border-color: colors-ui-border-secondary

  &:focus-visible
    outline: none
    box-shadow: 0 0 0 0.125em colors-ui-border-focus

  .ct-origin-badge-icon
    display: inline-block
    width: 1.1em
    height: 1.1em
    background-size: contain
    background-repeat: no-repeat
    background-position: center
    flex: 0 0 auto

  .ct-origin-badge-text
    font-weight: 500
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap

  // Icon-only variant
  &.ct-origin-badge-icon-only
    padding: 0.125em
    border-radius: 0.375em !important
    width: 1.25em
    height: 1.25em

    .ct-origin-badge-text
      display: none

  // Placeholder variant
  &.ct-origin-badge-placeholder
    border-style: dashed
    background-color: transparent
    color: colors-ui-text-primary-body-subtle
    padding: 0.2em 0.5em

    .ct-origin-badge-icon
      display: none

// Icon backgrounds mapping to terminator types
.ct-origin-icon-sigma .ct-origin-badge-icon
  background-image: url("../../../public/resources/origin-icons/sigma.svg")
.ct-origin-icon-quotation .ct-origin-badge-icon
  background-image: url("../../../public/resources/origin-icons/quotation.svg")
.ct-origin-icon-door .ct-origin-badge-icon
  background-image: url("../../../public/resources/origin-icons/door.svg")
.ct-origin-icon-globe .ct-origin-badge-icon
  background-image: url("../../../public/resources/origin-icons/globe.svg")
.ct-origin-icon-clock-rewind .ct-origin-badge-icon
  background-image: url("../../../public/resources/origin-icons/clock-rewind.svg")
.ct-origin-icon-question .ct-origin-badge-icon
  background-image: url("../../../public/resources/origin-icons/question.svg")
.ct-origin-icon-hourglass .ct-origin-badge-icon
  background-image: url("../../../public/resources/origin-icons/hourglass.svg")
