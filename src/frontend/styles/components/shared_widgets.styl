// Gap between a menu's trigger and the surface it opens into.
//
// 6px at the 16px root, and 6px in every menu: the value is deliberately rem
// rather than em because these menus open from containers with different font
// sizes — the layout menu inherits 16px, the command prompt 12px — and an em
// gap would resolve to a different number of pixels in each, which is exactly
// the drift this constant exists to stop.
DROPDOWN_TRIGGER_GAP = 0.375rem

// The same gap expressed as an offset from the bottom of a relatively
// positioned trigger, for the menus that hang off their own control.
DROPDOWN_TRIGGER_OFFSET = "calc(100% + %s)" % DROPDOWN_TRIGGER_GAP

// Corner radius of a menu.
//
// One constant for every dropdown in the app, container and end rows alike:
// the rounding of a menu is a property of "menu", not of the panel it happens
// to open from.  rem for the same reason as the gap — these menus sit in
// containers from 12px to 16px, and an em radius drew a different curve in
// each.
DROPDOWN_RADIUS = 0.375rem

// Scrollbars inside a menu.
//
// The app-wide scrollbar (top of this file) is 0.5em, which is right for a
// panel but heavy inside a menu a few rows tall — it takes a visible bite out
// of a 12em-wide dropdown.  Its own constant rather than a reuse of
// DROPDOWN_TRIGGER_GAP: the two happen to be the same 6px, but a scrollbar's
// thickness and a menu's offset answer to different things and should be free
// to move apart.
DROPDOWN_SCROLLBAR_SIZE = 0.375rem

// Applied both to the surface itself (the branch picker, the command results
// and the tab-overflow menu each scroll as one element) and to anything that
// scrolls inside it.
dropdown-scrollbar()
  &::-webkit-scrollbar,
  ::-webkit-scrollbar
    width: DROPDOWN_SCROLLBAR_SIZE
    height: DROPDOWN_SCROLLBAR_SIZE

// Dropdown surface — the panel a menu opens into.
//
// Defined once because two menus have to be indistinguishable: the layout menu
// beside the panel tabs and the command prompt's results list.  Both fill it
// with `ct-menu-item` rows, so only the container chrome lives here.
// Dropdowns reveal with a short slide-and-fade rather than appearing abruptly.
// Declared once so every menu that calls `dropdown-surface()` gets the same
// motion.  Only the reveal is animated: these menus are removed from the DOM on
// close, so there is no element left to animate out.
@keyframes ct-dropdown-reveal
  from
    opacity: 0
    transform: translateY(-0.25rem)
  to
    opacity: 1
    transform: translateY(0)

// The PAINT of that surface, with no behaviour attached.
//
// Split out of `dropdown-surface()` because two of its callers cannot take the
// behaviour and were silently broken by it — see the block comment on
// `dropdown-surface()` below.  A caller that hosts absolutely-positioned
// children outside its own box, or that is rebuilt while it is on screen, wants
// the look and neither the clip nor the reveal.
dropdown-surface-chrome()
  // The VCS branch picker is the reference for every menu that opens over the
  // UI: a panel surface, a hairline border and a small radius, with no shadow.
  //
  // rem, not em: these menus sit in containers with different font sizes (the
  // layout menu inherits 16px, the command prompt 12px), and em-based values
  // would resolve differently in each — the same declaration giving a 0.5px
  // frame in one and 0.375px in the other.  The surface must not depend on
  // where it opens.
  background: colors-ui-surface-primary-default
  border: 0.03125rem solid colors-ui-border-primary
  border-radius: DROPDOWN_RADIUS
  box-shadow: none

  dropdown-scrollbar()

// The full dropdown behaviour: the chrome, plus a clip to the radius and a
// reveal animation.
//
// TWO PRECONDITIONS, both of which `#menu-main` violated and neither of which
// was stated until a user reported the result (2026-09-02, ide.codetracer.com:
// "when I move my mouse over the menu, it flickers, briefly displaying the
// content below it" and "the sub-menus are not displayed"):
//
//   * `overflow: hidden` clips EVERY descendant, not just the rows.  A caller
//     whose submenus are absolutely-positioned children laid out beside it —
//     which is exactly how `isonim_menu_shell_view.nim` builds
//     `.menu-nested-elements`, as siblings of `#menu-elements` inside
//     `#menu-main` — has those children erased.  Measured on the deployed
//     `noirstudio.dev` (revision 5334f7aa): `#menu-main` occupied
//     x = 10..180 and `#menu-nested-elements-1` was laid out at x = 181..356
//     with nine rows, and `elementFromPoint` at the centre of its first row
//     returned `section.lm_tabs` — the layout chrome BEHIND it.  Not covered:
//     clipped out of existence, while every model- and markup-level assertion
//     about it passed.
//
//   * `animation` on an element that is REPLACED rather than updated replays
//     from `opacity: 0` on every replacement.  `ui/menu.nim`'s
//     `requestMenuRender` rebuilds the whole caption chrome whenever the
//     hovered menu row changes, so a pointer crossing five rows restarted the
//     reveal five times.  Measured on the same deployment by counting
//     `animationstart` on `#menu-main`: five transitions, five reveals.  That
//     is the reported flicker, and "briefly displaying the content below it"
//     is literally what `opacity: 0` shows.
//
// So a menu that is rebuilt in place, or that hosts an overflowing child, must
// call `dropdown-surface-chrome()` instead.
dropdown-surface()
  dropdown-surface-chrome()
  overflow: hidden
  animation: ct-dropdown-reveal 120ms ease-out

  // Motion is decoration here; the menu must still open instantly for anyone
  // who has asked the system to reduce it.
  @media (prefers-reduced-motion: reduce)
    animation: none

// One row inside that surface.  The row's colour, height and hover come from
// the `ct-menu-item` component; this is only the hairline between rows and the
// corner rounding that lets the ends sit inside the container's radius.
dropdown-surface-row()
  // Row height comes from the `ct-menu-item` component itself (2.25rem), which
  // every dropdown row carries — see components/menu_item.styl.
  font-size: 0.875rem
  border-top: 0.0625rem solid colors-ui-border-tertiary
  padding-left: 0.5em
  padding-right: 0.5em

  // Rows differ in how they carry their text: the layout menu puts it straight
  // in the row, the command prompt wraps it in `ct-menu-item-label`.  That
  // label is sized `0.875em` for the application menu, which here multiplies
  // against the row's own 0.875rem and lands two steps down — the same list
  // rendered visibly smaller than its neighbour.  In a dropdown the row owns
  // the size; the label just carries the text.
  .ct-menu-item-label,
  .ct-menu-item-sublabel
    font-size: inherit

  &:first-child
    border-top: none
    border-radius: DROPDOWN_RADIUS DROPDOWN_RADIUS 0 0

  &:last-child
    border-bottom: none
    border-radius: 0 0 DROPDOWN_RADIUS DROPDOWN_RADIUS


