// Icons inside a tab — the close and pin affordances on GoldenLayout tabs, and
// any icon added to a tab later.  One rule so they cannot drift apart: close had
// no hover at all, while pin dimmed itself to 0.7 and brightened on hover, so
// the two behaved differently in the same tab.
//
// The icons ship as SVGs with `fill="#919191"` baked in, which cannot be
// recoloured while they are background images.  They are drawn as masks instead,
// with the colour supplied by `background-color` — so the state lives in CSS,
// on tokens, rather than in the asset.
TAB_ICON_COLOR = colors-ui-icon-primary-subtle
// OFF-TOKEN: the design system has `icon/primary/subtle` but no
// `icon/primary/subtle-hover`.  #C8C8C8 exists in the palette (colors-grey-150)
// and is mapped for text roles only — binding a text role to an icon would be
// the drift DESIGN_SYSTEM.md warns about.  Raised 2026-08-21; replace with the
// role once it exists.
TAB_ICON_COLOR_HOVER = #C8C8C8

