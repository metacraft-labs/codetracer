// The omnibox as the composer for agent instructions
// (isonim_agent_harbor_composer_view.nim, CTF-P2c). A file of its own, as
// agent_harbor_activity.styl is, so the composer's rules stay apart from
// agent_harbor.styl, which other Agent Harbor work edits.
//
// The composer is the omnibox extended, so it is built from the omnibox's
// parts: the field is the palette's `.command-input-row` (command-palette.styl)
// and the sheet under it is the omnibox's results surface,
// `dropdown-surface-chrome()` (shared_widgets.styl), wider than the field and
// centred under it: `min(40rem, window − 1rem)`, the viewmodel's
// `sheetWidthFor` rule (`maxSheetWidth` 640px, `sheetInset` 8px). Rows take the
// list rows' treatment (the VCS panel's): no line between them, a hover and a
// selected ground. Every colour is a design-system role; type sizes are the
// design system's type roles (`ah-rem`, agent_harbor.styl).

AH_COMPOSER_INSET = 0.5rem
AH_COMPOSER_PAD = 0.75rem
// The "More above" line: 0.25rem over and under a 1.5rem line, and its
// hairline (GPUI's `MoreLinePx`, 33px).
AH_COMPOSER_MORE_LINE = 2.0625rem

// The story's whole window (storybook_components.mountAgentHarborComposerStory):
// the caption bar and the window under it, both fixed to the viewport.
.ah-composer-story
  position: fixed
  top: 0
  left: 0
  right: 0
  bottom: 0

// The story window: the editor under the caption bar, which the sheet drops
// over.
.ah-composer-window
  position: fixed
  top: unquote("var(--caption-bar-height, 2.125rem)")
  left: 0
  right: 0
  bottom: 0
  display: flex
  z-index: 0

#menu.ah-composer-caption
  position: fixed
  top: 0
  left: 0
  right: 0
  justify-content: center
  z-index: 2

  #debug
    // The omnibox keeps its caption width; on a window narrower than it, it
    // takes the window less an inset (a narrow window has no toolbar beside
    // it in this story).
    max-width: unquote("calc(100vw - 1rem)")
    flex-basis: auto

// The omnibox's host in the caption bar, in the composer's story and in a
// whole window (CTF-P2L's L12): the composer centred in its height.
#menu .ah-composer-container
  position: relative
  width: 100%
  height: 100%
  padding: 0
  background: transparent
  display: flex
  align-items: center

// While the sheet is open the field takes the sheet's edges (P2c study D36):
// `min(40rem, window − 1rem)`, the sheet's own width, so
// a long instruction has the sheet's room and its end, where the caret is,
// stays in view (the view scrolls the field to its end). The field is drawn
// OVER its neighbours in the caption bar, centred on the omnibox's place:
// the omnibox's host keeps its caption width (menu_bar.styl), so the session
// tabs and the toolbar beside it keep their places under the open sheet
// instead of being squeezed out of the bar (CTF-P2L's L12 at laptop).
#menu #debug:has(.ah-composer-sheet)
  overflow: visible
  // Above the session tab strip (z-index 21, session_tabs.styl), whose
  // tabs the widened field covers; below the tab strip's own menus and the
  // initiative popup (120, 130), which never open with it.
  position: relative
  z-index: 24

.ah-composer .ah-composer-input-row
  width: unquote("min(40rem, calc(100vw - 1rem))")
  left: 50%
  transform: translateX(-50%)
  z-index: 3

.ah-composer
  position: relative
  width: 100%
  font-size: 0.75rem

  .ah-composer-input-row
    position: relative

  // The field is where the operator types, so it is never cut: a long
  // instruction scrolls in it as in every CodeTracer input (an ellipsis drawn
  // by CSS would break the one cut rule, CTF-P1c D6). The sheet shows the
  // whole instruction instead (P2c study D32).

  .ah-composer-more
    flex: 0 0 auto
    padding-right: 0.75rem

  .ah-composer-more-text
    font-size: ah-rem(type-ui-size-caption-md)
    color: colors-ui-text-primary-caption
    white-space: nowrap

// The sheet: the omnibox's results surface, wider than the field.
.ah-composer-sheet
  dropdown-surface-chrome()
  position: absolute
  // Stylus does not substitute a variable inside a literal `calc()`; the
  // `%` form puts the gap's value in (auto_hide.styl does the same).
  top: "calc(100% + %s)" % DROPDOWN_TRIGGER_GAP
  left: 50%
  transform: translateX(-50%)
  // min(40rem, the window less 0.5rem each side): the viewmodel's rule.
  width: unquote("min(40rem, calc(100vw - 1rem))")
  // Its foot 1rem above the window's, the trigger gap taken off too (the
  // gap moved the sheet down; without it the clearance fell to 11px).
  max-height: "calc(100vh - var(--caption-bar-height, 2.125rem) - 1rem - %s)" % DROPDOWN_TRIGGER_GAP
  // A body that scrolls and a footer that stays: the send line is always in
  // view, however long the form above it.
  display: flex
  flex-direction: column
  overflow: hidden
  box-sizing: border-box
  z-index: 25
  font-family: "SpaceGrotesk", sans-serif
  font-size: ah-rem(type-ui-size-body-md)
  color: colors-ui-text-primary-body
  text-align: left

// The body scrolls with the dropdowns' own visible scrollbar, so a long
// form says there is more below; it is the offset parent of what it holds,
// so the view can bring an opened section into view.
// The header stays above the body, so the state and, with a form open, the
// destination are always in view.
.ah-composer-top
  flex: 0 0 auto
  padding-top: 0.5rem

.ah-composer-body
  position: relative
  flex: 1 1 auto
  min-height: 0
  overflow-y: auto
  // No bottom padding: the sticky "More below" line sits on the scrollport's
  // own bottom edge, with nothing showing under it.
  padding: 0
  dropdown-scrollbar()

  > :last-child
    margin-bottom: 0.5rem
  // A thumb that shows, so a long form says there is more below.
  scrollbar-width: thin
  scrollbar-color: colors-ui-border-primary transparent

  &::-webkit-scrollbar-thumb
    background: colors-ui-border-primary
    border-radius: 0.25rem

  // While the body is scrolled past its start: the matching quiet line
  // pinned to its top edge, its hairline under it, so a scrolled body is
  // always parted from the header and what is above it (the context chips)
  // reads as above rather than gone. It overlays the content instead of
  // adding to it (the negative margin takes its height back), so showing it
  // moves nothing and the scroll offset alone decides it.
  &[data-ah-above]::before
    content: "More above \2191"
    position: sticky
    top: 0
    z-index: 1
    display: block
    box-sizing: border-box
    height: AH_COMPOSER_MORE_LINE
    margin-bottom: (-1 * AH_COMPOSER_MORE_LINE)
    padding: 0.25rem AH_COMPOSER_PAD
    line-height: 1.5rem
    background: colors-ui-surface-primary-default
    border-bottom: 0.0625rem solid colors-ui-border-secondary
    font-size: ah-rem(type-ui-size-caption-md)
    color: colors-ui-text-primary-caption
    text-align: right

  // While the body holds more below: a quiet line pinned to its bottom edge.
  &[data-ah-more]::after
    content: "More below \2193"
    position: sticky
    bottom: 0
    display: block
    padding: 0.25rem AH_COMPOSER_PAD
    background: colors-ui-surface-primary-default
    border-top: 0.0625rem solid colors-ui-border-secondary
    font-size: ah-rem(type-ui-size-caption-md)
    color: colors-ui-text-primary-caption
    text-align: right

.ah-composer-footer
  flex: 0 0 auto

  &:empty
    display: none

.ah-composer-header
  padding: 0 AH_COMPOSER_PAD 0.375rem
  font-size: ah-rem(type-ui-size-caption-md)
  color: colors-ui-text-primary-caption

  &.ah-role-error
    color: colors-ui-text-error-primary

  &.ah-role-body
    color: colors-ui-text-primary-body

.ah-composer-instruction
  padding: 0.25rem AH_COMPOSER_PAD 0.5rem
  white-space: pre-wrap
  overflow-wrap: anywhere
  color: colors-ui-text-primary-body

.ah-composer-section-label
  font-size: ah-rem(type-ui-size-caption-md)
  font-weight: 500
  letter-spacing: 0.04em
  text-transform: uppercase
  color: colors-ui-text-primary-label

// "In view": the context chips, then what is cited.
.ah-composer-context
  position: relative
  padding: 0.25rem AH_COMPOSER_PAD 0.5rem

.ah-composer-chips
  display: flex
  flex-wrap: wrap
  align-items: center
  gap: 0.375rem

  .ah-composer-section-label
    margin-right: 0.25rem

.ah-composer-chip
  // Sized to its words, and cut only past the sheet's width.
  flex: 0 0 auto
  display: inline-flex
  align-items: center
  max-width: 100%
  height: CONTROL_HEIGHT_SM
  padding: 0 0.5rem
  border: 0.0625rem solid colors-ui-border-secondary
  border-radius: ah-rem(border-border-radius-control)
  background: transparent
  font-family: inherit
  font-size: ah-rem(type-ui-size-caption-md)
  color: colors-ui-text-primary-caption

  &.ah-chip-cited
    border-color: colors-ui-border-action
    color: colors-ui-text-primary-body
    background: colors-ui-surface-primary-secondary-hover

  // Left out by the operator: struck through, a step dimmer than an
  // offered chip's caption in both themes. The caption-subtle role, not the
  // disabled one: in Light the disabled grey is no dimmer than the caption
  // (P2c study, manager note 122); in Dark the two are the same grey.
  &.ah-chip-excluded .ah-composer-chip-text
    text-decoration: line-through
    color: colors-ui-text-primary-caption-subtle

  &.ah-chip-note
    border-style: dashed
    color: colors-ui-text-primary-caption

  &.ah-composer-add
    padding: 0
    width: CONTROL_HEIGHT_SM
    justify-content: center
    color: colors-ui-icon-primary-default

    &.active
      background: colors-ui-surface-primary-secondary-hover

.ah-composer-chip-text
  min-width: 0
  overflow: hidden
  white-space: nowrap

.ah-composer-none
  font-size: ah-rem(type-ui-size-caption-md)
  color: colors-ui-text-primary-caption

.ah-composer-cites
  margin-top: 0.375rem
  font-size: ah-rem(type-ui-size-caption-md)
  color: colors-ui-text-primary-caption
  overflow: hidden
  white-space: nowrap

// The add-context menu opens in place under the chips, pushing what follows
// down, so it never covers the `+` or a row.
.ah-composer-menu
  dropdown-surface-chrome()
  margin-top: 0.375rem
  width: max-content
  min-width: 12rem

.ah-composer-menu-item
  dropdown-surface-row()
  font-size: ah-rem(type-ui-size-caption-md)

// The destinations: list rows in their fixed order.
.ah-composer-rows
  display: flex
  flex-direction: column
  border-top: 0.0625rem solid colors-ui-border-secondary
  padding-top: 0.25rem

// The selected destination is marked as the timeline marks its focused
// line: an inset bar in the action role down the left edge, never a fill,
// so every role on the row keeps the panel ground it was chosen for. The bar
// sits one hairline inside the sheet's border so the two never fuse.
//
// A row is a grid of named areas: the title column, what the destination
// is, the router's mark and the row's actions on one line, and the reason
// and the delivery under the label.
.ah-composer-row
  display: grid
  grid-template-columns: 7.25rem minmax(0, 1fr) auto auto
  grid-template-areas: "title label mark actions" ". reason reason reason" ". delivery delivery delivery"
  column-gap: 0.5rem
  align-items: center
  margin: 0 0.0625rem
  padding: 0.375rem AH_COMPOSER_PAD

  & + .ah-composer-row
    margin-top: 0.25rem

  &.ah-composer-row-selected
    box-shadow: inset 0.125rem 0 0 colors-ui-border-action

    .ah-composer-row-label
      color: colors-ui-text-primary-body

  // A destination the window cannot reach: the disabled role, and its
  // reason in italics, as CodeTracer draws an unavailable or empty message
  // (the VCS panel's "No changes").
  &.ah-composer-row-unavailable
    .ah-composer-row-title,
    .ah-composer-row-label
      color: colors-ui-text-primary-disabled

    .ah-composer-row-label
      font-style: italic

.ah-composer-row-title
  grid-area: title
  font-size: ah-rem(type-ui-size-caption-md)
  font-weight: 500
  letter-spacing: 0.04em
  text-transform: uppercase
  color: colors-ui-text-primary-label

.ah-composer-row-label
  grid-area: label
  min-width: 0
  overflow: hidden
  white-space: nowrap
  color: colors-ui-text-primary-body

// The state word, one slot for every state: the router's mark before
// sending (`Routed`, `Chosen by you` in the action hue, the bar's;
// `Router's choice` quiet), the delivery's after (`Sending…` quiet, `Sent`
// in the body, `Failed to send` in the error role). The routed word is the
// body text in the label weight: the design system has no text role in the
// action hue that reads at caption size on the sheet (`text-primary-active`
// and the action role are about 4:1 there), and the bar beside the row
// already carries the hue.
.ah-composer-row-mark
  grid-area: mark
  font-size: ah-rem(type-ui-size-caption-md)
  font-weight: 500
  color: colors-ui-text-primary-body

  &:empty
    display: none

  &.ah-composer-row-mark-router-choice,
  &.ah-composer-row-mark-delivery-sending
    color: colors-ui-text-primary-caption

  &.ah-composer-row-mark-delivery-sent
    color: colors-ui-text-primary-body

  &.ah-composer-row-mark-delivery-failed
    color: colors-ui-text-error-primary

.ah-composer-row-actions
  grid-area: actions
  display: flex
  gap: 0.375rem

  &:empty
    display: none

.ah-composer-action
  height: CONTROL_HEIGHT_SM
  padding: 0 0.5rem
  border: 0.0625rem solid colors-ui-border-primary
  border-radius: ah-rem(border-border-radius-control)
  background: transparent
  font-family: inherit
  font-size: ah-rem(type-ui-size-caption-md)
  color: colors-ui-text-primary-body
  white-space: nowrap

  &.ah-composer-stop
    border-color: colors-ui-text-error-primary
    color: colors-ui-text-error-primary

.ah-composer-row-reason,
.ah-composer-row-delivery
  margin-top: 0.125rem
  line-height: 1.35
  font-size: ah-rem(type-ui-size-caption-md)
  color: colors-ui-text-primary-caption
  overflow-wrap: anywhere

.ah-composer-row-reason
  grid-area: reason

.ah-composer-row-delivery
  grid-area: delivery

  &.ah-role-body
    color: colors-ui-text-primary-body

  &.ah-role-error
    color: colors-ui-text-error-primary

  // Light's warning text role is a pale step meant for larger type; its
  // hover step is the darker one, readable at caption size on the sheet.
  &.ah-role-warning
    color: by-mode(colors-ui-text-warning-primary, colors-ui-text-warning-primary-hover)

// The launch or initiative form, under the manager's row.
.ah-composer-form
  margin-top: 0.25rem
  padding: 0.5rem AH_COMPOSER_PAD
  border-top: 0.0625rem solid colors-ui-border-secondary

  &.ah-composer-form-folded .ah-composer-form-grid
    display: none

.ah-composer-form-title
  margin-bottom: 0.375rem
  font-size: ah-rem(type-ui-size-caption-md)
  color: colors-ui-text-primary-caption

.ah-composer-form-grid
  display: grid
  // Never wider than the sheet, whatever a field holds.
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr)
  gap: 0.5rem 0.75rem

.ah-composer-field
  display: flex
  flex-direction: column
  gap: 0.1875rem
  min-width: 0

  &.ah-composer-field-wide
    grid-column: 1 / -1

.ah-composer-field-label
  font-size: ah-rem(type-ui-size-caption-md)
  color: colors-ui-text-primary-label

.ah-composer-field-value
  height: CONTROL_HEIGHT_SM
  line-height: CONTROL_HEIGHT_SM
  padding: 0 0.5rem
  border: CONTROL_BORDER_WIDTH solid CONTROL_BORDER_COLOR
  border-radius: ah-rem(border-border-radius-control)
  background: colors-ui-surface-primary-default
  overflow: hidden
  white-space: nowrap
  color: colors-ui-text-primary-body

  &.ah-composer-field-empty
    color: colors-ui-text-primary-caption

.ah-composer-field-problem .ah-composer-field-value
  border-color: colors-ui-text-error-primary

.ah-composer-field-problem-text
  font-size: ah-rem(type-ui-size-caption-md)
  line-height: 1.3
  color: colors-ui-text-error-primary

.ah-composer-toggles
  display: flex
  flex-wrap: wrap
  gap: 0.25rem

// The VCS panel's mode toggles: a hairline border, the chosen one in the
// action border on the hover ground.
.ah-composer-toggle
  height: CONTROL_HEIGHT_SM
  padding: 0 0.5rem
  border: 0.0625rem solid colors-ui-border-secondary
  border-radius: ah-rem(border-border-radius-control)
  background: transparent
  font-family: inherit
  font-size: ah-rem(type-ui-size-label-md)
  color: colors-ui-text-primary-label

  // The chosen option: the action border alone, as the VCS mode toggle, so
  // it never reads as a cited chip (which has the hover ground).
  &.active
    border-color: colors-ui-border-action
    color: colors-ui-text-primary-body

.ah-composer-schedule
  grid-column: 1 / -1

  .ah-composer-form-grid
    margin-top: 0.5rem

  &:not(.ah-composer-schedule-open) .ah-composer-form-grid
    display: none

.ah-composer-schedule-head
  display: flex
  align-items: center
  gap: 0.375rem
  min-width: 0

.ah-composer-fold
  color: colors-ui-icon-primary-default

.ah-composer-schedule-problem
  color: colors-ui-text-error-primary !important

.ah-composer-schedule-summary
  min-width: 0
  overflow: hidden
  white-space: nowrap
  font-size: ah-rem(type-ui-size-caption-md)
  color: colors-ui-text-primary-caption

// After sending: the instruction as sent, and where it went.
.ah-composer-sent
  display: flex
  flex-direction: column
  gap: 0.125rem
  padding: 0 AH_COMPOSER_PAD 0.5rem

// The instruction as sent, whole: a result below it may refer to any part.
.ah-composer-sent-text
  white-space: pre-wrap
  overflow-wrap: anywhere
  color: colors-ui-text-primary-body

.ah-composer-sent-line
  font-size: ah-rem(type-ui-size-caption-md)
  color: colors-ui-text-primary-caption

.ah-composer-stopped
  padding: 0.375rem AH_COMPOSER_PAD 0
  font-size: ah-rem(type-ui-size-caption-md)
  color: colors-ui-text-primary-caption

  &.ah-role-error
    color: colors-ui-text-error-primary

// The send line.
.ah-composer-send
  display: flex
  align-items: center
  justify-content: flex-end
  gap: 0.75rem
  padding: 0.5rem AH_COMPOSER_PAD
  border-top: 0.0625rem solid colors-ui-border-secondary

.ah-composer-send-hint
  min-width: 0
  overflow: hidden
  white-space: nowrap
  font-size: ah-rem(type-ui-size-caption-md)
  color: colors-ui-text-primary-caption

.ah-composer-send-more
  flex: 0 0 auto
  margin-left: -0.5rem
  white-space: nowrap
  font-size: ah-rem(type-ui-size-caption-md)
  color: colors-ui-text-primary-caption

  &:empty
    display: none

.ah-composer-send-blocked .ah-composer-send-hint
  color: colors-ui-text-error-primary

// The primary button: CodeTracer's own primary button in both themes (P2c
// study D39), the shared rule's fill and text
// (`[class*="-button-"][class*="-primary"]`, button.styl): the design
// system's `surface/action/primary` with `text/on-action-primary`, and no
// border of another colour. Light's pair is the design system's own pale
// one (`brand/300` under `grey/50`); a stronger Light primary is a design
// system change, left to a human.
.ah-composer-send-button
  height: CONTROL_HEIGHT_SM
  padding: 0 0.75rem
  border: 0.0625rem solid colors-ui-surface-action-primary
  border-radius: ah-rem(border-border-radius-control)
  background: colors-ui-surface-action-primary
  color: colors-ui-text-on-action-primary
  font-family: inherit
  font-size: ah-rem(type-ui-size-label-md)

  &:disabled
    border-color: colors-ui-border-secondary
    background: transparent
    color: colors-ui-text-primary-disabled

// Nothing typed: what was sent lately.
.ah-composer-recent
  padding: 0.25rem 0 0

  .ah-composer-section-label
    padding: 0 AH_COMPOSER_PAD 0.25rem

.ah-composer-recent-row
  display: flex
  flex-direction: column
  padding: 0.375rem AH_COMPOSER_PAD
  min-width: 0

  &:hover
    background: colors-ui-surface-primary-secondary-hover

.ah-composer-recent-text
  overflow: hidden
  white-space: nowrap
  color: colors-ui-text-primary-body

.ah-composer-recent-line
  overflow: hidden
  white-space: nowrap
  font-size: ah-rem(type-ui-size-caption-md)
  color: colors-ui-text-primary-caption

.ah-composer-recent-failed .ah-composer-recent-line
  color: colors-ui-text-error-primary

// A narrow window: a row's reason and delivery under its label, the form's
// fields one per line.
@media (max-width: 30rem)
  // The areas re-flow: the title and the state word on one line, the label
  // under them, the reason and the delivery, then the actions last, after
  // the failure or result they answer.
  .ah-composer-row
    grid-template-columns: minmax(0, 1fr) auto
    grid-template-areas: "title mark" "label label" "reason reason" "delivery delivery" "actions actions"

  .ah-composer-row-actions
    margin-top: 0.25rem

  // A destination's label wraps rather than being cut: at this width a cut
  // loses what the destination does (a UI action's target).
  .ah-composer-row-label
    white-space: normal
    overflow-wrap: anywhere

  .ah-composer-form
    padding-left: AH_COMPOSER_PAD

  .ah-composer-form-grid
    grid-template-columns: minmax(0, 1fr)
