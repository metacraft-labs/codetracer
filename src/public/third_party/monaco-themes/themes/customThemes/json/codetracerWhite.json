{
  "base": "vs",
  "inherit": true,
  "rules": [
    {
      "foreground": "464646",
      "token": ""
    },
    {
      "foreground": "a53746",
      "token": "comment"
    },
    {
      "foreground": "a53746",
      "fontStyle": "underline",
      "token": "comment.doc"
    },
    {
      "foreground": "464646",
      "token": "variable"
    },
    {
      "foreground": "464646",
      "token": "variable.name"
    },
    {
      "foreground": "001080",
      "token": "variable.parameter"
    },
    {
      "foreground": "464646",
      "token": "variable.member"
    },
    {
      "foreground": "745a25",
      "token": "variable.member.function"
    },
    {
      "foreground": "0550AE",
      "fontStyle": "bold",
      "token": "variable.language"
    },
    {
      "foreground": "33618a",
      "token": "keyword"
    },
    {
      "foreground": "33618a",
      "token": "keyword.operator"
    },
    {
      "foreground": "33618a",
      "fontStyle": "bold",
      "token": "keyword.type"
    },
    {
      "foreground": "196b43",
      "token": "type"
    },
    {
      "foreground": "196b43",
      "token": "type.identifier"
    },
    {
      "foreground": "0959c2",
      "token": "string"
    },
    {
      "foreground": "396658",
      "token": "number"
    },
    {
      "foreground": "396658",
      "token": "number.hex"
    },
    {
      "foreground": "396658",
      "token": "number.octal"
    },
    {
      "foreground": "396658",
      "token": "number.binary"
    },
    {
      "foreground": "396658",
      "token": "number.float"
    },
    {
      "foreground": "464646",
      "token": "delimiter"
    },
    {
      "foreground": "464646",
      "token": "delimiter.backtick"
    },
    {
      "foreground": "464646",
      "token": "operator"
    },
    {
      "foreground": "b71e29",
      "fontStyle": "bold",
      "token": "modifier.export"
    },
    {
      "foreground": "1f667b",
      "fontStyle": "bold",
      "token": "entity.name.type"
    },
    {
      "foreground": "745a25",
      "fontStyle": "bold",
      "token": "entity.name.function"
    },
    {
      "foreground": "745a25",
      "token": "identifier.function"
    },
    {
      "foreground": "745a25",
      "token": "support.function"
    },
    {
      "foreground": "0060a6",
      "token": "constant"
    },
    {
      "foreground": "9d00c5",
      "token": "namespace"
    },
    {
      "foreground": "b71e29",
      "fontStyle": "bold",
      "token": "namespace.std"
    },
    {
      "foreground": "953800",
      "fontStyle": "bold",
      "token": "namespace.system"
    },
    {
      "foreground": "0550AE",
      "token": "namespace.library"
    },
    {
      "foreground": "565f69",
      "token": "namespace.except"
    },
    {
      "foreground": "c00000",
      "token": "metatag"
    },
    {
      "foreground": "0060a6",
      "token": "attribute.name"
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "macro": "#953499",
    "macro.declaration": "#953499",
    "function": "#745a25",
    "function.declaration": "#745a25",
    "method": "#745a25",
    "type": "#1f667b",
    "type.declaration": "#1f667b",
    "class": "#1f667b",
    "enum": "#1f667b",
    "interface": "#1f667b",
    "struct": "#1f667b",
    "typeParameter": "#0060a6",
    "parameter": "#1F377F",
    "variable": "#001080",
    "variable.readonly": "#0060a6",
    "property": "#001080",
    "enumMember": "#0060a6",
    "namespace": "#1f667b",
    "decorator": "#953499",
    "label": "#001080",
    "operator": "#000000"
  },
  "colors": {
    "editor.foreground": "#464646",
    "editor.background": "#f4f4f4",
    "editor.selectionBackground": "#4f5b66",
    "editor.lineHighlightBackground": "#e2e0bc",
    "editorCursor.foreground": "#c0c5ce",
    "editorWhitespace.foreground": "#65737e",
    "editorIndentGuide.background": "#65737F",
    "editorIndentGuide.activeBackground": "#FBC95A",
    "editorSuggestWidget.foreground": "#464646",
    "editorSuggestWidget.background": "#F5F5F5",
    "editorLineNumber.foreground": "#666055"
  },
  "codetracer": {
    "$comment": "The editor palette shared by the desktop and native front-ends. scripts/tokens-to-styl.sh generates editor-theme.styl for the desktop gutter, execution band and pointer, and design_tokens.nim for the native editor, from this block. Monaco supplies syntax and selection colours. The editor ground is the mode's panel because Monaco is transparent; resting line numbers paint at full opacity. The execution band and Monaco cursor-line highlight use the same opaque colour so composition cannot lower text contrast. Fresh real Electron captures (src/tests/visual/answers/plat47-desktop-parity-light.electron.json, just plat47-capture-electron) verify the effective colours. Monaco ignores this key.",
    "ground": "{colors.ui.surface.base.panel}",
    "lineNumber": "#666055",
    "activeLineNumber": "{colors.ui.text.primary.label}",
    "executionLine": "#e2e0bc",
    "selection": "#4f5b66",
    "executionPointer": "{colors.ui.text.primary.label}"
  }
}
