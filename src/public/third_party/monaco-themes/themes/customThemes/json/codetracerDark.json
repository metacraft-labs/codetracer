    },
    {
      "foreground": "cdd3de",
      "token": "variable.name"
    },
    {
      "foreground": "c5a6d5",
      "token": "variable.readOnly"
    },
    {
      "foreground": "D9E2D4",
      "token": "variable.parameter"
    },
    {
      "foreground": "cdd3de",
      "token": "variable.member"
    },
    {
      "foreground": "D7C98A",
      "token": "variable.member.function"
    },
    {
      "foreground": "79C0FF",
      "token": "variable.language"
    },
    {
      "foreground": "84b6df",
      "token": "keyword"
    },
    {
      "foreground": "C7D0DA",
      "token": "keyword.operator"
    },
    {
      "foreground": "C7D0DA",
      "token": "operator"
    },
    {
      "foreground": "63CBB6",
      "token": "keyword.type"
    },
    {
      "foreground": "63CBB6",
      "token": "type"
    },
    {
      "foreground": "CDD6DF",
      "token": "type.identifier"
    },
    {
      "foreground": "d7a690",
      "token": "string"
    },
    {
      "foreground": "D0B07A",
      "token": "string.escape"
    },
    {
      "foreground": "BFD8B0",
      "token": "number"
    },
    {
      "foreground": "BFD8B0",
      "token": "number.hex"
    },
    {
      "foreground": "BFD8B0",
      "token": "number.octal"
    },
    {
      "foreground": "BFD8B0",
      "token": "number.binary"
    },
    {
      "foreground": "BFD8B0",
      "token": "number.float"
    },
    {
      "foreground": "B6C0CB",
      "token": "delimiter"
    },
    {
      "foreground": "C5CFDA",
      "token": "delimiter.bracket"
    },
    {
      "foreground": "FFA657",
      "token": "modifier.export"
    },
    {
      "foreground": "4EC9B0",
      "token": "entity.name.type"
    },
    {
      "foreground": "D7C98A",
      "token": "entity.name.function"
    },
    {
      "foreground": "D7C98A",
      "token": "identifier.function"
    },
    {
      "foreground": "D7C98A",
      "token": "support.function"
    },
    {
      "foreground": "93b3de",
      "token": "constant"
    },
    {
      "foreground": "d2a1ce",
      "token": "namespace"
    },
    {
      "foreground": "e0a1a1",
      "token": "regexp"
    },
    {
      "foreground": "ff928a",
      "token": "namespace.std"
    },
    {
      "foreground": "FFA657",
      "token": "namespace.system"
    },
    {
      "foreground": "A5D6FF",
      "token": "namespace.library"
    },
    {
      "foreground": "abb2b9",
      "token": "namespace.except"
    },
    {
      "foreground": "D7BA7D",
      "token": "metatag"
    },
    {
      "foreground": "81b7e3",
      "token": "tag"
    },
    {
      "foreground": "8FCBEE",
      "token": "attribute.name"
    },
    {
      "foreground": "d7a690",
      "token": "attribute.value"
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "macro": "#eba06f",
    "macro.declaration": "#eba06f",
    "function": "#D7C98A",
    "function.declaration": "#D7C98A",
    "method": "#D7C98A",
    "type": "#4EC9B0",
    "type.declaration": "#4EC9B0",
    "class": "#4EC9B0",
    "enum": "#4EC9B0",
    "interface": "#4EC9B0",
    "struct": "#4EC9B0",
    "typeParameter": "#9CDCFE",
    "parameter": "#D9E2D4",
    "variable": "#CDD3DE",
    "variable.readonly": "#c5a6d5",
    "property": "#9CDCFE",
    "enumMember": "#93b3de",
    "namespace": "#d2a1ce",
    "decorator": "#eba06f",
    "label": "#CDD3DE",
    "operator": "#C7D0DA"
  },
  "colors": {
    "editorBracketHighlight.foreground1": "#EAB308",
    "editorBracketHighlight.foreground2": "#8B5CF6",
    "editorBracketHighlight.foreground3": "#3B82F6",
    "editorBracketHighlight.foreground4": "#EAB308",
    "editorBracketHighlight.foreground5": "#8B5CF6",
    "editorBracketHighlight.foreground6": "#3B82F6",
    "editor.foreground": "#f3f3f3",
    "editor.background": "#2c2c2c",
    "editor.selectionBackground": "#3a3a3ab3",
    "editor.lineHighlightBackground": "#404040",
    "editorWhitespace.foreground": "#65737e",
    "editorIndentGuide.background": "#65737F",
    "editorIndentGuide.activeBackground": "#FBC95A",
    "editorSuggestWidget.foreground": "#8e8f92",
    "editorSuggestWidget.background": "#2c2c2c",
    "activeLineNumber": "#CDD6DF",
    "selection": "#2A4B73",
    "inactiveSelection": "#253F60",
    "selectionHighlight": "#2A4B73",
    "lineHighlight": "#404040",
    "bracketMatch.background": "#2A2D31",
    "bracketMatch.border": "#4DA6D8",
    "editorWhitespace": "#3B3F45",
    "editorIndentGuide": "#4C5158",
    "findMatch": "#3A5166",
    "findMatchHighlight": "#2B2F36",
    "error": "#E06C75",
    "warning": "#E5B567",
    "info": "#6FB6D9",
    "hint": "#B38BC8",
    "focusBorder": "#2c2c2c",
    "editorCursor.foreground": "#F2F6FA",
    "diffEditor.removedLineBackground": "#E06C7526",
    "diffEditor.insertedLineBackground": "#40805030",
    "diffEditor.removedTextBackground": "#E06C754D",
    "diffEditor.insertedTextBackground": "#4080506E",
    "diffEditorOverview.removedForeground": "#E06C7599",
    "diffEditorOverview.insertedForeground": "#40805099",
    "diffEditor.diagonalFill": "#4A4A4A66",
    "diffEditor.unchangedRegionBackground": "#3A3A3A",
    "diffEditor.unchangedRegionForeground": "#E8E8E8",
    "diffEditor.unchangedCodeBackground": "#28282800",
    "minimapSlider.background": "#A6AEFF40",
    "minimapSlider.hoverBackground": "#A6AEFF59",
    "minimapSlider.activeBackground": "#A6AEFF73",
    "editorLineNumber.foreground": "#b0b0b0"
  },
  "codetracer": {
    "$comment": "The editor palette shared by the desktop and native front-ends. scripts/tokens-to-styl.sh generates editor-theme.styl for the desktop gutter, execution band and pointer, and design_tokens.nim for the native editor, from this block. Monaco supplies syntax and selection colours. The editor ground is the mode's panel because Monaco is transparent; resting line numbers paint at full opacity. The execution band and Monaco cursor-line highlight use the same opaque colour so composition cannot lower text contrast. Fresh real Electron captures (src/tests/visual/answers/plat47-desktop-parity.electron.json, just plat47-capture-electron) verify the effective colours. Monaco ignores this key.",
    "ground": "{colors.ui.surface.base.panel}",
    "lineNumber": "#b0b0b0",
    "activeLineNumber": "{colors.ui.text.primary.label}",
    "executionLine": "#404040",
    "selection": "#353535",
    "executionPointer": "{colors.editor.action.secondary}"
  }
}
