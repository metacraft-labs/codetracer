TUP_SOURCE_REPO=https://github.com/zah/tup.git
TUP_SOURCE_REF=variants-for-windows
TUP_SOURCE_BUILD_COMMAND="TUP_MINGW=1 TUP_MINGW32=0 ./bootstrap.sh"
# IMMUTABLE tup prebuilt pin. gittup.org publishes a MOVING `tup-latest.zip`
# that upstream overwrites in place on every release, plus per-commit,
# content-addressable, never-rewritten `tup-<git-describe>.zip` archives. A
# fixed SHA256 against `tup-latest.zip` therefore self-destructs the moment
# upstream re-publishes latest: the bytes change, the pin no longer matches,
# and Assert-FileSha256 hard-throws (this is exactly what broke the Windows
# installer build after upstream shipped tup-v0.8-38). Pin the immutable
# versioned asset instead; the SHA below is that asset's own digest. To bump,
# pick a newer `tup-v0.8-NN-g<hash>.zip` from https://gittup.org/tup/win32/
# and set both the URL and SHA256 together. Never point this back at
# tup-latest.zip. (efa3a4ec == tup-v0.8-25, the previously-validated latest.)
TUP_PREBUILT_VERSION=v0.8-25-g2867b66e
TUP_PREBUILT_URL=https://gittup.org/tup/win32/tup-v0.8-25-g2867b66e.zip
TUP_PREBUILT_SHA256=efa3a4ecb4e63a9b3f9ced9c18d15ef59fabaf1942c9fffa9a930fb5ebf853a0
TUP_MSYS2_BASE_VERSION=20251213
TUP_MSYS2_BASE_X64_SHA256=999f63c2fc7525af5cd41b55e9ea704471a4f9d0278a257fff3b0d1183c441b9
TUP_MSYS2_PACKAGES="mingw-w64-x86_64-gcc mingw-w64-x86_64-pkgconf make"
GCC_VERSION=15.2.0
# WinLibs MinGW-w64 (UCRT runtime, POSIX threads, SEH) prebuilt that provides
# GCC ${GCC_VERSION}. Direct-download fallback for CI/self-hosted runners where
# winget is unavailable (ensure-gcc.ps1 uses winget only when these are unset).
# URL + SHA256 pin the exact GitHub release asset; the SHA256 is the release
# asset's own digest (gh api .../releases -> .assets[].digest, sans `sha256:`).
WINLIBS_GCC_URL=https://github.com/brechtsanders/winlibs_mingw/releases/download/15.2.0posix-14.0.0-ucrt-r7/winlibs-x86_64-posix-seh-gcc-15.2.0-mingw-w64ucrt-14.0.0-r7.zip
WINLIBS_GCC_SHA256=cb2fbad6162540cdf5e1facdce08d4dac359e8cf64f7f696a99274291763b815
GO_VERSION=1.23.6
LDC_VERSION=1.42.0
LDC_WIN_X64_SHA256=5b16bf2a44d7fb6b8012f932c8760603dab6307968c3112cc578b5690f46b5c8
# Standalone 7-Zip console (7zr.exe) used to extract the .7z toolchain
# archives that ship only in that format (LDC's official Windows release is
# a .7z; PowerShell's Expand-Archive and the Windows-bundled tar.exe cannot
# read 7z/LZMA2). The GHA/self-hosted runners do NOT ship 7-Zip, so we
# provision the pinned 7zr.exe directly from the ip7z/7zip GitHub release,
# SHA-verified, into the DIY cache (mirrors the Ensure-Gcc WinLibs
# direct-download fallback). 7zr.exe is the reduced console build that
# supports the 7z format we need. SHA256 is the release asset's own digest.
# Sourced from https://github.com/ip7z/7zip/releases/download/25.00/7zr.exe
SEVENZIP_VERSION=25.00
SEVENZIP_WIN_X64_SHA256=16fe43321b2c8821504b277af0610533ea077685a88ba42868f9ebe4d21c21db
VLANG_VERSION=0.4.8
FPC_VERSION=3.2.2
ZSTD_VERSION=1.5.6
# SHA256 of zstd-v1.5.6-win64.zip, the immutable GitHub release asset from
# https://github.com/facebook/zstd/releases/download/v1.5.6/zstd-v1.5.6-win64.zip
# ensure-zstd.ps1 verifies the download against this pin directly. It used to
# fetch a `zstd-v<ver>-release-notes-checksums.txt` sidecar that does not exist
# for this release (404), so verification was silently skipped ("Could not
# verify zstd SHA256 checksum ... Proceeding"). A pin that is not enforced is a
# comment; enforce it.
ZSTD_WIN_X64_SHA256=7b4eff6719990e38aca93a4844c2e86a1935090625c4611f7e89675e999c56cc
LLVM_VERSION=20.1.3
ZLIB_VERSION=1.3.1
# SHA256 for zlib-1.3.1.tar.gz from
# https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz
# (no prebuilt Windows binary release exists; we build libz.a from source
# using win32/Makefile.gcc with the MinGW gcc bootstrapped by Ensure-Gcc).
ZLIB_WIN_X64_SHA256=9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23
CLINGO_VERSION=5.8.0
# clingo prebuilt DLL extracted from the conda-forge package. potassco/clingo's
# GitHub releases ship only source archives on Windows; the PyPI wheel
# statically links clingo into _clingo.<pytag>.pyd and does NOT ship a
# standalone clingo.dll. Conda-forge's clingo package, on the other hand,
# bundles Library/bin/clingo.dll alongside the CLI tools (clingo.exe,
# clasp.exe, gringo.exe). The build hash encodes the Python ABI of the
# bundled _clingo.cpython-312.pyd which we ignore — the native
# clingo.dll is ABI-stable across the variants. See ensure-clingo.ps1.
CLINGO_WIN_X64_CONDA_URL=https://anaconda.org/conda-forge/clingo/5.8.0/download/win-64/clingo-5.8.0-py312he3f8637_1.conda
CLINGO_WIN_X64_CONDA_SHA256=a9e5eb699dd8de3dcc555c28f47a46ca0b3005f784f76aadf70f47267e5afee9
